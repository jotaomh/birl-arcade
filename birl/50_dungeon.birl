OH O HOME AI PO MONSTRO D_REP(MONSTRO C, MONSTRO N)
  T_NN = N + 0
  T_R = ""
  T_K = 0
  NEGATIVA BAMBAM (T_K < T_NN)
    T_R = T_R + C
    T_K = T_K + 1
  BIRL
  BORA CUMPADI T_R
BIRL

OH O HOME AI PO MONSTRO D_SET1(MONSTRO S, MONSTRO I, MONSTRO C)
  T_T = 0 + S.length
  T_II = I + 0
  T_R = ""
  T_K = 0
  NEGATIVA BAMBAM (T_K < T_T)
    T_CH = S.charAt(T_K) || ""
    T_CHC = T_CH + ""
    ELE QUE A GENTE QUER? T_K == T_II
      T_R = T_R + C
    NAO VAI DAR NAO
      T_R = T_R + T_CHC
    BIRL
    T_K = T_K + 1
  BIRL
  BORA CUMPADI T_R
BIRL

OH O HOME AI PO FRANGO D_ACHA(MONSTRO S, MONSTRO C)
  T_T = 0 + S.length
  T_K = 0
  T_ACHA = 100
  NEGATIVA BAMBAM (T_K < T_T)
    T_CH = S.charAt(T_K) || ""
    T_CHC = T_CH + ""
    ELE QUE A GENTE QUER? T_CHC == C
      ELE QUE A GENTE QUER? T_ACHA == 100
        T_ACHA = T_K + 0
      BIRL
    BIRL
    T_K = T_K + 1
  BIRL
  BORA CUMPADI T_ACHA
BIRL

OH O HOME AI PO FRANGO D_CONT(MONSTRO S, MONSTRO C)
  T_T = 0 + S.length
  T_K = 0
  T_N = 0
  NEGATIVA BAMBAM (T_K < T_T)
    T_CH = S.charAt(T_K) || ""
    T_CHC = T_CH + ""
    ELE QUE A GENTE QUER? T_CHC == C
      T_N = T_N + 1
    BIRL
    T_K = T_K + 1
  BIRL
  BORA CUMPADI T_N
BIRL

OH O HOME AI PO FRANGO D_MAN(MONSTRO A, MONSTRO B)
  T_AA = A + 0
  T_BB = B + 0
  T_AX = T_AA % 10
  T_ABASE = T_AA - T_AX
  T_AY = T_ABASE / 10
  T_BX = T_BB % 10
  T_BBASE = T_BB - T_BX
  T_BY = T_BBASE / 10
  T_DX = T_AX - T_BX
  ELE QUE A GENTE QUER? T_DX < 0
    T_DX = 0 - T_DX
  BIRL
  T_DY = T_AY - T_BY
  ELE QUE A GENTE QUER? T_DY < 0
    T_DY = 0 - T_DY
  BIRL
  T_SOMA = T_DX + T_DY
  BORA CUMPADI T_SOMA
BIRL

OH O HOME AI PO FRANGO D_LIVRE(MONSTRO S, MONSTRO P)
  T_PP = P + 0
  ELE QUE A GENTE QUER? T_PP < 0
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_PP > 99
    BORA CUMPADI 0
  BIRL
  T_C = S.charAt(T_PP) || "#"
  T_CC = T_C + ""
  ELE QUE A GENTE QUER? T_CC == "#"
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "E"
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "W"
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "C"
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "F"
    BORA CUMPADI 0
  BIRL
  BORA CUMPADI 1
BIRL

OH O HOME AI PO MONSTRO D_PASSO(MONSTRO S, MONSTRO DE, MONSTRO PARA)
  T_D = DE + 0
  T_ALVO = PARA + 0
  ELE QUE A GENTE QUER? T_D == T_ALVO
    BORA CUMPADI ""
  BIRL
  T_VIS = AJUDA O MALUCO TA DOENTE D_REP("0", 100)
  T_FIRST = AJUDA O MALUCO TA DOENTE D_REP(".", 100)
  T_VIS = AJUDA O MALUCO TA DOENTE D_SET1(T_VIS, T_D, "1")
  T_DSTR = "" + T_D
  T_Q = T_DSTR.split("|") || 0
  T_QN = 0 + T_Q.length
  T_RES = ""
  NEGATIVA BAMBAM (T_QN > 0)
    T_CEL = T_Q.shift() || ""
    T_CELC = T_CEL + ""
    T_CELL = 0 + T_CELC.length
    ELE QUE A GENTE QUER? T_CELL > 0
      T_P = 0 + parseInt(T_CELC, 10)
      T_PX = T_P % 10
      T_PBASE = T_P - T_PX
      T_PY = T_PBASE / 10
      T_N1 = T_P - 10
      ELE QUE A GENTE QUER? T_PY > 0
        T_OK1 = AJUDA O MALUCO TA DOENTE D_LIVRE(S, T_N1)
        ELE QUE A GENTE QUER? T_OK1 == 1
          T_V1 = T_VIS.charAt(T_N1) || "1"
          T_V1C = T_V1 + ""
          ELE QUE A GENTE QUER? T_V1C == "0"
            T_VIS = AJUDA O MALUCO TA DOENTE D_SET1(T_VIS, T_N1, "1")
            T_DIR1 = "W"
            ELE QUE A GENTE QUER? T_P != T_D
              T_FD1 = T_FIRST.charAt(T_P) || "."
              T_DIR1 = T_FD1 + ""
            BIRL
            T_FIRST = AJUDA O MALUCO TA DOENTE D_SET1(T_FIRST, T_N1, T_DIR1)
            T_Q.push("" + T_N1)
            ELE QUE A GENTE QUER? T_N1 == T_ALVO
              ELE QUE A GENTE QUER? T_RES == ""
                T_RES = T_DIR1 + ""
              BIRL
            BIRL
          BIRL
        BIRL
      BIRL
      T_N2 = T_P + 10
      ELE QUE A GENTE QUER? T_PY < 9
        T_OK2 = AJUDA O MALUCO TA DOENTE D_LIVRE(S, T_N2)
        ELE QUE A GENTE QUER? T_OK2 == 1
          T_V2 = T_VIS.charAt(T_N2) || "1"
          T_V2C = T_V2 + ""
          ELE QUE A GENTE QUER? T_V2C == "0"
            T_VIS = AJUDA O MALUCO TA DOENTE D_SET1(T_VIS, T_N2, "1")
            T_DIR2 = "S"
            ELE QUE A GENTE QUER? T_P != T_D
              T_FD2 = T_FIRST.charAt(T_P) || "."
              T_DIR2 = T_FD2 + ""
            BIRL
            T_FIRST = AJUDA O MALUCO TA DOENTE D_SET1(T_FIRST, T_N2, T_DIR2)
            T_Q.push("" + T_N2)
            ELE QUE A GENTE QUER? T_N2 == T_ALVO
              ELE QUE A GENTE QUER? T_RES == ""
                T_RES = T_DIR2 + ""
              BIRL
            BIRL
          BIRL
        BIRL
      BIRL
      T_N3 = T_P - 1
      ELE QUE A GENTE QUER? T_PX > 0
        T_OK3 = AJUDA O MALUCO TA DOENTE D_LIVRE(S, T_N3)
        ELE QUE A GENTE QUER? T_OK3 == 1
          T_V3 = T_VIS.charAt(T_N3) || "1"
          T_V3C = T_V3 + ""
          ELE QUE A GENTE QUER? T_V3C == "0"
            T_VIS = AJUDA O MALUCO TA DOENTE D_SET1(T_VIS, T_N3, "1")
            T_DIR3 = "A"
            ELE QUE A GENTE QUER? T_P != T_D
              T_FD3 = T_FIRST.charAt(T_P) || "."
              T_DIR3 = T_FD3 + ""
            BIRL
            T_FIRST = AJUDA O MALUCO TA DOENTE D_SET1(T_FIRST, T_N3, T_DIR3)
            T_Q.push("" + T_N3)
            ELE QUE A GENTE QUER? T_N3 == T_ALVO
              ELE QUE A GENTE QUER? T_RES == ""
                T_RES = T_DIR3 + ""
              BIRL
            BIRL
          BIRL
        BIRL
      BIRL
      T_N4 = T_P + 1
      ELE QUE A GENTE QUER? T_PX < 9
        T_OK4 = AJUDA O MALUCO TA DOENTE D_LIVRE(S, T_N4)
        ELE QUE A GENTE QUER? T_OK4 == 1
          T_V4 = T_VIS.charAt(T_N4) || "1"
          T_V4C = T_V4 + ""
          ELE QUE A GENTE QUER? T_V4C == "0"
            T_VIS = AJUDA O MALUCO TA DOENTE D_SET1(T_VIS, T_N4, "1")
            T_DIR4 = "D"
            ELE QUE A GENTE QUER? T_P != T_D
              T_FD4 = T_FIRST.charAt(T_P) || "."
              T_DIR4 = T_FD4 + ""
            BIRL
            T_FIRST = AJUDA O MALUCO TA DOENTE D_SET1(T_FIRST, T_N4, T_DIR4)
            T_Q.push("" + T_N4)
            ELE QUE A GENTE QUER? T_N4 == T_ALVO
              ELE QUE A GENTE QUER? T_RES == ""
                T_RES = T_DIR4 + ""
              BIRL
            BIRL
          BIRL
        BIRL
      BIRL
    BIRL
    T_QN = 0 + T_Q.length
  BIRL
  BORA CUMPADI T_RES
BIRL

OH O HOME AI PO MONSTRO D_HITS_INIT(MONSTRO S, MONSTRO FASE)
  T_FF = FASE + 0
  T_HP = 6 + T_FF
  T_R = ""
  T_K = 0
  NEGATIVA BAMBAM (T_K < 100)
    T_CH = S.charAt(T_K) || ""
    T_CHC = T_CH + ""
    ELE QUE A GENTE QUER? T_CHC == "F"
      T_R = T_R + T_HP
    NAO VAI DAR NAO
      T_R = T_R + "0"
    BIRL
    T_K = T_K + 1
  BIRL
  BORA CUMPADI T_R
BIRL

OH O HOME AI PO FRANGO D_LOAD(MONSTRO FASE)
  T_FF = FASE + 0
  T_M = D_M1 + ""
  ELE QUE A GENTE QUER? T_FF == 2
    T_M = D_M2 + ""
  BIRL
  ELE QUE A GENTE QUER? T_FF == 3
    T_M = D_M3 + ""
  BIRL
  D_GRID = T_M + ""
  D_FASE = T_FF + 0
  T_HPOS = AJUDA O MALUCO TA DOENTE D_ACHA(T_M, "@")
  T_POS = T_HPOS + 0
  T_PX = T_POS % 10
  T_PBASE = T_POS - T_PX
  T_PY = T_PBASE / 10
  D_HX = T_PX + 0
  D_HY = T_PY + 0
  D_HITS = AJUDA O MALUCO TA DOENTE D_HITS_INIT(T_M, T_FF)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_SEED(MONSTRO S)
  FRANGO SS = S + 0
  SS = 0 + Math.floor(SS)
  ELE QUE A GENTE QUER? SS < 1
    SS = 12345
  BIRL
  ELE QUE A GENTE QUER? SS > 2147483645
    SS = 2147483645
  BIRL
  D_SD = SS + 0
  D_RND = 0
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_PROX_RND(MONSTRO LIXO)
  FRANGO ZSD = D_SD + 0
  FRANGO ZN = ZSD * 48271
  FRANGO ZR = ZN % 2147483647
  D_SD = ZR + 0
  D_RND = ZR + 0
  BORA CUMPADI ZR
BIRL

OH O HOME AI PO FRANGO D_DADO(MONSTRO LADOS)
  FRANGO ZL = LADOS + 0
  FRANGO ZV = AJUDA O MALUCO TA DOENTE D_PROX_RND(0)
  FRANGO ZM = ZV % ZL
  FRANGO ZR2 = ZM + 1
  BORA CUMPADI ZR2
BIRL

OH O HOME AI PO FRANGO D_PERSONAGEM_INIT(MONSTRO NOME)
  FRANGO NM = NOME + ""
  D_ITENS = 3
  D_NIVEL = 1
  D_XP = 0
  D_BUFF_ATK = 0
  D_FICHA = 0
  ELE QUE A GENTE QUER? NM == "bambam"
    D_PERSONAGEM = "bambam"
    D_NOME = "BAMBAM"
    D_HP_MAX = 50
    D_HP = 50
    D_ATK = 4
    D_DEF = 3
    D_PUMP = 20
    D_PUMP_MAX = 20
  BIRL
  ELE QUE A GENTE QUER? NM == "toguro"
    D_PERSONAGEM = "toguro"
    D_NOME = "TOGURO"
    D_HP_MAX = 46
    D_HP = 46
    D_ATK = 5
    D_DEF = 3
    D_PUMP = 20
    D_PUMP_MAX = 20
  BIRL
  ELE QUE A GENTE QUER? NM == "felipe"
    D_PERSONAGEM = "felipe"
    D_NOME = "FELIPE"
    D_HP_MAX = 45
    D_HP = 45
    D_ATK = 3
    D_DEF = 4
    D_PUMP = 25
    D_PUMP_MAX = 25
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_HABILIDADE_CUSTO(MONSTRO HAB)
  FRANGO TH = HAB + ""
  ELE QUE A GENTE QUER? TH == "birl"
    BORA CUMPADI 10
  BIRL
  ELE QUE A GENTE QUER? TH == "ajuda"
    BORA CUMPADI 5
  BIRL
  ELE QUE A GENTE QUER? TH == "hora"
    BORA CUMPADI 12
  BIRL
  ELE QUE A GENTE QUER? TH == "motivacao"
    BORA CUMPADI 8
  BIRL
  ELE QUE A GENTE QUER? TH == "ficha"
    BORA CUMPADI 10
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_INIM_CADASTRAR(MONSTRO ID)
  FRANGO TI = ID + ""
  D_FICHA = 0
  ELE QUE A GENTE QUER? TI == "frango_mutante"
    D_INIM_ID = "frango_mutante"
    D_INIM_NOME = "FRANGO MUTANTE"
    D_INIM_HP = 20
    D_INIM_HP_MAX = 20
    D_INIM_DEF = 1
    D_INIM_DADO = 6
    D_INIM_BONUS = 3
    D_INIM_XP = 15
    D_INIM_LOOT = 5
    D_INIM_FALA = "Cocorico! Vou te bicar!"
  BIRL
  ELE QUE A GENTE QUER? TI == "personal_chato"
    D_INIM_ID = "personal_chato"
    D_INIM_NOME = "PERSONAL CHATO"
    D_INIM_HP = 32
    D_INIM_HP_MAX = 32
    D_INIM_DEF = 2
    D_INIM_DADO = 8
    D_INIM_BONUS = 4
    D_INIM_XP = 30
    D_INIM_LOOT = 10
    D_INIM_FALA = "Mais uma serie, frango! Vamos la!"
  BIRL
  ELE QUE A GENTE QUER? TI == "dono_academia"
    D_INIM_ID = "dono_academia"
    D_INIM_NOME = "DONO DA ACADEMIA (CHEFE)"
    D_INIM_HP = 66
    D_INIM_HP_MAX = 66
    D_INIM_DEF = 4
    D_INIM_DADO = 8
    D_INIM_BONUS = 6
    D_INIM_XP = 100
    D_INIM_LOOT = 50
    D_INIM_FALA = "Esta academia e minha, monstro!"
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_CURA(MONSTRO N)
  D_HP = D_HP + N
  ELE QUE A GENTE QUER? D_HP > D_HP_MAX
    D_HP = D_HP_MAX + 0
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_GANHA_XP(MONSTRO N)
  D_XP = D_XP + N
  FRANGO META = D_NIVEL * 30
  FRANGO META1 = META - 1
  NEGATIVA BAMBAM (D_XP > META1)
    D_XP = D_XP - META
    D_NIVEL = D_NIVEL + 1
    D_HP_MAX = D_HP_MAX + 5
    D_PUMP_MAX = D_PUMP_MAX + 2
    D_ATK = D_ATK + 1
    D_HP = D_HP_MAX + 0
    D_PUMP = D_PUMP_MAX + 0
    AJUDA O MALUCO TA DOENTE TEXTO("  SUBIU PRO NIVEL " + D_NIVEL + "! VIDA, PUMP E ATAQUE AUMENTARAM.")
    AJUDA O MALUCO TA DOENTE SOM("vitoria")
    META = D_NIVEL * 30
    META1 = META - 1
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_ATACA(MONSTRO PCT)
  FRANGO P100 = PCT + 0
  FRANGO ROLL = AJUDA O MALUCO TA DOENTE D_DADO(20)
  FRANGO EXTRA = P100 / 50
  EXTRA = 0 + Math.floor(EXTRA)
  FRANGO MODA = D_ATK + EXTRA
  FRANGO TOTAL = ROLL + MODA
  FRANGO AC = D_INIM_DEF + 10
  FRANGO ACM = AC - 1
  AJUDA O MALUCO TA DOENTE DADO("ROLAGEM D20 " + ROLL)
  AJUDA O MALUCO TA DOENTE TEXTO("  D20: " + ROLL + " + " + MODA + " = " + TOTAL + "   (DEFESA DO INIMIGO: " + AC + ")")
  FRANGO RES = 0
  ELE QUE A GENTE QUER? TOTAL > ACM
    RES = 1
  BIRL
  ELE QUE A GENTE QUER? ROLL == 20
    RES = 2
  BIRL
  ELE QUE A GENTE QUER? ROLL == 1
    RES = 3
  BIRL
  FRANGO D8 = AJUDA O MALUCO TA DOENTE D_DADO(8)
  FRANGO DANO = D8 + D_ATK
  DANO = DANO * P100
  DANO = DANO / 100
  DANO = 0 + Math.floor(DANO)
  ELE QUE A GENTE QUER? DANO < 1
    DANO = 1
  BIRL
  ELE QUE A GENTE QUER? RES == 3
    AJUDA O MALUCO TA DOENTE TEXTO("  FALHA CRITICA! VOCE ESCORREGOU NO SUCO DE FRANGO! (ERROU)")
    AJUDA O MALUCO TA DOENTE SOM("erro")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? RES == 2
    DANO = DANO * 2
    D_INIM_HP = D_INIM_HP - DANO
    AJUDA O MALUCO TA DOENTE TEXTO("  CRITICO! BIRL! DOBROU O DANO! -" + DANO + " HP")
    AJUDA O MALUCO TA DOENTE SOM("birl")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? RES == 1
    D_INIM_HP = D_INIM_HP - DANO
    AJUDA O MALUCO TA DOENTE TEXTO("  VOCE ACERTOU! -" + DANO + " HP")
    AJUDA O MALUCO TA DOENTE SOM("acerto")
    BORA CUMPADI 0
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  VOCE ERROU. O INIMIGO DESVIOU.")
  AJUDA O MALUCO TA DOENTE SOM("erro")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_INIMIGO_ATACA(MONSTRO LIXO)
  FRANGO ROLL = AJUDA O MALUCO TA DOENTE D_DADO(20)
  FRANGO TOTAL = ROLL + D_INIM_BONUS
  FRANGO AC = D_DEF + 10
  FRANGO ACM = AC - 1
  AJUDA O MALUCO TA DOENTE TEXTO("  " + D_INIM_NOME + " ROLOU D20: " + ROLL + " + " + D_INIM_BONUS + " = " + TOTAL + "   (SUA DEFESA: " + AC + ")")
  FRANGO RES = 0
  ELE QUE A GENTE QUER? TOTAL > ACM
    RES = 1
  BIRL
  ELE QUE A GENTE QUER? ROLL == 20
    RES = 2
  BIRL
  ELE QUE A GENTE QUER? ROLL == 1
    RES = 3
  BIRL
  FRANGO DANO = AJUDA O MALUCO TA DOENTE D_DADO(D_INIM_DADO)
  ELE QUE A GENTE QUER? RES == 3
    AJUDA O MALUCO TA DOENTE TEXTO("  O INIMIGO TROPECOU NO HALTER! ERROU FEIO.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? RES == 2
    DANO = DANO * 2
    D_HP = D_HP - DANO
    AJUDA O MALUCO TA DOENTE TEXTO("  GOLPE CRITICO DO INIMIGO! -" + DANO + " HP")
    AJUDA O MALUCO TA DOENTE SOM("erro")
  BIRL
  ELE QUE A GENTE QUER? RES == 1
    D_HP = D_HP - DANO
    AJUDA O MALUCO TA DOENTE TEXTO("  O INIMIGO TE ACERTOU! -" + DANO + " HP")
    AJUDA O MALUCO TA DOENTE SOM("erro")
  BIRL
  ELE QUE A GENTE QUER? RES == 0
    AJUDA O MALUCO TA DOENTE TEXTO("  O INIMIGO ERROU. VOCE DESVIOU.")
  BIRL
  ELE QUE A GENTE QUER? D_HP < 0
    D_HP = 0
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_ACAO_ATACAR(MONSTRO LIXO)
  FRANGO PCT = 100
  ELE QUE A GENTE QUER? D_PERSONAGEM == "toguro"
    FRANGO OPS = "20=20% DO PODER (SEM CUSTO)"
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  PORCENTAGEM DE PODER:")
    AJUDA O MALUCO TA DOENTE TEXTO("  20  = 20% DO PODER (SEM CUSTO)")
    ELE QUE A GENTE QUER? D_PUMP > 2
      OPS = OPS + "|50=50% (PUMP -3)"
      AJUDA O MALUCO TA DOENTE TEXTO("  50  = 50% DO PODER (PUMP -3)")
    BIRL
    ELE QUE A GENTE QUER? D_PUMP > 5
      OPS = OPS + "|80=80% (PUMP -6, VIDA -1)"
      AJUDA O MALUCO TA DOENTE TEXTO("  80  = 80% DO PODER (PUMP -6, VIDA -1)")
    BIRL
    ELE QUE A GENTE QUER? D_PUMP > 9
      OPS = OPS + "|100=100% (PUMP -10, VIDA -3)"
      AJUDA O MALUCO TA DOENTE TEXTO("  100 = 100% DO PODER (PUMP -10, VIDA -3)")
    BIRL
    AJUDA O MALUCO TA DOENTE DADO("OPCOES " + OPS)
    FRANGO ESC = AJUDA O MALUCO TA DOENTE PEDE("choice", "QUANTOS POR CENTO DO PODER?")
    FRANGO ESCN = 0 + parseInt(ESC, 10)
    PCT = 20
    ELE QUE A GENTE QUER? ESCN == 50
      ELE QUE A GENTE QUER? D_PUMP > 2
        PCT = 50
        D_PUMP = D_PUMP - 3
      BIRL
    BIRL
    ELE QUE A GENTE QUER? ESCN == 80
      ELE QUE A GENTE QUER? D_PUMP > 5
        PCT = 80
        D_PUMP = D_PUMP - 6
        D_HP = D_HP - 1
      BIRL
    BIRL
    ELE QUE A GENTE QUER? ESCN == 100
      ELE QUE A GENTE QUER? D_PUMP > 9
        PCT = 100
        D_PUMP = D_PUMP - 10
        D_HP = D_HP - 3
      BIRL
    BIRL
    ELE QUE A GENTE QUER? D_HP < 1
      D_HP = 1
    BIRL
    AJUDA O MALUCO TA DOENTE TEXTO("  " + D_NOME + " USA " + PCT + "% DO PODER!")
  BIRL
  AJUDA O MALUCO TA DOENTE D_ATACA(PCT)
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO D_HAB_PERMITIDA(MONSTRO HAB)
  FRANGO PH = HAB + ""
  ELE QUE A GENTE QUER? D_PERSONAGEM == "bambam"
    ELE QUE A GENTE QUER? PH == "birl"
      BORA CUMPADI 1
    BIRL
    ELE QUE A GENTE QUER? PH == "ajuda"
      BORA CUMPADI 1
    BIRL
    ELE QUE A GENTE QUER? PH == "hora"
      BORA CUMPADI 1
    BIRL
  BIRL
  ELE QUE A GENTE QUER? D_PERSONAGEM == "toguro"
    ELE QUE A GENTE QUER? PH == "birl"
      BORA CUMPADI 1
    BIRL
    ELE QUE A GENTE QUER? PH == "hora"
      BORA CUMPADI 1
    BIRL
  BIRL
  ELE QUE A GENTE QUER? D_PERSONAGEM == "felipe"
    ELE QUE A GENTE QUER? PH == "ajuda"
      BORA CUMPADI 1
    BIRL
    ELE QUE A GENTE QUER? PH == "motivacao"
      BORA CUMPADI 1
    BIRL
    ELE QUE A GENTE QUER? PH == "ficha"
      BORA CUMPADI 1
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_USA_HAB(MONSTRO HAB)
  FRANGO UH = HAB + ""
  FRANGO PERM = AJUDA O MALUCO TA DOENTE D_HAB_PERMITIDA(UH)
  ELE QUE A GENTE QUER? PERM == 0
    AJUDA O MALUCO TA DOENTE TEXTO("  " + D_NOME + " NAO SABE ESSA HABILIDADE.")
    BORA CUMPADI 0
  BIRL
  FRANGO CUSTO = AJUDA O MALUCO TA DOENTE D_HABILIDADE_CUSTO(UH)
  ELE QUE A GENTE QUER? D_PUMP < CUSTO
    AJUDA O MALUCO TA DOENTE TEXTO("  PUMP INSUFICIENTE! PRECISA DE " + CUSTO + " E VOCE TEM " + D_PUMP + ".")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? UH == "birl"
    D_PUMP = D_PUMP - CUSTO
    FRANGO DB = AJUDA O MALUCO TA DOENTE D_DADO(8)
    DB = DB + D_ATK
    DB = DB + 4
    D_INIM_HP = D_INIM_HP - DB
    AJUDA O MALUCO TA DOENTE TEXTO("  BIRL! GOLPE FORTE QUE NAO ERRA! -" + DB + " HP NO INIMIGO.")
    AJUDA O MALUCO TA DOENTE SOM("birl")
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? UH == "ajuda"
    D_PUMP = D_PUMP - CUSTO
    AJUDA O MALUCO TA DOENTE D_CURA(15)
    AJUDA O MALUCO TA DOENTE TEXTO("  AJUDA O MALUCO TA DOENTE! CURA 15 HP.")
    AJUDA O MALUCO TA DOENTE SOM("ajuda_o_maluco")
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? UH == "hora"
    ELE QUE A GENTE QUER? D_BUFF_ATK > 3
      AJUDA O MALUCO TA DOENTE TEXTO("  O SHOW JA ESTA NO TALO. ATAQUE NO MAXIMO NESTE COMBATE.")
      BORA CUMPADI 0
    BIRL
    D_PUMP = D_PUMP - CUSTO
    D_ATK = D_ATK + 2
    D_BUFF_ATK = D_BUFF_ATK + 2
    AJUDA O MALUCO TA DOENTE TEXTO("  HORA DO SHOW! ATAQUE +2 ATE O FIM DO COMBATE.")
    AJUDA O MALUCO TA DOENTE SOM("hora_do_show")
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? UH == "motivacao"
    D_PUMP = D_PUMP - CUSTO
    AJUDA O MALUCO TA DOENTE D_CURA(10)
    D_ATK = D_ATK + 1
    D_BUFF_ATK = D_BUFF_ATK + 1
    AJUDA O MALUCO TA DOENTE TEXTO("  MOTIVACAO! +10 HP E +1 ATAQUE ATE O FIM DO COMBATE.")
    AJUDA O MALUCO TA DOENTE SOM("ajuda_o_maluco")
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? UH == "ficha"
    ELE QUE A GENTE QUER? D_FICHA == 1
      AJUDA O MALUCO TA DOENTE TEXTO("  O INIMIGO JA RECEBEU A FICHA DE TREINO.")
      BORA CUMPADI 0
    BIRL
    D_PUMP = D_PUMP - CUSTO
    D_FICHA = 1
    D_INIM_BONUS = D_INIM_BONUS - 2
    ELE QUE A GENTE QUER? D_INIM_BONUS < 0
      D_INIM_BONUS = 0
    BIRL
    ELE QUE A GENTE QUER? D_INIM_DEF > 0
      D_INIM_DEF = D_INIM_DEF - 1
    BIRL
    AJUDA O MALUCO TA DOENTE TEXTO("  FICHA DE TREINO! O INIMIGO FICOU FRACO: ATACA E DEFENDE PIOR.")
    AJUDA O MALUCO TA DOENTE SOM("hora_do_show")
    BORA CUMPADI 1
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_ACAO_HABILIDADE(MONSTRO LIXO)
  FRANGO OPS = ""
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  HABILIDADES (PUMP: " + D_PUMP + " / " + D_PUMP_MAX + "):")
  ELE QUE A GENTE QUER? D_PERSONAGEM == "bambam"
    OPS = "1=BIRL! (PUMP 10)|2=AJUDA O MALUCO TA DOENTE (PUMP 5)|3=HORA DO SHOW (PUMP 12)|0=VOLTAR"
    AJUDA O MALUCO TA DOENTE TEXTO("  1 - BIRL!                    PUMP 10  GOLPE FORTE QUE NAO ERRA")
    AJUDA O MALUCO TA DOENTE TEXTO("  2 - AJUDA O MALUCO TA DOENTE PUMP 5   CURA 15 HP")
    AJUDA O MALUCO TA DOENTE TEXTO("  3 - HORA DO SHOW             PUMP 12  ATAQUE +2 NO COMBATE")
  BIRL
  ELE QUE A GENTE QUER? D_PERSONAGEM == "toguro"
    OPS = "1=BIRL! (PUMP 10)|3=HORA DO SHOW (PUMP 12)|0=VOLTAR"
    AJUDA O MALUCO TA DOENTE TEXTO("  1 - BIRL!                    PUMP 10  GOLPE FORTE QUE NAO ERRA")
    AJUDA O MALUCO TA DOENTE TEXTO("  3 - HORA DO SHOW             PUMP 12  ATAQUE +2 NO COMBATE")
  BIRL
  ELE QUE A GENTE QUER? D_PERSONAGEM == "felipe"
    OPS = "2=AJUDA O MALUCO TA DOENTE (PUMP 5)|4=MOTIVACAO (PUMP 8)|5=FICHA DE TREINO (PUMP 10)|0=VOLTAR"
    AJUDA O MALUCO TA DOENTE TEXTO("  2 - AJUDA O MALUCO TA DOENTE PUMP 5   CURA 15 HP")
    AJUDA O MALUCO TA DOENTE TEXTO("  4 - MOTIVACAO                PUMP 8   CURA 10 HP E ATAQUE +1")
    AJUDA O MALUCO TA DOENTE TEXTO("  5 - FICHA DE TREINO          PUMP 10  ENFRAQUECE O INIMIGO")
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  0 - VOLTAR")
  AJUDA O MALUCO TA DOENTE DADO("OPCOES " + OPS)
  FRANGO ESC = AJUDA O MALUCO TA DOENTE PEDE("choice", "QUAL HABILIDADE?")
  FRANGO HAB = ""
  ELE QUE A GENTE QUER? ESC == "1"
    HAB = "birl"
  BIRL
  ELE QUE A GENTE QUER? ESC == "2"
    HAB = "ajuda"
  BIRL
  ELE QUE A GENTE QUER? ESC == "3"
    HAB = "hora"
  BIRL
  ELE QUE A GENTE QUER? ESC == "4"
    HAB = "motivacao"
  BIRL
  ELE QUE A GENTE QUER? ESC == "5"
    HAB = "ficha"
  BIRL
  ELE QUE A GENTE QUER? HAB == ""
    BORA CUMPADI 0
  BIRL
  FRANGO USOU = AJUDA O MALUCO TA DOENTE D_USA_HAB(HAB)
  BORA CUMPADI USOU
BIRL

OH O HOME AI PO FRANGO D_ACAO_ITEM(MONSTRO LIXO)
  ELE QUE A GENTE QUER? D_ITENS < 1
    AJUDA O MALUCO TA DOENTE TEXTO("  SEM WHEY NA MOCHILA! TENTE OUTRA ACAO.")
    BORA CUMPADI 0
  BIRL
  D_ITENS = D_ITENS - 1
  AJUDA O MALUCO TA DOENTE D_CURA(12)
  AJUDA O MALUCO TA DOENTE TEXTO("  WHEY NA VEIA! +12 HP. SOBRARAM " + D_ITENS + " WHEY.")
  AJUDA O MALUCO TA DOENTE SOM("ajuda_o_maluco")
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO D_ACAO_FUGIR(MONSTRO LIXO)
  FRANGO ROLL = AJUDA O MALUCO TA DOENTE D_DADO(20)
  FRANGO TOTAL = ROLL + D_DEF
  AJUDA O MALUCO TA DOENTE TEXTO("  FUGA: D20 " + ROLL + " + " + D_DEF + " = " + TOTAL + "   (PRECISA DE 12)")
  ELE QUE A GENTE QUER? TOTAL > 11
    AJUDA O MALUCO TA DOENTE TEXTO("  FUGIU COM SUCESSO! VALEU, MONSTRO!")
    BORA CUMPADI 3
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  NAO CONSEGUIU FUGIR. O INIMIGO TE PEGOU.")
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO D_COMBATE(MONSTRO ID)
  AJUDA O MALUCO TA DOENTE D_INIM_CADASTRAR(ID)
  D_COMBATE_ATIVO = 1
  D_BUFF_ATK = 0
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ===== COMBATE =====")
  AJUDA O MALUCO TA DOENTE TEXTO("  INIMIGO: " + D_INIM_NOME)
  AJUDA O MALUCO TA DOENTE DADO("RETRATO " + D_INIM_ID)
  AJUDA O MALUCO TA DOENTE DIALOGO(D_INIM_NOME, D_INIM_FALA)
  AJUDA O MALUCO TA DOENTE SOM("hora_do_show")
  FRANGO ESTADO = 0
  NEGATIVA BAMBAM (ESTADO == 0)
    AJUDA O MALUCO TA DOENTE D_ESTADO(0)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  " + D_NOME + "  HP: " + D_HP + " / " + D_HP_MAX + "   PUMP: " + D_PUMP + " / " + D_PUMP_MAX + "   WHEY: " + D_ITENS)
    AJUDA O MALUCO TA DOENTE TEXTO("  " + D_INIM_NOME + "  HP: " + D_INIM_HP + " / " + D_INIM_HP_MAX)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  1 - ATACAR")
    AJUDA O MALUCO TA DOENTE TEXTO("  2 - HABILIDADE")
    AJUDA O MALUCO TA DOENTE TEXTO("  3 - ITEM (WHEY)")
    AJUDA O MALUCO TA DOENTE TEXTO("  4 - FUGIR")
    AJUDA O MALUCO TA DOENTE DADO("OPCOES 1=ATACAR|2=HABILIDADE|3=ITEM (WHEY)|4=FUGIR")
    FRANGO ESC = AJUDA O MALUCO TA DOENTE PEDE("choice", "SUA ACAO:")
    FRANGO TURNO = 0
    ELE QUE A GENTE QUER? ESC == "1"
      TURNO = AJUDA O MALUCO TA DOENTE D_ACAO_ATACAR(0)
    BIRL
    ELE QUE A GENTE QUER? ESC == "2"
      TURNO = AJUDA O MALUCO TA DOENTE D_ACAO_HABILIDADE(0)
    BIRL
    ELE QUE A GENTE QUER? ESC == "3"
      TURNO = AJUDA O MALUCO TA DOENTE D_ACAO_ITEM(0)
    BIRL
    ELE QUE A GENTE QUER? ESC == "4"
      FRANGO RF = AJUDA O MALUCO TA DOENTE D_ACAO_FUGIR(0)
      ELE QUE A GENTE QUER? RF == 3
        ESTADO = 3
      NAO VAI DAR NAO
        TURNO = 1
      BIRL
    BIRL
    ELE QUE A GENTE QUER? TURNO == 0
      ELE QUE A GENTE QUER? ESTADO == 0
        ELE QUE A GENTE QUER? ESC != "1"
          ELE QUE A GENTE QUER? ESC != "2"
            ELE QUE A GENTE QUER? ESC != "3"
              ELE QUE A GENTE QUER? ESC != "4"
                AJUDA O MALUCO TA DOENTE TEXTO("  OPCAO INVALIDA, MONSTRO! ESCOLHE DE 1 A 4.")
              BIRL
            BIRL
          BIRL
        BIRL
      BIRL
    BIRL
    ELE QUE A GENTE QUER? D_INIM_HP < 1
      ESTADO = 1
    BIRL
    ELE QUE A GENTE QUER? ESTADO == 0
      ELE QUE A GENTE QUER? TURNO == 1
        AJUDA O MALUCO TA DOENTE D_INIMIGO_ATACA(0)
        D_PUMP = D_PUMP + 1
        ELE QUE A GENTE QUER? D_PUMP > D_PUMP_MAX
          D_PUMP = D_PUMP_MAX + 0
        BIRL
        ELE QUE A GENTE QUER? D_HP < 1
          ESTADO = 2
        BIRL
      BIRL
    BIRL
  BIRL
  D_ATK = D_ATK - D_BUFF_ATK
  D_BUFF_ATK = 0
  D_COMBATE_ATIVO = 0
  ELE QUE A GENTE QUER? ESTADO == 1
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  INIMIGO DERROTADO! +" + D_INIM_XP + " XP")
    AJUDA O MALUCO TA DOENTE SOM("vitoria")
    ELE QUE A GENTE QUER? D_INIM_LOOT > 9
      D_ITENS = D_ITENS + 1
      AJUDA O MALUCO TA DOENTE TEXTO("  O INIMIGO DEIXOU CAIR UM WHEY!")
    BIRL
    AJUDA O MALUCO TA DOENTE D_GANHA_XP(D_INIM_XP)
  BIRL
  ELE QUE A GENTE QUER? ESTADO == 2
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  VOCE CAIU... O " + D_INIM_NOME + " VENCEU.")
    AJUDA O MALUCO TA DOENTE SOM("derrota")
  BIRL
  D_INIM_HP = 0
  D_INIM_HP_MAX = 0
  BORA CUMPADI ESTADO
BIRL

OH O HOME AI PO FRANGO D_ESTADO(MONSTRO LIXO)
  FRANGO HS = "nome=" + D_NOME + " hp=" + D_HP + " hpmax=" + D_HP_MAX + " atk=" + D_ATK + " def=" + D_DEF + " pump=" + D_PUMP + " pumpmax=" + D_PUMP_MAX + " fase=" + D_FASE + " nivel=" + D_NIVEL + " xp=" + D_XP + " itens=" + D_ITENS + " x=" + D_HX + " y=" + D_HY
  AJUDA O MALUCO TA DOENTE DADO("HEROI " + HS)
  AJUDA O MALUCO TA DOENTE DADO("MAPA " + D_GRID)
  AJUDA O MALUCO TA DOENTE DADO("INIM nome=" + D_INIM_NOME + " hp=" + D_INIM_HP + " hpmax=" + D_INIM_HP_MAX + " def=" + D_INIM_DEF + " dado=" + D_INIM_DADO)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_DESENHA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 0
    AJUDA O MALUCO TA DOENTE LIMPA(0)
    AJUDA O MALUCO TA DOENTE CABECALHO(0)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  DUNGEON DA ACADEMIA RPG - FASE " + D_FASE + "/3")
    AJUDA O MALUCO TA DOENTE TEXTO("  " + D_NOME + " NV" + D_NIVEL + " | HP: " + D_HP + "/" + D_HP_MAX + " | ATK: " + D_ATK + " | DEF: " + D_DEF + " | PUMP: " + D_PUMP + "/" + D_PUMP_MAX + " | WHEY: " + D_ITENS)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    T_I = 0
    NEGATIVA BAMBAM (T_I < 10)
      T_B = T_I * 10
      T_E = T_B + 10
      T_L = D_GRID.substring(T_B, T_E) || ""
      T_LC = T_L + ""
      AJUDA O MALUCO TA DOENTE TEXTO("  " + T_L)
      T_I = T_I + 1
    BIRL
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  @ VOCE   F INIMIGO   E SAIDA   W WHEY(+ATK)   C COMIDA(+HP)")
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  W/A/S/D = MOVER (SEM ENTER)    Q = SAIR")
    AJUDA O MALUCO TA DOENTE TEXTO("  ANDE ATE UM F PARA LUTAR. PEGUE W (ATAQUE) E C (VIDA).")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_INIMIGOS_AGEM(MONSTRO LIXO)
  T_POSSTR = ""
  T_K = 0
  NEGATIVA BAMBAM (T_K < 100)
    T_CH = D_GRID.charAt(T_K) || ""
    T_CHC = T_CH + ""
    ELE QUE A GENTE QUER? T_CHC == "F"
      T_POSSTR = T_POSSTR + T_K + "|"
    BIRL
    T_K = T_K + 1
  BIRL
  T_ARR = T_POSSTR.split("|") || 0
  T_AN = 0 + T_ARR.length
  NEGATIVA BAMBAM (T_AN > 0)
    T_TOK = T_ARR.shift() || ""
    T_TOKC = T_TOK + ""
    T_TL = 0 + T_TOKC.length
    ELE QUE A GENTE QUER? T_TL > 0
      T_EP = 0 + parseInt(T_TOKC, 10)
      T_ECH = D_GRID.charAt(T_EP) || "."
      T_ECHC = T_ECH + ""
      ELE QUE A GENTE QUER? T_ECHC == "F"
        T_HBASE = D_HY * 10
        T_HPOS = T_HBASE + D_HX
        T_DIST = AJUDA O MALUCO TA DOENTE D_MAN(T_EP, T_HPOS)
        ELE QUE A GENTE QUER? T_DIST == 1
          T_DANO = 1 + D_FASE
          D_HP = D_HP - T_DANO
          AJUDA O MALUCO TA DOENTE TEXTO("  UM INIMIGO TE ACERTOU! -" + T_DANO + " HP")
        NAO VAI DAR NAO
          T_PASSO = AJUDA O MALUCO TA DOENTE D_PASSO(D_GRID, T_EP, T_HPOS)
          T_PASSC = T_PASSO + ""
          T_PL = 0 + T_PASSC.length
          ELE QUE A GENTE QUER? T_PL > 0
            T_NP = T_EP + 0
            ELE QUE A GENTE QUER? T_PASSC == "W"
              T_NP = T_EP - 10
            BIRL
            ELE QUE A GENTE QUER? T_PASSC == "S"
              T_NP = T_EP + 10
            BIRL
            ELE QUE A GENTE QUER? T_PASSC == "A"
              T_NP = T_EP - 1
            BIRL
            ELE QUE A GENTE QUER? T_PASSC == "D"
              T_NP = T_EP + 1
            BIRL
            T_NCH = D_GRID.charAt(T_NP) || "#"
            T_NCHC = T_NCH + ""
            ELE QUE A GENTE QUER? T_NCHC == "."
              T_DIG = D_HITS.charAt(T_EP) || "0"
              T_DIGC = T_DIG + ""
              D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_EP, ".")
              D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_NP, "F")
              D_HITS = AJUDA O MALUCO TA DOENTE D_SET1(D_HITS, T_NP, T_DIGC)
              D_HITS = AJUDA O MALUCO TA DOENTE D_SET1(D_HITS, T_EP, "0")
            BIRL
          BIRL
        BIRL
      BIRL
    BIRL
    T_AN = T_AN - 1
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_AGE(MONSTRO OP)
  T_OPC = OP + ""
  T_TX = D_HX + 0
  T_TY = D_HY + 0
  T_DIR = ""
  ELE QUE A GENTE QUER? T_OPC == "w"
    T_TY = T_TY - 1
    T_DIR = "W"
  BIRL
  ELE QUE A GENTE QUER? T_OPC == "s"
    T_TY = T_TY + 1
    T_DIR = "S"
  BIRL
  ELE QUE A GENTE QUER? T_OPC == "a"
    T_TX = T_TX - 1
    T_DIR = "A"
  BIRL
  ELE QUE A GENTE QUER? T_OPC == "d"
    T_TX = T_TX + 1
    T_DIR = "D"
  BIRL
  ELE QUE A GENTE QUER? T_DIR == ""
    AJUDA O MALUCO TA DOENTE TEXTO("  COMANDO INVALIDO. USA W, A, S OU D.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TX < 0
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TX > 9
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TY < 0
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TY > 9
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  T_TBASE = T_TY * 10
  T_ALVO = T_TBASE + T_TX
  T_HBASE = D_HY * 10
  T_HPOS = T_HBASE + D_HX
  T_C = D_GRID.charAt(T_ALVO) || "#"
  T_CC = T_C + ""
  ELE QUE A GENTE QUER? T_CC == "#"
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE. O MONSTRO NAO ATRAVESSA CONCRETO.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "F"
    FRANGO ALVO_L = T_ALVO + 0
    FRANGO INIM_ID = ""
    ELE QUE A GENTE QUER? D_FASE == 1
      INIM_ID = "frango_mutante"
    BIRL
    ELE QUE A GENTE QUER? D_FASE == 2
      INIM_ID = "personal_chato"
    BIRL
    ELE QUE A GENTE QUER? D_FASE == 3
      INIM_ID = "dono_academia"
    BIRL
    FRANGO RC = AJUDA O MALUCO TA DOENTE D_COMBATE(INIM_ID)
    ELE QUE A GENTE QUER? RC == 1
      D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, ALVO_L, ".")
    BIRL
    ELE QUE A GENTE QUER? RC == 2
      D_FIM = 2
    BIRL
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? T_CC == "E"
    T_INIM = AJUDA O MALUCO TA DOENTE D_CONT(D_GRID, "F")
    ELE QUE A GENTE QUER? T_INIM > 0
      AJUDA O MALUCO TA DOENTE TEXTO("  SAIDA TRANCADA. MATE TODOS PRIMEIRO.")
      BORA CUMPADI 0
    BIRL
    T_FF = D_FASE + 0
    ELE QUE A GENTE QUER? T_FF > 2
      D_FIM = 1
      AJUDA O MALUCO TA DOENTE TEXTO("  VOCE ZEROU A DUNGEON! BIRL!")
      BORA CUMPADI 0
    BIRL
    T_PROX = T_FF + 1
    AJUDA O MALUCO TA DOENTE D_LOAD(T_PROX)
    AJUDA O MALUCO TA DOENTE D_CURA(10)
    AJUDA O MALUCO TA DOENTE TEXTO("  FASE " + T_PROX + " LIBERADA! +10 HP.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "W"
    D_ATK = D_ATK + 2
    ELE QUE A GENTE QUER? D_ATK > 14
      D_ATK = 14
    BIRL
    D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, ".")
    AJUDA O MALUCO TA DOENTE TEXTO("  WHEY +2 ATK.")
  BIRL
  ELE QUE A GENTE QUER? T_CC == "C"
    AJUDA O MALUCO TA DOENTE D_CURA(8)
    D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, ".")
    AJUDA O MALUCO TA DOENTE TEXTO("  FRANGO +8 HP.")
  BIRL
  D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_HPOS, ".")
  D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, "@")
  D_HX = T_TX + 0
  D_HY = T_TY + 0
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO D_SELECIONA_PERSONAGEM(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHA SEU PERSONAGEM")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  1 - BAMBAM  (TANK: MUITA VIDA, BIRL! E CURA)")
  AJUDA O MALUCO TA DOENTE TEXTO("  2 - TOGURO  (ESCOLHE 20, 50, 80 OU 100% DO PODER A CADA ATAQUE)")
  AJUDA O MALUCO TA DOENTE TEXTO("  3 - FELIPE  (PERSONAL TRAINER: CURA E ENFRAQUECE O INIMIGO)")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE DADO("OPCOES 1=BAMBAM (TANK)|2=TOGURO (% DE PODER)|3=FELIPE (PERSONAL)")
  FRANGO OK = 0
  NEGATIVA BAMBAM (OK == 0)
    FRANGO ESC = AJUDA O MALUCO TA DOENTE PEDE("choice", "ESCOLHA (1-3):")
    ELE QUE A GENTE QUER? ESC == "1"
      AJUDA O MALUCO TA DOENTE D_PERSONAGEM_INIT("bambam")
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? ESC == "2"
      AJUDA O MALUCO TA DOENTE D_PERSONAGEM_INIT("toguro")
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? ESC == "3"
      AJUDA O MALUCO TA DOENTE D_PERSONAGEM_INIT("felipe")
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? OK == 0
      AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHE 1, 2 OU 3, MONSTRO!")
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE DADO("RETRATO " + D_PERSONAGEM)
  ELE QUE A GENTE QUER? D_PERSONAGEM == "bambam"
    AJUDA O MALUCO TA DOENTE DIALOGO(D_NOME, "E HORA DO SHOW! BIRL!")
  BIRL
  ELE QUE A GENTE QUER? D_PERSONAGEM == "toguro"
    AJUDA O MALUCO TA DOENTE DIALOGO(D_NOME, "Vou usar so um pouquinho do meu poder.")
  BIRL
  ELE QUE A GENTE QUER? D_PERSONAGEM == "felipe"
    AJUDA O MALUCO TA DOENTE DIALOGO(D_NOME, "Bora treinar, monstro! Eu cuido da ficha.")
  BIRL
  AJUDA O MALUCO TA DOENTE SOM("hora_do_show")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_DUNGEON(MONSTRO LIXO)
  D_GRID = ""
  D_HITS = ""
  D_FASE = 1
  D_FIM = 0
  D_COMBATE_ATIVO = 0
  D_INIM_HP = 0
  D_INIM_HP_MAX = 0
  FRANGO SEMENTE = ENV.BIRL_SEED || "0"
  FRANGO SN = 0 + parseInt(SEMENTE, 10)
  ELE QUE A GENTE QUER? SN > 0
    AJUDA O MALUCO TA DOENTE D_SEED(SN)
  NAO VAI DAR NAO
    FRANGO AGORA = 0 + Date.now()
    FRANGO AG2 = AGORA % 2147483000
    FRANGO AG3 = AG2 + 7
    AJUDA O MALUCO TA DOENTE D_SEED(AG3)
  BIRL
  AJUDA O MALUCO TA DOENTE D_SELECIONA_PERSONAGEM(0)
  AJUDA O MALUCO TA DOENTE D_LOAD(1)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  DUNGEON DA ACADEMIA RPG")
  AJUDA O MALUCO TA DOENTE TEXTO("  COMBATE POR TURNOS COM DADOS (D20).")
  AJUDA O MALUCO TA DOENTE TEXTO("  MATE TODOS OS F E CHEGUE NA SAIDA E.")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  FRANGO SAIR = 0
  NEGATIVA BAMBAM (SAIR == 0)
    AJUDA O MALUCO TA DOENTE D_ESTADO(0)
    AJUDA O MALUCO TA DOENTE D_DESENHA(0)
    FRANGO OP = AJUDA O MALUCO TA DOENTE PEDE("move", "SUA JOGADA (W/A/S/D MOVE, Q SAI):")
    FRANGO OPL = OP.toLowerCase() || ""
    FRANGO OPC = OPL + ""
    ELE QUE A GENTE QUER? OPC == "q"
      SAIR = 1
    BIRL
    ELE QUE A GENTE QUER? SAIR == 0
      FRANGO AGIU = AJUDA O MALUCO TA DOENTE D_AGE(OPC)
      FRANGO AG = AGIU + 0
      ELE QUE A GENTE QUER? AG == 1
        ELE QUE A GENTE QUER? D_FIM == 0
          AJUDA O MALUCO TA DOENTE D_INIMIGOS_AGEM(0)
        BIRL
      BIRL
      ELE QUE A GENTE QUER? D_HP < 1
        SAIR = 1
        D_FIM = 2
      BIRL
      ELE QUE A GENTE QUER? D_FIM > 0
        SAIR = 1
      BIRL
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE D_ESTADO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  ELE QUE A GENTE QUER? D_FIM == 1
    AJUDA O MALUCO TA DOENTE SOM("vitoria")
    AJUDA O MALUCO TA DOENTE TEXTO("  VITORIA! VOCE ZEROU A DUNGEON, MONSTRO!")
    BORA CUMPADI "VITORIA"
  BIRL
  ELE QUE A GENTE QUER? D_FIM == 2
    AJUDA O MALUCO TA DOENTE SOM("derrota")
    AJUDA O MALUCO TA DOENTE TEXTO("  VOCE MURCHOU. TREINA MAIS.")
    BORA CUMPADI "DERROTA"
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  VOCE SAIU DA DUNGEON.")
  BORA CUMPADI "SAIU"
BIRL
