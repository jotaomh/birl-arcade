FRANGO F_DIC = "ABACATE|ABRIL|ACIDO|ADAO|ADEGA|ADVOGADO|AFLITO|AGITA|AGUA|AGUJA|AIUDA|ALMA|ALTO|AMAR|AMIGO|ANO|ANTA|APEO|ARVORE|ASMA|ATOMO|AVIAO|AZUL|BABO|BACIA|BADA|BAILE|BAIXO|BALAO|BALSA|BAMBA|BANCO|BARCO|BARRA|BASE|BICO|BIGA|BISPO|BLUSA|BOBO|BODE|BOMBO|BOTA|BUZIO|CABECA|CABRA|CACHE|CADA|CAIXA|CALMA|CAMA|CAMPO|CANECA|CANTO|CAPA|CARRO|CARTA|CASA|CASTO|CEGO|CELULA|CEU|CHAVE|CHICO|CHUVA|CIENTO|CINCO|CIRCO|CISTO|CITRO|CLUBE|COBRA|COLAR|COLHE|COLMO|COMO|CONTAS|COPA|COPO|CORA|CORPO|CORVO|COSTA|COUTO|CRATO|CUBA|CUBO|CULPA|CURVA|DADO|DAI|DAMA|DENTE|DEPOIS|DIA|DIRETO|DISCO|DOCE|DOIDO|DOLAR|DOMO|DORA|DUBA|DUQUE|ECO|EFE|ELA|ELE|ELMA|EMU|ENE|ENTAO|EPOPEIA|ERA|ERRO|ESCA|ESPE|ESSA|ESTE|ETAPA|ETIMO|EU|FAIXA|FALA|FALTA|FARO|FARPA|FATO|FAUNA|FECHO|FEDOR|FEIRA|FEIO|FENO|FEROZ|FESTA|FIACO|FICHA|FILME|FILHO|FINO|FIRMA|FLUO|FOCO|FOGUETE|FOME|FORMA|FORTE|FRASE|FREIO|FRESA|FRIO|FRUTA|FUGA|FUNDO|FURTO|GABIA|GALA|GALO|GANHO|GARFO|GARRA|GASOLINA|GATO|GELA|GELO|GERA|GIRA|GLOBO|GOLFO|GOMA|GORILA|GOTA|GRUPO|GUARA|GUETO|HABITO|HALTER|HARPA|HEPTE|HEROI|HIPO|HOSPE|HUMOR|ICE|IGUA|IGUANA|ILHA|IMPETO|INDIA|INFO|INICIO|INSETO|INTEIRO|IODO|IRIA|ISQUEIRO|ITENS|IVO|JABUTO|JACA|JARRO|JAULA|JAZIDA|JEITA|JETO|JOGO|JOIA|JUBA|JURO|KIWI|LABIO|LACAO|LAJE|LAMA|LAPA|LARGO|LASER|LATA|LAVA|LEDO|LEITE|LEMOS|LENTO|LEVE|LIXO|LOBA|LOGO|LOJA|LOMO|LOTE|LUA|LUME|LUPA|LUZ|MACA|MACO|MADEIRA|MAGRO|MAIO|MALA|MAMA|MAMAS|MANE|MANGA|MAPA|MARCO|MARIA|MARROM|MASA|MASSA|MATE|MATO|MEDIA|MEIO|MELA|MELO|MEMORIA|MESA|MESMA|META|MIA|MIEDO|MILHO|MINA|MIO|MIRA|MISTO|MOBIL|MOCHILA|MOEDA|MOE|MOLE|MOLHO|MOMO|MONTE|MORRO|MOSCA|MOTO|MOTOR|MUDE|MULHER|MUNDO|MURAL|NACA|NAVE|NEBLINA|NEGO|NENE|NENUPAR|NEVO|NINHO|NIVE|NOBO|NOCIVO|NOME|NORTE|NOTA|NOVA|NOVATO|NOZ|NUBE|NUVEM|OASIS|OBOE|OCULTO|ODIO|OESTE|OFERTA|OLHO|OMBRO|ONDA|ONIBUS|OPINIO|ORACAO|ORDEM|ORGULHO|ORNAMENTO|OSO|OSTENTO|OVINO|OVOS|PACA|PACO|PADEIRO|PAIS|PAJU|PALHA|PALMA|PALMEIRA|PANO|PAPA|PAPEL|PARA|PARO|PARQUE|PASTA|PATO|PAUSA|PECA|PEDE|PEIXE|PELA|PELO|PENEIRO|PENTE|PEPE|PERNA|PERTO|PIA|PILAR|PILOTO|PIMENTA|PINCA|PINO|PIPOCO|PISO|PIZZA|PLACA|PLANTA|PLATO|POBRE|PODE|POESIA|POEIRA|POLVO|POMBO|POMPEIA|PONTO|PORCO|PORTA|POSTO|POTRO|POVO|PRAIA|PRAZO|PRETO|PREZA|PROSA|PUBLICO|PULGA|PULMAO|PUNTO|PURO|QUEIJO|QUEM|RABAO|RABO|RACA|RADIO|RAFIA|RAIO|RAIZ|RAMO|RANCHO|RAPAZ|RATO|RAZAO|REDE|REGE|REGIA|REGRA|REMAR|REMENDO|REPETIR|RESTO|REUNI|RIA|RIQUEZA|RISCO|RISO|ROBA|ROBO|ROCHE|ROEDOR|ROLO|ROSA|ROSTO|ROUPA|RUIDO|RUMO|RURAL|SABIA|SABOR|SACA|SACO|SACRIFICIO|SADO|SAI|SAIA|SAIO|SALA|SALDO|SALSA|SALTO|SALVO|SAMBA|SANGUE|SANTA|SANTO|SAPO|SARA|SARRO|SECA|SECO|SEIO|SEIXO|SEMA|SEME|SENA|SENHOR|SENSO|SEPULTURA|SEQUE|SERAS|SERRA|SERVO|SETE|SEXO|SHEIK|SIGILO|SIGLO|SIGNO|SILABO|SILICIO|SILLA|SILVA|SIMA|SIMPLES|SINA|SINO|SIRENA|SISTEMA|SITIO|SOA|SOBRA|SOCA|SOCO|SOCIO|SODIO|SOFIA|SOFRA|SOGRA|SOJA|SOLA|SOLDADO|SOLENIDADE|SOME|SONHO|SONSO|SONTA|SOPRO|SORTE|SORVO|SOS|SOU|SOUS|SOVINA|SOVINO|SUBSTITUTO|SUCOS|SUL|SUMO|SURTO|SUSO|SUTIL|TABUA|TABULEIRO|TACA|TAFA|TAGARELA|TAIA|TAIO|TALAO|TALCO|TALMA|TAMANHO|TAMBOR|TANGO|TANQUE|TAPA|TAPETE|TARDE|TARMA|TARTA|TARTE|TEIA|TEIMA|TELA|TEMA|TEMPO|TENIS|TENTE|TERMO|TERRA|TETO|TIA|TIJOLO|TIL|TIME|TINTA|TIRO|TOCA|TOMO|TONTO|TOPO|TORTA|TOTEM|TRAVE|TRECO|TREVO|TRIO|TROCA|TROFEU|TRONCO|TUBAO|TUBO|TUMOR|TURMA|TUZA|UAVA|UCIGA|UIRA|ULA|ULTRAS|UMIDO|UMA|UNIDADE|UNIR|URUBU|USAR|USINA|UTIL|UVA|VACA|VAGA|VAI|VAIO|VALSA|VALVO|VAPOR|VARA|VARRO|VASCO|VEIA|VEIO|VELA|VENA|VENCER|VENHO|VERDE|VERME|VERRO|VESPA|VETOR|VIA|VIAGEM|VICIO|VIDA|VIEIRA|VIUVO|VIZINHO|VOAR|VOTO|VULGO|XADREZ|XAROPE|XEQUE|XICARA|XILINTO|XINA|YACI|YAKA|ZABAO|ZEBRA|ZONA|ZOIO|ZULO"

FRANGO F_CAND_STR = ""
FRANGO F_SECRETA = ""
FRANGO F_PADRAO = ""
FRANGO F_CERTAS = ""
FRANGO F_ERRADAS = ""
FRANGO F_CHUTADAS = ""
FRANGO F_ERROS = 0
FRANGO F_MAX = 6

OH O HOME AI PO FRANGO F_RESET(MONSTRO LIXO)
  F_CAND_STR = F_DIC + ""
  F_SECRETA = ""
  F_PADRAO = ""
  F_CERTAS = ""
  F_ERRADAS = ""
  F_CHUTADAS = ""
  F_ERROS = 0
  F_MAX = 6
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO F_ATUALIZA_PADRAO(MONSTRO LIXO)
  FRANGO I = 0
  FRANGO TAM = 0 + F_SECRETA.length
  FRANGO P = ""
  NEGATIVA BAMBAM (I < TAM)
    FRANGO C = F_SECRETA.charAt(I) || ""
    FRANGO J = 0
    FRANGO ACHOU = 0
    FRANGO TC = 0 + F_CERTAS.length
    NEGATIVA BAMBAM (J < TC)
      FRANGO CC = F_CERTAS.charAt(J) || ""
      ELE QUE A GENTE QUER? CC == C
        ACHOU = 1
      BIRL
      J = J + 1
    BIRL
    ELE QUE A GENTE QUER? ACHOU == 1
      P = P + C
    NAO VAI DAR NAO
      P = P + "_"
    BIRL
    I = I + 1
  BIRL
  F_PADRAO = P + ""
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO F_JA_CHUTOU(MONSTRO L, MONSTRO C)
  FRANGO I = 0
  FRANGO TAM = 0 + L.length
  NEGATIVA BAMBAM (I < TAM)
    FRANGO X = L.charAt(I) || ""
    ELE QUE A GENTE QUER? X == C
      BORA CUMPADI 1
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO F_PALAVRA_VALIDA(MONSTRO PAL, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS)
  FRANGO TSP = 0 + SECRETA.length
  FRANGO TP = 0 + PAL.length
  ELE QUE A GENTE QUER? TP != TSP
    BORA CUMPADI 0
  BIRL
  FRANGO I = 0
  NEGATIVA BAMBAM (I < TP)
    FRANGO PC = PAL.charAt(I) || ""
    FRANGO SC = SECRETA.charAt(I) || ""
    FRANGO PCC = PC + ""
    FRANGO SCC = SC + ""
    FRANGO E1 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(CERTAS, PCC)
    FRANGO E2 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(ERRADAS, PCC)
    ELE QUE A GENTE QUER? E2 == 1
      BORA CUMPADI 0
    BIRL
    ELE QUE A GENTE QUER? SCC == "_"
      ELE QUE A GENTE QUER? E1 == 1
        BORA CUMPADI 0
      BIRL
    NAO VAI DAR NAO
      ELE QUE A GENTE QUER? PCC != SCC
        BORA CUMPADI 0
      BIRL
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO F_VALIDA_PALAVRA(MONSTRO S)
  FRANGO TAM = 0 + S.length
  ELE QUE A GENTE QUER? TAM < 2
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? TAM > 15
    BORA CUMPADI 0
  BIRL
  FRANGO I = 0
  NEGATIVA BAMBAM (I < TAM)
    FRANGO C = S.charAt(I) || ""
    FRANGO CC = C + ""
    ELE QUE A GENTE QUER? CC < "A"
      BORA CUMPADI 0
    BIRL
    ELE QUE A GENTE QUER? CC > "Z"
      BORA CUMPADI 0
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO F_FILTRA_STR(MONSTRO BASE, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS)
  FRANGO ARR = BASE.split("|") || 0
  FRANGO NOVO = ""
  FRANGO CNT = 0 + ARR.length
  FRANGO I = 0
  NEGATIVA BAMBAM (I < CNT)
    FRANGO PAL = ARR.shift() || ""
    FRANGO PL = 0 + PAL.length
    FRANGO PLV = PL + 0
    ELE QUE A GENTE QUER? PLV > 0
      FRANGO VAL = AJUDA O MALUCO TA DOENTE F_PALAVRA_VALIDA(PAL, SECRETA, CERTAS, ERRADAS)
      ELE QUE A GENTE QUER? VAL == 1
        NOVO = NOVO + PAL + "|"
      BIRL
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI NOVO
BIRL

OH O HOME AI PO FRANGO F_CONTA_LETRA_CAND(MONSTRO BASE, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS, MONSTRO LETRA)
  FRANGO ARR = BASE.split("|") || 0
  FRANGO CNT = 0
  FRANGO K = 0
  FRANGO CNT_ARR = 0 + ARR.length
  NEGATIVA BAMBAM (K < CNT_ARR)
    FRANGO PAL = ARR.shift() || ""
    FRANGO PL = 0 + PAL.length
    ELE QUE A GENTE QUER? PL > 0
      FRANGO VAL = AJUDA O MALUCO TA DOENTE F_PALAVRA_VALIDA(PAL, SECRETA, CERTAS, ERRADAS)
      ELE QUE A GENTE QUER? VAL == 1
        FRANGO P = 0
        FRANGO TPA = 0 + PAL.length
        NEGATIVA BAMBAM (P < TPA)
          FRANGO PC = PAL.charAt(P) || ""
          FRANGO PCC = PC + ""
          ELE QUE A GENTE QUER? PCC == LETRA
            CNT = CNT + 1
          BIRL
          P = P + 1
        BIRL
      BIRL
    BIRL
    ARR.push(PAL)
    K = K + 1
  BIRL
  BORA CUMPADI CNT
BIRL

OH O HOME AI PO FRANGO F_CONTA_FREQ_STR(MONSTRO BASE, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS)
  FRANGO ARR = BASE.split("|") || 0
  FRANGO RES = ""
  FRANGO LET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  FRANGO I = 0
  NEGATIVA BAMBAM (I < 26)
    FRANGO L = LET.charAt(I) || ""
    FRANGO CNT_ARR = 0 + ARR.length
    FRANGO CNT = 0
    FRANGO KARR = 0
    NEGATIVA BAMBAM (KARR < CNT_ARR)
      FRANGO PAL = ARR.shift() || ""
      FRANGO PL2 = 0 + PAL.length
      FRANGO PL2V = PL2 + 0
      ELE QUE A GENTE QUER? PL2V > 0
        FRANGO VAL = AJUDA O MALUCO TA DOENTE F_PALAVRA_VALIDA(PAL, SECRETA, CERTAS, ERRADAS)
        ELE QUE A GENTE QUER? VAL == 1
          FRANGO P = 0
          FRANGO TPA = 0 + PAL.length
          NEGATIVA BAMBAM (P < TPA)
            FRANGO PC = PAL.charAt(P) || ""
            FRANGO PCC2 = PC + ""
            ELE QUE A GENTE QUER? PCC2 == L
              CNT = CNT + 1
            BIRL
            P = P + 1
          BIRL
        BIRL
      BIRL
      ARR.push(PAL)
      KARR = KARR + 1
    BIRL
    ELE QUE A GENTE QUER? CNT > 0
      FRANGO JC = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(CERTAS, L)
      FRANGO JE = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(ERRADAS, L)
      FRANGO JCV = JC + 0
      FRANGO JEV = JE + 0
      ELE QUE A GENTE QUER? JCV == 0
        ELE QUE A GENTE QUER? JEV == 0
          RES = RES + L
        BIRL
      BIRL
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI RES
BIRL

OH O HOME AI PO FRANGO F_ESCOLHE_MELHOR_LETRA(MONSTRO BASE, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS, MONSTRO FREQ)
  FRANGO MELHOR_LETRA = "A"
  FRANGO MELHOR_CNT = 0
  FRANGO I = 0
  FRANGO TF = 0 + FREQ.length
  NEGATIVA BAMBAM (I < TF)
    FRANGO L = FREQ.charAt(I) || ""
    FRANGO LC = L + ""
    FRANGO CNT = AJUDA O MALUCO TA DOENTE F_CONTA_LETRA_CAND(BASE, SECRETA, CERTAS, ERRADAS, LC)
    ELE QUE A GENTE QUER? CNT > MELHOR_CNT
      MELHOR_CNT = CNT + 0
      MELHOR_LETRA = LC + ""
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI MELHOR_LETRA
BIRL

OH O HOME AI PO FRANGO F_CHUTE_BAMBAM(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE F_ATUALIZA_PADRAO(0)
  F_CAND_STR = AJUDA O MALUCO TA DOENTE F_FILTRA_STR(F_CAND_STR, F_PADRAO, F_CERTAS, F_ERRADAS) || ""
  FRANGO ARR2 = F_CAND_STR.split("|") || 0
  FRANGO TAMC = 0 + ARR2.length
  FRANGO TC2 = TAMC + 0
  ELE QUE A GENTE QUER? TC2 < 2
    FRANGO I = 0
    NEGATIVA BAMBAM (I < 26)
      FRANGO LETR = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
      FRANGO L = LETR.charAt(I) || ""
      FRANGO LC = L + ""
      FRANGO J1 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_CERTAS, LC)
      FRANGO J2 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_ERRADAS, LC)
      ELE QUE A GENTE QUER? J1 == 0
        ELE QUE A GENTE QUER? J2 == 0
          F_CHUTADAS = F_CHUTADAS + L
          FRANGO TSE = 0 + F_SECRETA.length
          FRANGO K = 0
          FRANGO AC = 0
          NEGATIVA BAMBAM (K < TSE)
            FRANGO SC2 = F_SECRETA.charAt(K) || ""
            FRANGO SC2C = SC2 + ""
            ELE QUE A GENTE QUER? SC2C == L
              AC = 1
            BIRL
            K = K + 1
          BIRL
          ELE QUE A GENTE QUER? AC == 1
            F_CERTAS = F_CERTAS + L
            AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... CERTO!")
          NAO VAI DAR NAO
            F_ERRADAS = F_ERRADAS + L
            F_ERROS = F_ERROS + 1
            AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... ERROU!")
          BIRL
          I = 30
        BIRL
      BIRL
      I = I + 1
    BIRL
  NAO VAI DAR NAO
    FRANGO FREQ = AJUDA O MALUCO TA DOENTE F_CONTA_FREQ_STR(F_CAND_STR, F_PADRAO, F_CERTAS, F_ERRADAS) || ""
    FRANGO FREQ_T = 0 + FREQ.length
    ELE QUE A GENTE QUER? FREQ_T == 0
      FRANGO I = 0
      NEGATIVA BAMBAM (I < 26)
        FRANGO LETR2 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        FRANGO L = LETR2.charAt(I) || ""
        FRANGO LC = L + ""
        FRANGO J1 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_CERTAS, LC)
        FRANGO J2 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_ERRADAS, LC)
        ELE QUE A GENTE QUER? J1 == 0
          ELE QUE A GENTE QUER? J2 == 0
            F_CHUTADAS = F_CHUTADAS + L
            FRANGO TSE = 0 + F_SECRETA.length
            FRANGO K = 0
            FRANGO AC = 0
            NEGATIVA BAMBAM (K < TSE)
              FRANGO SC2 = F_SECRETA.charAt(K) || ""
              FRANGO SC2C = SC2 + ""
              ELE QUE A GENTE QUER? SC2C == L
                AC = 1
              BIRL
              K = K + 1
            BIRL
            ELE QUE A GENTE QUER? AC == 1
              F_CERTAS = F_CERTAS + L
              AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... CERTO!")
            NAO VAI DAR NAO
              F_ERRADAS = F_ERRADAS + L
              F_ERROS = F_ERROS + 1
              AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... ERROU!")
            BIRL
            I = 30
          BIRL
        BIRL
        I = I + 1
      BIRL
    NAO VAI DAR NAO
      FRANGO L2 = AJUDA O MALUCO TA DOENTE F_ESCOLHE_MELHOR_LETRA(F_CAND_STR, F_PADRAO, F_CERTAS, F_ERRADAS, FREQ) || "A"
      F_CHUTADAS = F_CHUTADAS + L2
      FRANGO TSE2 = 0 + F_SECRETA.length
      FRANGO K2 = 0
      FRANGO AC2 = 0
      NEGATIVA BAMBAM (K2 < TSE2)
        FRANGO SC3 = F_SECRETA.charAt(K2) || ""
        ELE QUE A GENTE QUER? SC3 == L2
          AC2 = 1
        BIRL
        K2 = K2 + 1
      BIRL
      ELE QUE A GENTE QUER? AC2 == 1
        F_CERTAS = F_CERTAS + L2
        AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM USA FREQUENCIA E CHUTA " + L2 + " ... CERTO!")
      NAO VAI DAR NAO
        F_ERRADAS = F_ERRADAS + L2
        F_ERROS = F_ERROS + 1
        AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM USA FREQUENCIA E CHUTA " + L2 + " ... ERROU!")
      BIRL
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE F_ATUALIZA_PADRAO(0)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO F_VENCE(MONSTRO LIXO)
  FRANGO I = 0
  FRANGO TAM = 0 + F_PADRAO.length
  NEGATIVA BAMBAM (I < TAM)
    FRANGO C = F_PADRAO.charAt(I) || "_"
    ELE QUE A GENTE QUER? C == "_"
      BORA CUMPADI 0
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO JOGO_FORCA(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE F_RESET(0)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  FORCA: BAMBAM ADIVINHADOR")
  AJUDA O MALUCO TA DOENTE TEXTO("  VOCE ESCOLHE A PALAVRA SECRETA. O BAMBAM VAI TENTAR ADIVINHAR.")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  FRANGO SECR = AJUDA O MALUCO TA DOENTE PEDE("text", "DIGITA A PALAVRA SECRETA (SO LETRAS):")
  SECR = SECR.toUpperCase() || ""
  FRANGO OKP = 0
  NEGATIVA BAMBAM (OKP == 0)
    FRANGO VP = AJUDA O MALUCO TA DOENTE F_VALIDA_PALAVRA(SECR)
    ELE QUE A GENTE QUER? VP == 1
      OKP = 1
    NAO VAI DAR NAO
      AJUDA O MALUCO TA DOENTE TEXTO("  PALAVRA INVALIDA. USE SOMENTE LETRAS A-Z, DE 2 A 15 CARACTERES.")
      FRANGO SECR = AJUDA O MALUCO TA DOENTE PEDE("text", "DIGITA A PALAVRA SECRETA (SO LETRAS):")
      SECR = SECR.toUpperCase() || ""
    BIRL
  BIRL
  F_SECRETA = SECR + ""
  AJUDA O MALUCO TA DOENTE F_ATUALIZA_PADRAO(0)
  F_CAND_STR = AJUDA O MALUCO TA DOENTE F_FILTRA_STR(F_DIC, F_PADRAO, F_CERTAS, F_ERRADAS) || ""
  AJUDA O MALUCO TA DOENTE DADO("PADRAO " + F_PADRAO)
  AJUDA O MALUCO TA DOENTE DADO("CERTAS " + F_CERTAS)
  AJUDA O MALUCO TA DOENTE DADO("ERRADAS " + F_ERRADAS)
  AJUDA O MALUCO TA DOENTE DADO("ERROS " + F_ERROS)
  AJUDA O MALUCO TA DOENTE DADO("MAX " + F_MAX)
  FRANGO RES = "."
  NEGATIVA BAMBAM (RES == ".")
    FRANGO FE = F_ERROS + 0
    FRANGO LIM = F_MAX + 0
    ELE QUE A GENTE QUER? FE < LIM
      FRANGO V = AJUDA O MALUCO TA DOENTE F_VENCE(0)
      ELE QUE A GENTE QUER? V == 0
        AJUDA O MALUCO TA DOENTE TEXTO("")
        AJUDA O MALUCO TA DOENTE TEXTO("  PALAVRA: " + F_PADRAO)
        AJUDA O MALUCO TA DOENTE TEXTO("  CERTAS: " + F_CERTAS + "   ERRADAS: " + F_ERRADAS)
        AJUDA O MALUCO TA DOENTE TEXTO("  FORCA: " + F_ERROS + "/" + F_MAX)
        AJUDA O MALUCO TA DOENTE DADO("PADRAO " + F_PADRAO)
        AJUDA O MALUCO TA DOENTE DADO("CERTAS " + F_CERTAS)
        AJUDA O MALUCO TA DOENTE DADO("ERRADAS " + F_ERRADAS)
        AJUDA O MALUCO TA DOENTE DADO("ERROS " + F_ERROS)
        AJUDA O MALUCO TA DOENTE DADO("MAX " + F_MAX)
        AJUDA O MALUCO TA DOENTE PEDE("next", "BAMBAM VAI ANALISAR O DICIONARIO E CHUTAR...")
        AJUDA O MALUCO TA DOENTE F_CHUTE_BAMBAM(0)
      NAO VAI DAR NAO
        RES = "BAMBAM_PERDEU"
      BIRL
    NAO VAI DAR NAO
      RES = "BAMBAM_GANHOU"
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  PALAVRA SECRETA: " + F_SECRETA)
  AJUDA O MALUCO TA DOENTE TEXTO("  CHUTES: " + F_CHUTADAS)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  ELE QUE A GENTE QUER? RES == "BAMBAM_PERDEU"
    AJUDA O MALUCO TA DOENTE TEXTO("  O BAMBAM NAO ADIVINHOU! VOCE VENCEU ESSA BATALHA.")
  BIRL
  ELE QUE A GENTE QUER? RES == "BAMBAM_GANHOU"
    AJUDA O MALUCO TA DOENTE TEXTO("  O BAMBAM ADIVINHOU A PALAVRA! ELE TA CHEIO DE PROTEINA.")
  BIRL
  BORA CUMPADI RES
BIRL