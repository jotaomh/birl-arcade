FRANGO V_TAB = "........."
FRANGO V_NIVEL = 3
FRANGO V_NIVEL_NOME = "IMPOSSIVEL"

OH O HOME AI PO MONSTRO V_VENCE(MONSTRO T, MONSTRO S)
  FRANGO ALVO = S + S + S
  FRANGO A = T.charAt(0) + T.charAt(1) + T.charAt(2)
  FRANGO B = T.charAt(3) + T.charAt(4) + T.charAt(5)
  FRANGO C = T.charAt(6) + T.charAt(7) + T.charAt(8)
  FRANGO D = T.charAt(0) + T.charAt(3) + T.charAt(6)
  FRANGO E = T.charAt(1) + T.charAt(4) + T.charAt(7)
  FRANGO F = T.charAt(2) + T.charAt(5) + T.charAt(8)
  FRANGO G = T.charAt(0) + T.charAt(4) + T.charAt(8)
  FRANGO H = T.charAt(2) + T.charAt(4) + T.charAt(6)
  FRANGO R = 0
  ELE QUE A GENTE QUER? A == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? B == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? C == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? D == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? E == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? F == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? G == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? H == ALVO
    R = 1
  BIRL
  BORA CUMPADI R
BIRL

OH O HOME AI PO MONSTRO V_CHEIO(MONSTRO T)
  FRANGO N = 0
  FRANGO I = 0
  NEGATIVA BAMBAM (I < 9)
    FRANGO C = T.charAt(I) || "."
    ELE QUE A GENTE QUER? C != "."
      N = N + 1
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI N
BIRL

OH O HOME AI PO FRANGO V_MARCA(MONSTRO T, MONSTRO POS, MONSTRO S)
  FRANGO PARTES = T.split("") || 0
  PARTES.splice(POS, 1, S)
  FRANGO NOVO = PARTES.join("") || ""
  BORA CUMPADI NOVO
BIRL

OH O HOME AI PO FRANGO V_CASA(MONSTRO T, MONSTRO I)
  FRANGO C = T.charAt(I) || ""
  ELE QUE A GENTE QUER? C == "."
    FRANGO N = "" + I
    BORA CUMPADI N
  BIRL
  BORA CUMPADI C
BIRL

OH O HOME AI PO MONSTRO V_MINIMAX(MONSTRO T, MONSTRO VEZ, MONSTRO PROF, MONSTRO LIM)
  FRANGO WO = AJUDA O MALUCO TA DOENTE V_VENCE(T, "O")
  ELE QUE A GENTE QUER? WO == 1
    FRANGO S1 = 10 - PROF
    BORA CUMPADI S1
  BIRL
  FRANGO WX = AJUDA O MALUCO TA DOENTE V_VENCE(T, "X")
  ELE QUE A GENTE QUER? WX == 1
    FRANGO S2 = PROF - 10
    BORA CUMPADI S2
  BIRL
  FRANGO CH = AJUDA O MALUCO TA DOENTE V_CHEIO(T)
  ELE QUE A GENTE QUER? CH > 8
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? PROF == LIM
    BORA CUMPADI 0
  BIRL
  FRANGO MELHOR = 0
  ELE QUE A GENTE QUER? VEZ == "O"
    MELHOR = 0 - 100
    FRANGO I = 0
    NEGATIVA BAMBAM (I < 9)
      FRANGO C = T.charAt(I) || "."
      ELE QUE A GENTE QUER? C == "."
        FRANGO T2 = AJUDA O MALUCO TA DOENTE V_MARCA(T, I, "O")
        FRANGO P2 = PROF + 1
        FRANGO SC = AJUDA O MALUCO TA DOENTE V_MINIMAX(T2, "X", P2, LIM)
        ELE QUE A GENTE QUER? SC > MELHOR
          MELHOR = SC + 0
        BIRL
      BIRL
      I = I + 1
    BIRL
    BORA CUMPADI MELHOR
  BIRL
  MELHOR = 100
  FRANGO J = 0
  NEGATIVA BAMBAM (J < 9)
    FRANGO C2 = T.charAt(J) || "."
    ELE QUE A GENTE QUER? C2 == "."
      FRANGO T3 = AJUDA O MALUCO TA DOENTE V_MARCA(T, J, "X")
      FRANGO P3 = PROF + 1
      FRANGO SC2 = AJUDA O MALUCO TA DOENTE V_MINIMAX(T3, "O", P3, LIM)
      ELE QUE A GENTE QUER? SC2 < MELHOR
        MELHOR = SC2 + 0
      BIRL
    BIRL
    J = J + 1
  BIRL
  BORA CUMPADI MELHOR
BIRL

OH O HOME AI PO FRANGO V_ESCOLHE_FACIL(MONSTRO T)
  FRANGO POS = 0 - 1
  FRANGO I = 0
  NEGATIVA BAMBAM (I < 9)
    FRANGO C = T.charAt(I) || "."
    ELE QUE A GENTE QUER? C == "."
      ELE QUE A GENTE QUER? POS < 0
        FRANGO T2 = AJUDA O MALUCO TA DOENTE V_MARCA(T, I, "O")
        FRANGO W = AJUDA O MALUCO TA DOENTE V_VENCE(T2, "O")
        ELE QUE A GENTE QUER? W == 1
          POS = I + 0
        BIRL
      BIRL
    BIRL
    I = I + 1
  BIRL
  ELE QUE A GENTE QUER? POS < 0
    FRANGO J = 0
    NEGATIVA BAMBAM (J < 9)
      FRANGO C2 = T.charAt(J) || "."
      ELE QUE A GENTE QUER? C2 == "."
        ELE QUE A GENTE QUER? POS < 0
          POS = J + 0
        BIRL
      BIRL
      J = J + 1
    BIRL
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO FRANGO V_ESCOLHE(MONSTRO T, MONSTRO NIVEL)
  ELE QUE A GENTE QUER? NIVEL == 1
    FRANGO F = AJUDA O MALUCO TA DOENTE V_ESCOLHE_FACIL(T)
    BORA CUMPADI F
  BIRL
  FRANGO LIM = 2
  ELE QUE A GENTE QUER? NIVEL == 3
    LIM = 9
  BIRL
  FRANGO ORDEM = "402681357"
  FRANGO POS = 0 - 1
  FRANGO MELHOR = 0 - 1000
  FRANGO K = 0
  NEGATIVA BAMBAM (K < 9)
    FRANGO CH = ORDEM.charAt(K) || "0"
    FRANGO P = 0 + parseInt(CH, 10)
    FRANGO C = T.charAt(P) || "."
    ELE QUE A GENTE QUER? C == "."
      FRANGO T2 = AJUDA O MALUCO TA DOENTE V_MARCA(T, P, "O")
      FRANGO SC = AJUDA O MALUCO TA DOENTE V_MINIMAX(T2, "X", 1, LIM)
      ELE QUE A GENTE QUER? SC > MELHOR
        MELHOR = SC + 0
        POS = P + 0
      BIRL
    BIRL
    K = K + 1
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO FRANGO V_DESENHA(MONSTRO T)
  FRANGO A = AJUDA O MALUCO TA DOENTE V_CASA(T, 0)
  FRANGO B = AJUDA O MALUCO TA DOENTE V_CASA(T, 1)
  FRANGO C = AJUDA O MALUCO TA DOENTE V_CASA(T, 2)
  FRANGO D = AJUDA O MALUCO TA DOENTE V_CASA(T, 3)
  FRANGO E = AJUDA O MALUCO TA DOENTE V_CASA(T, 4)
  FRANGO F = AJUDA O MALUCO TA DOENTE V_CASA(T, 5)
  FRANGO G = AJUDA O MALUCO TA DOENTE V_CASA(T, 6)
  FRANGO H = AJUDA O MALUCO TA DOENTE V_CASA(T, 7)
  FRANGO I = AJUDA O MALUCO TA DOENTE V_CASA(T, 8)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("      " + A + " | " + B + " | " + C)
  AJUDA O MALUCO TA DOENTE TEXTO("     ---+---+---")
  AJUDA O MALUCO TA DOENTE TEXTO("      " + D + " | " + E + " | " + F)
  AJUDA O MALUCO TA DOENTE TEXTO("     ---+---+---")
  AJUDA O MALUCO TA DOENTE TEXTO("      " + G + " | " + H + " | " + I)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO V_PEDE_CASA(MONSTRO LIXO)
  FRANGO POS = 0
  FRANGO OK = 0
  NEGATIVA BAMBAM (OK == 0)
    FRANGO E = AJUDA O MALUCO TA DOENTE PEDE("cell", "SUA VEZ, MONSTRO. ESCOLHE UMA CASA (0-8):")
    FRANGO N = 0 + E.length
    ELE QUE A GENTE QUER? N == 1
      FRANGO CH = E.charAt(0) || "?"
      ELE QUE A GENTE QUER? CH > "/"
        ELE QUE A GENTE QUER? CH < "9"
          FRANGO P = 0 + parseInt(CH, 10)
          FRANGO D = V_TAB.charAt(P) || "#"
          ELE QUE A GENTE QUER? D == "."
            POS = P + 0
            OK = 1
          NAO VAI DAR NAO
            AJUDA O MALUCO TA DOENTE TEXTO("  ESSA CASA JA TA OCUPADA, FRANGO!")
          BIRL
        NAO VAI DAR NAO
          AJUDA O MALUCO TA DOENTE TEXTO("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
        BIRL
      NAO VAI DAR NAO
        AJUDA O MALUCO TA DOENTE TEXTO("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
      BIRL
    NAO VAI DAR NAO
      AJUDA O MALUCO TA DOENTE TEXTO("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
    BIRL
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO FRANGO V_ESCOLHE_NIVEL(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  DIFICULDADE DO BAMBAM:")
  AJUDA O MALUCO TA DOENTE TEXTO("  1 - FACIL (ELE NAO BLOQUEIA)")
  AJUDA O MALUCO TA DOENTE TEXTO("  2 - MEDIO (OLHA 2 JOGADAS)")
  AJUDA O MALUCO TA DOENTE TEXTO("  3 - IMPOSSIVEL (MINIMAX COMPLETO)")
  AJUDA O MALUCO TA DOENTE DADO("OPCOES 1=FACIL|2=MEDIO|3=IMPOSSIVEL")
  FRANGO OK = 0
  FRANGO N = 3
  NEGATIVA BAMBAM (OK == 0)
    FRANGO R = AJUDA O MALUCO TA DOENTE PEDE("choice", "ESCOLHE A DIFICULDADE (1-3):")
    ELE QUE A GENTE QUER? R == "1"
      N = 1
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? R == "2"
      N = 2
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? R == "3"
      N = 3
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? OK == 0
      AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHE 1, 2 OU 3, MONSTRO!")
    BIRL
  BIRL
  V_NIVEL = N + 0
  ELE QUE A GENTE QUER? N == 1
    V_NIVEL_NOME = "FACIL"
  BIRL
  ELE QUE A GENTE QUER? N == 2
    V_NIVEL_NOME = "MEDIO"
  BIRL
  ELE QUE A GENTE QUER? N == 3
    V_NIVEL_NOME = "IMPOSSIVEL"
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_VELHA(MONSTRO LIXO)
  V_TAB = "........."
  V_NIVEL = 3
  V_NIVEL_NOME = "IMPOSSIVEL"
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  JOGO DA VELHA VS BAMBAM")
  AJUDA O MALUCO TA DOENTE TEXTO("  VOCE E O X. BAMBAM E O O.")
  AJUDA O MALUCO TA DOENTE V_ESCOLHE_NIVEL(0)
  AJUDA O MALUCO TA DOENTE DADO("NIVEL " + V_NIVEL_NOME)
  FRANGO JOGADAS = 0
  FRANGO VEZ = "X"
  FRANGO RESULTADO = "."
  FRANGO T_MSG_BAM = ""
  NEGATIVA BAMBAM (RESULTADO == ".")
    ELE QUE A GENTE QUER? JOGADAS < 9
      ELE QUE A GENTE QUER? MODO_GUI == 0
        AJUDA O MALUCO TA DOENTE LIMPA(0)
        AJUDA O MALUCO TA DOENTE CABECALHO(0)
        AJUDA O MALUCO TA DOENTE TEXTO("")
        AJUDA O MALUCO TA DOENTE TEXTO("  JOGO DA VELHA VS BAMBAM    JOGADA: " + JOGADAS)
        AJUDA O MALUCO TA DOENTE TEXTO("  DIFICULDADE: " + V_NIVEL_NOME)
        ELE QUE A GENTE QUER? T_MSG_BAM != ""
          AJUDA O MALUCO TA DOENTE TEXTO(T_MSG_BAM)
          FRANGO T_MSG_BAM = ""
        BIRL
        AJUDA O MALUCO TA DOENTE V_DESENHA(V_TAB)
      BIRL
      AJUDA O MALUCO TA DOENTE DADO("TABULEIRO " + V_TAB)
      AJUDA O MALUCO TA DOENTE DADO("VEZ " + VEZ)
      ELE QUE A GENTE QUER? VEZ == "X"
        FRANGO POSX = AJUDA O MALUCO TA DOENTE V_PEDE_CASA(0)
        V_TAB = AJUDA O MALUCO TA DOENTE V_MARCA(V_TAB, POSX, "X")
      NAO VAI DAR NAO
        AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM TA PENSANDO... ELE PENSA COM O BICEPS.")
        FRANGO POSO = AJUDA O MALUCO TA DOENTE V_ESCOLHE(V_TAB, V_NIVEL)
        V_TAB = AJUDA O MALUCO TA DOENTE V_MARCA(V_TAB, POSO, "O")
        T_MSG_BAM = "  BAMBAM JOGA NA CASA " + POSO
      BIRL
      JOGADAS = JOGADAS + 1
      FRANGO VX = AJUDA O MALUCO TA DOENTE V_VENCE(V_TAB, "X")
      FRANGO VO = AJUDA O MALUCO TA DOENTE V_VENCE(V_TAB, "O")
      ELE QUE A GENTE QUER? VX == 1
        RESULTADO = "VOCE"
      BIRL
      ELE QUE A GENTE QUER? VO == 1
        RESULTADO = "BAMBAM"
      BIRL
      ELE QUE A GENTE QUER? VEZ == "X"
        VEZ = "O"
      NAO VAI DAR NAO
        VEZ = "X"
      BIRL
    NAO VAI DAR NAO
      RESULTADO = "EMPATE"
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE DADO("TABULEIRO " + V_TAB)
  ELE QUE A GENTE QUER? MODO_GUI == 0
    AJUDA O MALUCO TA DOENTE LIMPA(0)
    AJUDA O MALUCO TA DOENTE CABECALHO(0)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE V_DESENHA(V_TAB)
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "VOCE"
    AJUDA O MALUCO TA DOENTE TEXTO("  BIRL! VOCE AMASSOLOU O BAMBAM NO JOGO DA VELHA!")
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "BAMBAM"
    AJUDA O MALUCO TA DOENTE TEXTO("  O BAMBAM TE AMASSOLOU. VAI TREINAR MAIS, FRANGO!")
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "EMPATE"
    AJUDA O MALUCO TA DOENTE TEXTO("  EMPATE! NINGUEM MURCHOU NESSA.")
  BIRL
  BORA CUMPADI RESULTADO
BIRL
