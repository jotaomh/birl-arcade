    D_HP = 50
    D_ATK = 4
    D_DEF = 3
    D_PUMP = 20
    D_PUMP_MAX = 20
  BIRL
  ELE QUE A GENTE QUER? NM == "toguro"
    D_PERSONAGEM = "toguro"
    D_NOME = "TOGURO"
    D_HP_MAX = 46
    D_HP = 46
    D_ATK = 5
    D_DEF = 3
    D_PUMP = 20
    D_PUMP_MAX = 20
  BIRL
  ELE QUE A GENTE QUER? NM == "felipe"
    D_PERSONAGEM = "felipe"
    D_NOME = "FELIPE"
    D_HP_MAX = 45
    D_HP = 45
    D_ATK = 3
    D_DEF = 4
    D_PUMP = 25
    D_PUMP_MAX = 25
  BIRL
  BORA CUMPADI 0
