OH O HOME AI PO FRANGO D_INIM_CADASTRAR(MONSTRO ID)
  T_I = ID + ""
  ELE QUE A GENTE QUER? T_I == "frango_mutante"
    D_INIM_ID = "frango_mutante"
    D_INIM_NOME = "FRANGO MUTANTE"
    D_INIM_HP = 20
    D_INIM_HP_MAX = 20
    D_INIM_DEF = 1
    D_INIM_DADO = 6
    D_INIM_XP = 15
    D_INIM_LOOT = 5
    D_INIM_FALA = "Cocorico! Vou te bicar!"
  BIRL
  ELE QUE A GENTE QUER? T_I == "personal_chato"
    D_INIM_ID = "personal_chato"
    D_INIM_NOME = "PERSONAL CHATO"
    D_INIM_HP = 35
    D_INIM_HP_MAX = 35
    D_INIM_DEF = 2
    D_INIM_DADO = 8
    D_INIM_XP = 30
    D_INIM_LOOT = 10
    D_INIM_FALA = "Mais uma serie, frango! Vamos lah!"
