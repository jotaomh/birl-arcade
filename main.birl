  ELE QUE A GENTE QUER? T_I == "dono_academia"
    D_INIM_ID = "dono_academia"
    D_INIM_NOME = "DONO DA ACADEMIA (CHEFE)"
    D_INIM_HP = 80
    D_INIM_HP_MAX = 80
    D_INIM_DEF = 4
    D_INIM_DADO = 10
    D_INIM_XP = 100
    D_INIM_LOOT = 50
