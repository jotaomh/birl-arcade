  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_DANO_ARMA(MONSTRO LIXO)
  T_R3 = AJUDA O MALUCO TA DOENTE D_DADO(8)
  BORA CUMPADI T_R3
BIRL

OH O HOME AI PO FRANGO D_ROLAGEM_DADO(MONSTRO MOD)
  T_R3 = AJUDA O MALUCO TA DOENTE D_DADO(20)
  T_MOD2 = MOD + 0
  T_TOTAL = T_R3 + T_MOD2
  T_CRIT = 0
  T_FALHA = 0
  ELE QUE A GENTE QUER? T_R3 == 20
    T_CRIT = 1
  BIRL
  ELE QUE A GENTE QUER? T_R3 == 1
    T_FALHA = 1
  BIRL
  D_COMBATE_DANO = T_TOTAL + 0
  D_COMBATE_CRITICO = T_CRIT + 0
  D_COMBATE_FALHA = T_FALHA + 0
  BORA CUMPADI T_TOTAL
BIRL

OH O HOME AI PO FRANGO D_COMBATE_INICIAR(MONSTRO INIM)
  AJUDA O MALUCO TA DOENTE D_INIM_CADASTRAR(INIM)
  D_COMBATE_ATIVO = 1
  D_COMBATE_RESULTADO = 0
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ===== COMBATE =====")
  AJUDA O MALUCO TA DOENTE TEXTO("  INIMIGO: " + D_INIM_NOME)
  AJUDA O MALUCO TA DOENTE TEXTO("  HP INIMIGO: " + D_INIM_HP + " / " + D_INIM_HP_MAX)
  AJUDA O MALUCO TA DOENTE TEXTO("  SUA HP: " + D_HP + " / " + D_HP_MAX)
  AJUDA O MALUCO TA DOENTE TEXTO("  SUA PUMP: " + D_PUMP + " / " + D_PUMP_MAX)
  FRANGO LF = "DIALOGO " + D_INIM_NOME + "|" + D_INIM_FALA
  AJUDA O MALUCO TA DOENTE ESCREVE(LF)
  FRANGO LS = "SOM hora_do_show"
  AJUDA O MALUCO TA DOENTE ESCREVE(LS)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_COMBATE_JOGADOR_ATACA(MONSTRO LIXO)
  T_TOT = AJUDA O MALUCO TA DOENTE D_ROLAGEM_DADO(D_ATK)
  T_DEF = D_INIM_DEF + 0
  T_CRIT_V = D_COMBATE_CRITICO + 0
  T_FALHA_V = D_COMBATE_FALHA + 0
  T_DANO = AJUDA O MALUCO TA DOENTE D_DANO_ARMA(0)
  T_DANO_F = T_DANO + 0
  ELE QUE A GENTE QUER? T_FALHA_V == 1
    T_MSG = "  FALHA CRITICA! VOCE ESCORREGOU NO SUCO DE FRANGO!"
    FRANGO LE = "SOM erro"
    AJUDA O MALUCO TA DOENTE ESCREVE(LE)
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CRIT_V == 1
    T_DANO = T_DANO * 2
    T_MSG = "  CRITICO! BIRL! DOBROU O DANO!"
    FRANGO LB = "SOM birl"
    AJUDA O MALUCO TA DOENTE ESCREVE(LB)
  BIRL
  ELE QUE A GENTE QUER? T_DANO_F < 1
    T_DANO_F = 1
  BIRL
  ELE QUE A GENTE QUER? T_TOT > T_DEF
    D_INIM_HP = D_INIM_HP - T_DANO_F
  BIRL
  ELE QUE A GENTE QUER? T_TOT < T_DEF
    T_MSG = "  VOCE ERROU. O INIMIGO BLOQUEOU."
    FRANGO LE2 = "SOM erro"
    AJUDA O MALUCO TA DOENTE ESCREVE(LE2)
  BIRL
  ELE QUE A GENTE QUER? T_TOT == T_DEF
    T_MSG = "  VOCE ATACOU, MAS O INIMIGO BLOQUEIOU."
  BIRL
  ELE QUE A GENTE QUER? T_TOT > T_DEF
    T_MSG = "  VOCE ACERTOU! -" + T_DANO_F + " HP"
    FRANGO LA = "SOM acerto"
    AJUDA O MALUCO TA DOENTE ESCREVE(LA)
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO(T_MSG)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_COMBATE_INIMIGO_ATACA(MONSTRO LIXO)
  T_TOT = AJUDA O MALUCO TA DOENTE D_ROLAGEM_DADO(D_INIM_DADO)
  T_DEF = D_DEF + 0
  T_DANO = AJUDA O MALUCO TA DOENTE D_DANO_ARMA(0)
  T_MSG = ""
  ELE QUE A GENTE QUER? T_TOT > T_DEF
    D_HP = D_HP - T_DANO
    T_MSG = "  O INIMIGO TE ACERTOU! -" + T_DANO + " HP"
    FRANGO LIA = "SOM acerto"
    AJUDA O MALUCO TA DOENTE ESCREVE(LIA)
  BIRL
  ELE QUE A GENTE QUER? T_TOT < T_DEF
    T_MSG = "  O INIMIGO ERROU. VOCE BLOQUEOU."
    FRANGO LIE = "SOM erro"
    AJUDA O MALUCO TA DOENTE ESCREVE(LIE)
  BIRL
  ELE QUE A GENTE QUER? T_TOT == T_DEF
    T_MSG = "  O INIMIGO ATACOU, MAS VOCÊ BLOQUEIOU."
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO(T_MSG)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_COMBATE_JOGADOR_HAB(MONSTRO HAB)
  ELE QUE A GENTE QUER? HAB == "birl"
    D_PUMP = D_PUMP - 10
    T_DANO = 6 + D_ATK
    D_INIM_HP = D_INIM_HP - T_DANO
    AJUDA O MALUCO TA DOENTE TEXTO("  BIRL! GOLPE FORTE! -" + T_DANO + " HP NO INIMIGO.")
    FRANGO LB2 = "SOM birl"
    AJUDA O MALUCO TA DOENTE ESCREVE(LB2)
  BIRL
  ELE QUE A GENTE QUER? HAB == "ajuda"
    D_PUMP = D_PUMP - 5
    D_HP = D_HP + 15
    AJUDA O MALUCO TA DOENTE TEXTO("  AJUDA O MALUCO TA DOENTE! CURA 15 HP.")
    FRANGO LH = "SOM ajuda_o_maluco"
    AJUDA O MALUCO TA DOENTE ESCREVE(LH)
  BIRL
  ELE QUE A GENTE QUER? HAB == "hora"
    D_PUMP = D_PUMP - 15
    D_ATK = D_ATK + 2
    AJUDA O MALUCO TA DOENTE TEXTO("  HORA DO SHOW! ATAQUE +2.")
    FRANGO LH2 = "SOM hora_do_show"
    AJUDA O MALUCO TA DOENTE ESCREVE(LH2)
  BIRL
  ELE QUE A GENTE QUER? HAB == "motivacao"
    D_PUMP = D_PUMP - 8
    D_HP = D_HP + 10
    D_ATK = D_ATK + 1
    AJUDA O MALUCO TA DOENTE TEXTO("  MOTIVACAO! +10 HP E +1 ATAQUE.")
  BIRL
  ELE QUE A GENTE QUER? HAB == "ficha"
    D_PUMP = D_PUMP - 10
    AJUDA O MALUCO TA DOENTE TEXTO("  FICHA DE TREINO! INIMIGO FICA FRACO.")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_COMBATE_JOGADOR_ITEM(MONSTRO LIXO)
  ELE QUE A GENTE QUER? 1 == 1
    D_HP = D_HP + 10
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  WHEY NA VEIA! +10 HP.")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_COMBATE_JOGADOR_FUGIR(MONSTRO LIXO)
  ELE QUE A GENTE QUER? D_COMBATE_RESULTADO == 0
    T_TOT2 = AJUDA O MALUCO TA DOENTE D_ROLAGEM_DADO(2)
    T_TESTE2 = T_TOT2 + 0
    D_COMBATE_RESULTADO = 0
  BIRL
  ELE QUE A GENTE QUER? T_TESTE2 > 10
    D_COMBATE_RESULTADO = 3
    AJUDA O MALUCO TA DOENTE TEXTO("  FUGIU COM SUCESSO! VALEU, MONSTRO!")
  BIRL
  ELE QUE A GENTE QUER? T_TESTE2 < 10
    AJUDA O MALUCO TA DOENTE TEXTO("  NAO CONSEGUIU FUGIR. O INIMIGO TE PEGOU.")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_ESTADO(MONSTRO LIXO)
  T_HS = "nome=" + D_NOME + " hp=" + D_HP + " hpmax=" + D_HP_MAX + " atk=" + D_ATK + " def=" + D_DEF + " pump=" + D_PUMP + " pumpmax=" + D_PUMP_MAX + " fase=" + D_FASE + " x=" + D_HX + " y=" + D_HY
  AJUDA O MALUCO TA DOENTE DADO("HEROI " + T_HS)
  AJUDA O MALUCO TA DOENTE DADO("MAPA " + D_GRID)
  AJUDA O MALUCO TA DOENTE DADO("INIM hp=" + D_INIM_HP + " hpmax=" + D_INIM_HP_MAX + " def=" + D_INIM_DEF + " dado=" + D_INIM_DADO)
  AJUDA O MALUCO TA DOENTE DADO("OPCOES W=NORTE|A=OESTE|S=SUL|D=LESTE|Q=SAIR|1=ATACAR|2=HABILIDADE|3=ITEM|4=FUGIR")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_DESENHA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 0
    AJUDA O MALUCO TA DOENTE LIMPA(0)
    AJUDA O MALUCO TA DOENTE CABECALHO(0)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  DUNGEON DA ACADEMIA RPG - FASE " + D_FASE + "/3")
    AJUDA O MALUCO TA DOENTE TEXTO("  " + D_NOME + " | HP: " + D_HP + "/" + D_HP_MAX + " | ATK: " + D_ATK + " | DEF: " + D_DEF + " | PUMP: " + D_PUMP + "/" + D_PUMP_MAX)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    T_I = 0
    NEGATIVA BAMBAM (T_I < 10)
      T_B = T_I * 10
      T_E = T_B + 10
      T_L = D_GRID.substring(T_B, T_E) || ""
      T_LC = T_L + ""
      AJUDA O MALUCO TA DOENTE TEXTO("  " + T_L)
      T_I = T_I + 1
    BIRL
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  @ VOCE   F INIMIGO   E SAIDA   W WHEY(+ATK)   C COMIDA(+HP)")
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  1=ATACAR  2=HABILIDADE  3=ITEM  4=FUGIR")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_INIMIGOS_AGEM(MONSTRO LIXO)
  T_POSSTR = ""
  T_K = 0
  NEGATIVA BAMBAM (T_K < 100)
    T_CH = D_GRID.charAt(T_K) || ""
    T_CHC = T_CH + ""
    ELE QUE A GENTE QUER? T_CHC == "F"
      T_POSSTR = T_POSSTR + T_K + "|"
    BIRL
    T_K = T_K + 1
  BIRL
  T_ARR = T_POSSTR.split("|") || 0
  T_AN = 0 + T_ARR.length
  NEGATIVA BAMBAM (T_AN > 0)
    T_TOK = T_ARR.shift() || ""
    T_TOKC = T_TOK + ""
    T_TL = 0 + T_TOKC.length
    ELE QUE A GENTE QUER? T_TL > 0
      T_EP = 0 + parseInt(T_TOKC, 10)
      T_ECH = D_GRID.charAt(T_EP) || "."
      T_ECHC = T_ECH + ""
      ELE QUE A GENTE QUER? T_ECHC == "F"
        T_HBASE = D_HY * 10
        T_HPOS = T_HBASE + D_HX
        T_DIST = AJUDA O MALUCO TA DOENTE D_MAN(T_EP, T_HPOS)
        ELE QUE A GENTE QUER? T_DIST == 1
          T_DANO = 1 + D_FASE
          D_HP = D_HP - T_DANO
          AJUDA O MALUCO TA DOENTE TEXTO("  UM INIMIGO TE ACERTOU! -" + T_DANO + " HP")
        NAO VAI DAR NAO
          T_PASSO = AJUDA O MALUCO TA DOENTE D_PASSO(D_GRID, T_EP, T_HPOS)
          T_PASSC = T_PASSO + ""
          T_PL = 0 + T_PASSC.length
          ELE QUE A GENTE QUER? T_PL > 0
            T_NP = T_EP + 0
            ELE QUE A GENTE QUER? T_PASSC == "W"
              T_NP = T_EP - 10
            BIRL
            ELE QUE A GENTE QUER? T_PASSC == "S"
              T_NP = T_EP + 10
            BIRL
            ELE QUE A GENTE QUER? T_PASSC == "A"
              T_NP = T_EP - 1
            BIRL
            ELE QUE A GENTE QUER? T_PASSC == "D"
              T_NP = T_EP + 1
            BIRL
            T_NCH = D_GRID.charAt(T_NP) || "#"
            T_NCHC = T_NCH + ""
            ELE QUE A GENTE QUER? T_NCHC == "."
              T_DIG = D_HITS.charAt(T_EP) || "0"
              T_DIGC = T_DIG + ""
              D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_EP, ".")
              D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_NP, "F")
              D_HITS = AJUDA O MALUCO TA DOENTE D_SET1(D_HITS, T_NP, T_DIGC)
              D_HITS = AJUDA O MALUCO TA DOENTE D_SET1(D_HITS, T_EP, "0")
            BIRL
          BIRL
        BIRL
      BIRL
    BIRL
    T_AN = T_AN - 1
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_AGE(MONSTRO OP)
  T_OPC = OP + ""
  T_TX = D_HX + 0
  T_TY = D_HY + 0
  T_DIR = ""
  ELE QUE A GENTE QUER? T_OPC == "w"
    T_TY = T_TY - 1
    T_DIR = "W"
  BIRL
  ELE QUE A GENTE QUER? T_OPC == "s"
    T_TY = T_TY + 1
    T_DIR = "S"
  BIRL
  ELE QUE A GENTE QUER? T_OPC == "a"
    T_TX = T_TX - 1
    T_DIR = "A"
  BIRL
  ELE QUE A GENTE QUER? T_OPC == "d"
    T_TX = T_TX + 1
    T_DIR = "D"
  BIRL
  ELE QUE A GENTE QUER? T_DIR == ""
    AJUDA O MALUCO TA DOENTE TEXTO("  COMANDO INVALIDO. USA W, A, S OU D.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TX < 0
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TX > 9
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TY < 0
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_TY > 9
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE.")
    BORA CUMPADI 0
  BIRL
  T_TBASE = T_TY * 10
  T_ALVO = T_TBASE + T_TX
  T_HBASE = D_HY * 10
  T_HPOS = T_HBASE + D_HX
  T_C = D_GRID.charAt(T_ALVO) || "#"
  T_CC = T_C + ""
  ELE QUE A GENTE QUER? T_CC == "#"
    AJUDA O MALUCO TA DOENTE TEXTO("  PAREDE. O MONSTRO NAO ATRAVESSA CONCRETO.")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "F"
    T_INIM_ID = ""
    ELE QUE A GENTE QUER? D_FASE == 1
      T_INIM_ID = "frango_mutante"
    BIRL
    ELE QUE A GENTE QUER? D_FASE == 2
      T_INIM_ID = "personal_chato"
    BIRL
    ELE QUE A GENTE QUER? D_FASE == 3
      T_INIM_ID = "dono_academia"
    BIRL
    AJUDA O MALUCO TA DOENTE D_COMBATE_INICIAR(T_INIM_ID)
    T_SAIR_COMB = 0
    NEGATIVA BAMBAM (T_SAIR_COMB == 0)
      AJUDA O MALUCO TA DOENTE TEXTO("")
      AJUDA O MALUCO TA DOENTE TEXTO("  SUA HP: " + D_HP + " / " + D_HP_MAX + "  PUMP: " + D_PUMP + " / " + D_PUMP_MAX)
      AJUDA O MALUCO TA DOENTE TEXTO("  INIMIGO HP: " + D_INIM_HP + " / " + D_INIM_HP_MAX)
      AJUDA O MALUCO TA DOENTE TEXTO("")
      AJUDA O MALUCO TA DOENTE TEXTO("  1 - ATACAR")
      AJUDA O MALUCO TA DOENTE TEXTO("  2 - HABILIDADE")
      AJUDA O MALUCO TA DOENTE TEXTO("  3 - ITEM")
      AJUDA O MALUCO TA DOENTE TEXTO("  4 - FUGIR")
      AJUDA O MALUCO TA DOENTE DADO("OPCOES 1=ATACAR|2=HABILIDADE|3=ITEM|4=FUGIR")
      T_ACOP = AJUDA O MALUCO TA DOENTE PEDE("choice", "SUA ACAO:")
      ELE QUE A GENTE QUER? T_ACOP == "1"
        AJUDA O MALUCO TA DOENTE D_COMBATE_JOGADOR_ATACA(0)
        ELE QUE A GENTE QUER? D_INIM_HP < 1
          AJUDA O MALUCO TA DOENTE TEXTO("  INIMIGO DERROTADO!")
          D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, ".")
          T_SAIR_COMB = 1
        BIRL
        ELE QUE A GENTE QUER? T_SAIR_COMB == 0
          AJUDA O MALUCO TA DOENTE D_COMBATE_INIMIGO_ATACA(0)
          ELE QUE A GENTE QUER? D_HP < 1
            T_SAIR_COMB = 1
            D_FIM = 2
          BIRL
        BIRL
      BIRL
      ELE QUE A GENTE QUER? T_ACOP == "2"
        AJUDA O MALUCO TA DOENTE TEXTO("  HABILIDADES: 1=BIRL 2=AJUDA 3=HORA 4=MOTIVACAO 5=FICHA")
        T_HAB = AJUDA O MALUCO TA DOENTE PEDE("text", "ESCOLHA HABILIDADE:")
        ELE QUE A GENTE QUER? T_HAB == "1"
          AJUDA O MALUCO TA DOENTE D_COMBATE_JOGADOR_HAB("birl")
        BIRL
        ELE QUE A GENTE QUER? T_HAB == "2"
          AJUDA O MALUCO TA DOENTE D_COMBATE_JOGADOR_HAB("ajuda")
        BIRL
        ELE QUE A GENTE QUER? T_HAB == "3"
          AJUDA O MALUCO TA DOENTE D_COMBATE_JOGADOR_HAB("hora")
        BIRL
        ELE QUE A GENTE QUER? T_HAB == "4"
          AJUDA O MALUCO TA DOENTE D_COMBATE_JOGADOR_HAB("motivacao")
        BIRL
        ELE QUE A GENTE QUER? T_HAB == "5"
          AJUDA O MALUCO TA DOENTE D_COMBATE_JOGADOR_HAB("ficha")
        BIRL
        ELE QUE A GENTE QUER? D_INIM_HP < 1
          AJUDA O MALUCO TA DOENTE TEXTO("  INIMIGO DERROTADO!")
          D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, ".")
          T_SAIR_COMB = 1
        BIRL
        ELE QUE A GENTE QUER? T_SAIR_COMB == 0
          AJUDA O MALUCO TA DOENTE D_COMBATE_INIMIGO_ATACA(0)
          ELE QUE A GENTE QUER? D_HP < 1
            T_SAIR_COMB = 1
            D_FIM = 2
          BIRL
        BIRL
      BIRL
      ELE QUE A GENTE QUER? T_ACOP == "3"
        AJUDA O MALUCO TA DOENTE TEXTO("  ITEM: WHEY +10 HP.")
        D_HP = D_HP + 10
        AJUDA O MALUCO TA DOENTE D_COMBATE_INIMIGO_ATACA(0)
        ELE QUE A GENTE QUER? D_HP < 1
          T_SAIR_COMB = 1
          D_FIM = 2
        BIRL
      BIRL
      ELE QUE A GENTE QUER? T_ACOP == "4"
        AJUDA O MALUCO TA DOENTE TEXTO("  FUGIU.")
        T_SAIR_COMB = 1
      BIRL
    BIRL
    D_COMBATE_ATIVO = 0
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? T_CC == "E"
    T_INIM = AJUDA O MALUCO TA DOENTE D_CONT(D_GRID, "F")
    ELE QUE A GENTE QUER? T_INIM > 0
      AJUDA O MALUCO TA DOENTE TEXTO("  SAIDA TRANCADA. MATE TODOS PRIMEIRO.")
      BORA CUMPADI 0
    BIRL
    T_FF = D_FASE + 0
    ELE QUE A GENTE QUER? T_FF > 2
      D_FIM = 1
      AJUDA O MALUCO TA DOENTE TEXTO("  VOCE ZEROU A DUNGEON! BIRL!")
      BORA CUMPADI 0
    BIRL
    T_PROX = T_FF + 1
    AJUDA O MALUCO TA DOENTE D_LOAD(T_PROX)
    D_HP = D_HP + 10
    ELE QUE A GENTE QUER? D_HP > 99
      D_HP = 99
    BIRL
    AJUDA O MALUCO TA DOENTE TEXTO("  FASE " + T_PROX + " LIBERADA!")
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? T_CC == "W"
    D_ATK = D_ATK + 2
    ELE QUE A GENTE QUER? D_ATK > 9
      D_ATK = 9
    BIRL
    D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, ".")
    AJUDA O MALUCO TA DOENTE TEXTO("  WHEY +2 ATK.")
  BIRL
  ELE QUE A GENTE QUER? T_CC == "C"
    D_HP = D_HP + 8
    ELE QUE A GENTE QUER? D_HP > 99
      D_HP = 99
    BIRL
    D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, ".")
    AJUDA O MALUCO TA DOENTE TEXTO("  FRANGO +8 HP.")
  BIRL
  D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_HPOS, ".")
  D_GRID = AJUDA O MALUCO TA DOENTE D_SET1(D_GRID, T_ALVO, "@")
  D_HX = T_TX + 0
  D_HY = T_TY + 0
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO D_SELECIONA_PERSONAGEM(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHA SEU PERSONAGEM")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  1 - BAMBAM (Tank)")
  AJUDA O MALUCO TA DOENTE TEXTO("  2 - TOGURO (Porcentagem 20/50/80/100)")
  AJUDA O MALUCO TA DOENTE TEXTO("  3 - FELIPE (Suporte)")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHA (1-3):")
  T_ESC = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
  T_ESCOLHEU = 0
  ELE QUE A GENTE QUER? T_ESC == "1"
    AJUDA O MALUCO TA DOENTE D_PERSONAGEM_INIT("bambam")
    T_ESCOLHEU = 1
  BIRL
  ELE QUE A GENTE QUER? T_ESC == "2"
    AJUDA O MALUCO TA DOENTE D_PERSONAGEM_INIT("toguro")
    T_ESCOLHEU = 1
  BIRL
  ELE QUE A GENTE QUER? T_ESC == "3"
    AJUDA O MALUCO TA DOENTE D_PERSONAGEM_INIT("felipe")
    T_ESCOLHEU = 1
  BIRL
  ELE QUE A GENTE QUER? T_ESCOLHEU == 0
    AJUDA O MALUCO TA DOENTE D_PERSONAGEM_INIT("bambam")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_DUNGEON(MONSTRO LIXO)
  D_GRID = ""
  D_HITS = ""
  D_HP = 40
  D_ATK = 4
  D_DEF = 3
  D_FASE = 1
  D_FIM = 0
  D_PUMP = 20
  D_PUMP_MAX = 20
  D_COMBATE_ATIVO = 0
  D_SD = 12345
  D_RND = 0
  AJUDA O MALUCO TA DOENTE D_SELECIONA_PERSONAGEM(0)
  AJUDA O MALUCO TA DOENTE D_LOAD(1)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  DUNGEON DA ACADEMIA RPG")
  AJUDA O MALUCO TA DOENTE TEXTO("  COMBATE POR TURNOS COM DADOS (D20).")
  AJUDA O MALUCO TA DOENTE TEXTO("  MATE TODOS E CHEGUE NA SAIDA 'E'.")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  T_SAIR = 0
  NEGATIVA BAMBAM (T_SAIR == 0)
    AJUDA O MALUCO TA DOENTE D_ESTADO(0)
    AJUDA O MALUCO TA DOENTE D_DESENHA(0)
    T_OP = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    T_OPL = T_OP.toLowerCase() || ""
    T_OPC = T_OPL + ""
    ELE QUE A GENTE QUER? T_OPC == "q"
      T_SAIR = 1
    BIRL
    ELE QUE A GENTE QUER? T_SAIR == 0
      T_AGIU = AJUDA O MALUCO TA DOENTE D_AGE(T_OPC)
      T_AG = T_AGIU + 0
      ELE QUE A GENTE QUER? T_AG == 1
        AJUDA O MALUCO TA DOENTE D_INIMIGOS_AGEM(0)
      BIRL
      ELE QUE A GENTE QUER? D_HP < 1
        T_SAIR = 1
        D_FIM = 2
      BIRL
      ELE QUE A GENTE QUER? D_FIM == 1
        T_SAIR = 1
      BIRL
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE D_ESTADO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  ELE QUE A GENTE QUER? D_FIM == 1
    FRANGO LV = "SOM vitoria"
