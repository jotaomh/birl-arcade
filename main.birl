HORA DO SHOW

FRANGO FS = AJUDA O MALUCO TA DOENTE require("fs")
FRANGO ENV = process.env || 0
FRANGO MODO_NOME = ENV.BIRL_MODE || "terminal"
FRANGO MODO_GUI = 0
FRANGO JOGO_GUI = ENV.BIRL_GAME || "menu"
FRANGO TEMPO_GUI = ENV.BIRL_TEMPO || "0"

ELE QUE A GENTE QUER? MODO_NOME == "gui"
  MODO_GUI = 1
BIRL

OH O HOME AI PO FRANGO ESCREVE(MONSTRO T)
  FRANGO L = T + "\n"
  FS.writeSync(1, L)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO LE_LINHA(MONSTRO LIXO)
  FRANGO BUF = Buffer.alloc(1) || 0
  FRANGO TEXTO = ""
  FRANGO FIM = 0
  NEGATIVA BAMBAM (FIM == 0)
    FRANGO N = FS.readSync(0, BUF, 0, 1) || 0
    FRANGO C = BUF.toString("utf8") || ""
    ELE QUE A GENTE QUER? N == 0
      ELE QUE A GENTE QUER? MODO_GUI == 1
        AJUDA O MALUCO TA DOENTE ESCREVE("END EOF")
      NAO VAI DAR NAO
        AJUDA O MALUCO TA DOENTE ESCREVE("")
        AJUDA O MALUCO TA DOENTE ESCREVE("  ACABOU A ENTRADA. VALEU, MONSTRO!")
      BIRL
      process.exit(0)
    BIRL
    ELE QUE A GENTE QUER? C == "\n"
      FIM = 2
    BIRL
    ELE QUE A GENTE QUER? C == "\r"
      FIM = FIM + 0
    BIRL
    ELE QUE A GENTE QUER? FIM == 0
      TEXTO = TEXTO + C
    BIRL
  BIRL
  BORA CUMPADI TEXTO
BIRL

OH O HOME AI PO FRANGO LIMPA_INPUT(MONSTRO S)
  FRANGO P = S.substring(0, 6) || ""
  ELE QUE A GENTE QUER? P == "INPUT "
    FRANGO V = S.substring(6) || ""
    BORA CUMPADI V
  BIRL
  ELE QUE A GENTE QUER? S == "QUIT"
    process.exit(0)
  BIRL
  BORA CUMPADI S
BIRL

OH O HOME AI PO FRANGO TEXTO(MONSTRO T)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    FRANGO L = "TEXT " + T
    AJUDA O MALUCO TA DOENTE ESCREVE(L)
  NAO VAI DAR NAO
    AJUDA O MALUCO TA DOENTE ESCREVE(T)
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO DADO(MONSTRO T)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    FRANGO L = "DATA " + T
    AJUDA O MALUCO TA DOENTE ESCREVE(L)
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO PEDE(MONSTRO TIPO, MONSTRO DICA)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    FRANGO L = "PROMPT " + TIPO + " " + DICA
    AJUDA O MALUCO TA DOENTE ESCREVE(L)
    FRANGO R = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    FRANGO V = AJUDA O MALUCO TA DOENTE LIMPA_INPUT(R)
    BORA CUMPADI V
  BIRL
  AJUDA O MALUCO TA DOENTE ESCREVE("")
  AJUDA O MALUCO TA DOENTE ESCREVE("  " + DICA)
  FRANGO R2 = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
  BORA CUMPADI R2
BIRL

OH O HOME AI PO FRANGO LIMPA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 0
    console.clear()
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO CABECALHO(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ##########################################")
  AJUDA O MALUCO TA DOENTE TEXTO("  #                                        #")
  AJUDA O MALUCO TA DOENTE TEXTO("  #           B I R L   A R C A D E        #")
  AJUDA O MALUCO TA DOENTE TEXTO("  #      AQUI NAO TEM AGUA COM MUSCULO     #")
  AJUDA O MALUCO TA DOENTE TEXTO("  #                                        #")
  AJUDA O MALUCO TA DOENTE TEXTO("  ##########################################")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO PAUSA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    BORA CUMPADI 0
  BIRL
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR, MONSTRO...")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO MENU(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  1 - JOGO DA VELHA VS BAMBAM (MINIMAX)")
  AJUDA O MALUCO TA DOENTE TEXTO("  2 - FORCA: BAMBAM ADIVINHADOR")
  AJUDA O MALUCO TA DOENTE TEXTO("  3 - SIMULADOR DE ACADEMIA")
  AJUDA O MALUCO TA DOENTE TEXTO("  4 - TAMAGOTCHI DO MONSTRO (TEMPO REAL)")
  AJUDA O MALUCO TA DOENTE TEXTO("  5 - DUNGEON DA ACADEMIA (BFS)")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  0 - SAIR DO FLIPERAMA")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHE AI, FRANGO:")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO FIM_GUI(MONSTRO R)
  FRANGO L = "END " + R
  AJUDA O MALUCO TA DOENTE ESCREVE(L)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO RODA_GUI(MONSTRO LIXO)
  FRANGO RES = "?"
  ELE QUE A GENTE QUER? JOGO_GUI == "velha"
    RES = AJUDA O MALUCO TA DOENTE JOGO_VELHA(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "forca"
    RES = AJUDA O MALUCO TA DOENTE JOGO_FORCA(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "academia"
    RES = AJUDA O MALUCO TA DOENTE JOGO_ACADEMIA(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "tamagotchi"
    RES = AJUDA O MALUCO TA DOENTE JOGO_TAMAGOTCHI(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "dungeon"
    RES = AJUDA O MALUCO TA DOENTE JOGO_DUNGEON(0)
  BIRL
  AJUDA O MALUCO TA DOENTE FIM_GUI(RES)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO RODA_TERMINAL(MONSTRO LIXO)
  FRANGO SAIR = 0
  NEGATIVA BAMBAM (SAIR == 0)
    AJUDA O MALUCO TA DOENTE MENU(0)
    FRANGO OP = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    ELE QUE A GENTE QUER? OP == "1"
      AJUDA O MALUCO TA DOENTE JOGO_VELHA(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "2"
      AJUDA O MALUCO TA DOENTE JOGO_FORCA(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "3"
      AJUDA O MALUCO TA DOENTE JOGO_ACADEMIA(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "4"
      AJUDA O MALUCO TA DOENTE JOGO_TAMAGOTCHI(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "5"
      AJUDA O MALUCO TA DOENTE JOGO_DUNGEON(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "0"
      SAIR = 1
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE TEXTO("")
      AJUDA O MALUCO TA DOENTE TEXTO("  VALEU, MONSTRO. AGORA VAI COMER UM FRANGO.")
      AJUDA O MALUCO TA DOENTE TEXTO("")
    NAO VAI DAR NAO
      AJUDA O MALUCO TA DOENTE TEXTO("")
      AJUDA O MALUCO TA DOENTE TEXTO("  OPCAO INVALIDA, SEU FRANGO! TENTA DE NOVO.")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO RODA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    AJUDA O MALUCO TA DOENTE RODA_GUI(0)
  NAO VAI DAR NAO
    AJUDA O MALUCO TA DOENTE RODA_TERMINAL(0)
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_VELHA(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  JOGO DA VELHA")
  AJUDA O MALUCO TA DOENTE TEXTO("  EM CONSTRUCAO NESSA ETAPA. VOLTA DEPOIS, MONSTRO.")
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR...")
  BORA CUMPADI "EM BREVE"
BIRL

OH O HOME AI PO FRANGO JOGO_FORCA(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  FORCA DO BAMBAM")
  AJUDA O MALUCO TA DOENTE TEXTO("  EM CONSTRUCAO NESSA ETAPA. VOLTA DEPOIS, MONSTRO.")
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR...")
  BORA CUMPADI "EM BREVE"
BIRL

OH O HOME AI PO FRANGO JOGO_ACADEMIA(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  SIMULADOR DE ACADEMIA")
  AJUDA O MALUCO TA DOENTE TEXTO("  EM CONSTRUCAO NESSA ETAPA. VOLTA DEPOIS, MONSTRO.")
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR...")
  BORA CUMPADI "EM BREVE"
BIRL

OH O HOME AI PO FRANGO JOGO_TAMAGOTCHI(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  TAMAGOTCHI DO MONSTRO")
  AJUDA O MALUCO TA DOENTE TEXTO("  EM CONSTRUCAO NESSA ETAPA. VOLTA DEPOIS, MONSTRO.")
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR...")
  BORA CUMPADI "EM BREVE"
BIRL

OH O HOME AI PO FRANGO JOGO_DUNGEON(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  DUNGEON DA ACADEMIA")
  AJUDA O MALUCO TA DOENTE TEXTO("  EM CONSTRUCAO NESSA ETAPA. VOLTA DEPOIS, MONSTRO.")
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR...")
  BORA CUMPADI "EM BREVE"
BIRL

AJUDA O MALUCO TA DOENTE RODA(0)

BIRL
