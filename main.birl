    D_HP_MAX = 40
    D_HP = 40
    D_ATK = 4
    D_DEF = 3
    D_PUMP = 20
    D_PUMP_MAX = 20
  BIRL
  ELE QUE A GENTE QUER? T_NM == "toguro"
    D_PERSONAGEM = "toguro"
    D_NOME = "TOGURO"
    D_HP_MAX = 30
    D_HP = 30
    D_ATK = 6
    D_DEF = 2
    D_PUMP = 15
    D_PUMP_MAX = 15
  BIRL
  ELE QUE A GENTE QUER? T_NM == "felipe"
    D_PERSONAGEM = "felipe"
    D_NOME = "FELIPE"
    D_HP_MAX = 35
    D_HP = 35
    D_ATK = 3
    D_DEF = 4
    D_PUMP = 25
    D_PUMP_MAX = 25
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO D_HABILIDADE_CUSTO(MONSTRO HAB)
  T_H = HAB + ""
  ELE QUE A GENTE QUER? T_H == "birl"
    BORA CUMPADI 10
