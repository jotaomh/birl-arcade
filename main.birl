HORA DO SHOW

FRANGO FS = AJUDA O MALUCO TA DOENTE require("fs")
FRANGO ENV = process.env || 0
FRANGO MODO_NOME = ENV.BIRL_MODE || "terminal"
FRANGO MODO_GUI = 0
FRANGO JOGO_GUI = ENV.BIRL_GAME || "menu"
FRANGO TEMPO_GUI = ENV.BIRL_TEMPO || "0"

ELE QUE A GENTE QUER? MODO_NOME == "gui"
  MODO_GUI = 1
BIRL

OH O HOME AI PO FRANGO ESCREVE(MONSTRO T)
  FRANGO L = T + "\n"
  FS.writeSync(1, L)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO LE_LINHA(MONSTRO LIXO)
  FRANGO BUF = Buffer.alloc(1) || 0
  FRANGO TEXTO = ""
  FRANGO FIM = 0
  NEGATIVA BAMBAM (FIM == 0)
    FRANGO N = FS.readSync(0, BUF, 0, 1) || 0
    FRANGO C = BUF.toString("utf8") || ""
    ELE QUE A GENTE QUER? N == 0
      ELE QUE A GENTE QUER? MODO_GUI == 1
        AJUDA O MALUCO TA DOENTE ESCREVE("END EOF")
      NAO VAI DAR NAO
        AJUDA O MALUCO TA DOENTE ESCREVE("")
        AJUDA O MALUCO TA DOENTE ESCREVE("  ACABOU A ENTRADA. VALEU, MONSTRO!")
      BIRL
      process.exit(0)
    BIRL
    ELE QUE A GENTE QUER? C == "\n"
      FIM = 2
    BIRL
    ELE QUE A GENTE QUER? C == "\r"
      FIM = FIM + 0
    BIRL
    ELE QUE A GENTE QUER? FIM == 0
      TEXTO = TEXTO + C
    BIRL
  BIRL
  BORA CUMPADI TEXTO
BIRL

OH O HOME AI PO FRANGO LIMPA_INPUT(MONSTRO S)
  FRANGO P = S.substring(0, 6) || ""
  ELE QUE A GENTE QUER? P == "INPUT "
    FRANGO V = S.substring(6) || ""
    BORA CUMPADI V
  BIRL
  ELE QUE A GENTE QUER? S == "QUIT"
    process.exit(0)
  BIRL
  BORA CUMPADI S
BIRL

OH O HOME AI PO FRANGO TEXTO(MONSTRO T)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    FRANGO L = "TEXT " + T
    AJUDA O MALUCO TA DOENTE ESCREVE(L)
  NAO VAI DAR NAO
    AJUDA O MALUCO TA DOENTE ESCREVE(T)
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO DADO(MONSTRO T)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    FRANGO L = "DATA " + T
    AJUDA O MALUCO TA DOENTE ESCREVE(L)
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO PEDE(MONSTRO TIPO, MONSTRO DICA)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    FRANGO L = "PROMPT " + TIPO + " " + DICA
    AJUDA O MALUCO TA DOENTE ESCREVE(L)
    FRANGO R = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    FRANGO V = AJUDA O MALUCO TA DOENTE LIMPA_INPUT(R)
    BORA CUMPADI V
  BIRL
  AJUDA O MALUCO TA DOENTE ESCREVE("")
  AJUDA O MALUCO TA DOENTE ESCREVE("  " + DICA)
  FRANGO R2 = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
  BORA CUMPADI R2
BIRL

OH O HOME AI PO FRANGO LIMPA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 0
    console.clear()
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO CABECALHO(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ##########################################")
  AJUDA O MALUCO TA DOENTE TEXTO("  #                                        #")
  AJUDA O MALUCO TA DOENTE TEXTO("  #           B I R L   A R C A D E        #")
  AJUDA O MALUCO TA DOENTE TEXTO("  #      AQUI NAO TEM AGUA COM MUSCULO     #")
  AJUDA O MALUCO TA DOENTE TEXTO("  #                                        #")
  AJUDA O MALUCO TA DOENTE TEXTO("  ##########################################")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO PAUSA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    BORA CUMPADI 0
  BIRL
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR, MONSTRO...")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO MENU(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  1 - JOGO DA VELHA VS BAMBAM (MINIMAX)")
  AJUDA O MALUCO TA DOENTE TEXTO("  2 - FORCA: BAMBAM ADIVINHADOR")
  AJUDA O MALUCO TA DOENTE TEXTO("  3 - SIMULADOR DE ACADEMIA")
  AJUDA O MALUCO TA DOENTE TEXTO("  4 - TAMAGOTCHI DO MONSTRO (TEMPO REAL)")
  AJUDA O MALUCO TA DOENTE TEXTO("  5 - DUNGEON DA ACADEMIA (BFS)")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  0 - SAIR DO FLIPERAMA")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHE AI, FRANGO:")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO FIM_GUI(MONSTRO R)
  FRANGO L = "END " + R
  AJUDA O MALUCO TA DOENTE ESCREVE(L)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO RODA_GUI(MONSTRO LIXO)
  FRANGO RES = "?"
  ELE QUE A GENTE QUER? JOGO_GUI == "velha"
    RES = AJUDA O MALUCO TA DOENTE JOGO_VELHA(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "forca"
    RES = AJUDA O MALUCO TA DOENTE JOGO_FORCA(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "academia"
    RES = AJUDA O MALUCO TA DOENTE JOGO_ACADEMIA(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "tamagotchi"
    RES = AJUDA O MALUCO TA DOENTE JOGO_TAMAGOTCHI(0)
  BIRL
  ELE QUE A GENTE QUER? JOGO_GUI == "dungeon"
    RES = AJUDA O MALUCO TA DOENTE JOGO_DUNGEON(0)
  BIRL
  AJUDA O MALUCO TA DOENTE FIM_GUI(RES)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO RODA_TERMINAL(MONSTRO LIXO)
  FRANGO SAIR = 0
  NEGATIVA BAMBAM (SAIR == 0)
    AJUDA O MALUCO TA DOENTE MENU(0)
    FRANGO OP = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    ELE QUE A GENTE QUER? OP == "1"
      AJUDA O MALUCO TA DOENTE JOGO_VELHA(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "2"
      AJUDA O MALUCO TA DOENTE JOGO_FORCA(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "3"
      AJUDA O MALUCO TA DOENTE JOGO_ACADEMIA(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "4"
      AJUDA O MALUCO TA DOENTE JOGO_TAMAGOTCHI(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "5"
      AJUDA O MALUCO TA DOENTE JOGO_DUNGEON(0)
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    QUE NAO VAI DAR O QUE? OP == "0"
      SAIR = 1
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE TEXTO("")
      AJUDA O MALUCO TA DOENTE TEXTO("  VALEU, MONSTRO. AGORA VAI COMER UM FRANGO.")
      AJUDA O MALUCO TA DOENTE TEXTO("")
    NAO VAI DAR NAO
      AJUDA O MALUCO TA DOENTE TEXTO("")
      AJUDA O MALUCO TA DOENTE TEXTO("  OPCAO INVALIDA, SEU FRANGO! TENTA DE NOVO.")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO RODA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? MODO_GUI == 1
    AJUDA O MALUCO TA DOENTE RODA_GUI(0)
  NAO VAI DAR NAO
    AJUDA O MALUCO TA DOENTE RODA_TERMINAL(0)
  BIRL
  BORA CUMPADI 0
BIRL

FRANGO V_TAB = "........."
FRANGO V_NIVEL = 3
FRANGO V_NIVEL_NOME = "IMPOSSIVEL"

OH O HOME AI PO MONSTRO V_VENCE(MONSTRO T, MONSTRO S)
  FRANGO ALVO = S + S + S
  FRANGO A = T.charAt(0) + T.charAt(1) + T.charAt(2)
  FRANGO B = T.charAt(3) + T.charAt(4) + T.charAt(5)
  FRANGO C = T.charAt(6) + T.charAt(7) + T.charAt(8)
  FRANGO D = T.charAt(0) + T.charAt(3) + T.charAt(6)
  FRANGO E = T.charAt(1) + T.charAt(4) + T.charAt(7)
  FRANGO F = T.charAt(2) + T.charAt(5) + T.charAt(8)
  FRANGO G = T.charAt(0) + T.charAt(4) + T.charAt(8)
  FRANGO H = T.charAt(2) + T.charAt(4) + T.charAt(6)
  FRANGO R = 0
  ELE QUE A GENTE QUER? A == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? B == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? C == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? D == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? E == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? F == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? G == ALVO
    R = 1
  BIRL
  ELE QUE A GENTE QUER? H == ALVO
    R = 1
  BIRL
  BORA CUMPADI R
BIRL

OH O HOME AI PO MONSTRO V_CHEIO(MONSTRO T)
  FRANGO N = 0
  FRANGO I = 0
  NEGATIVA BAMBAM (I < 9)
    FRANGO C = T.charAt(I) || "."
    ELE QUE A GENTE QUER? C != "."
      N = N + 1
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI N
BIRL

OH O HOME AI PO FRANGO V_MARCA(MONSTRO T, MONSTRO POS, MONSTRO S)
  FRANGO PARTES = T.split("") || 0
  PARTES.splice(POS, 1, S)
  FRANGO NOVO = PARTES.join("") || ""
  BORA CUMPADI NOVO
BIRL

OH O HOME AI PO FRANGO V_CASA(MONSTRO T, MONSTRO I)
  FRANGO C = T.charAt(I) || ""
  ELE QUE A GENTE QUER? C == "."
    FRANGO N = "" + I
    BORA CUMPADI N
  BIRL
  BORA CUMPADI C
BIRL

OH O HOME AI PO MONSTRO V_MINIMAX(MONSTRO T, MONSTRO VEZ, MONSTRO PROF, MONSTRO LIM)
  FRANGO WO = AJUDA O MALUCO TA DOENTE V_VENCE(T, "O")
  ELE QUE A GENTE QUER? WO == 1
    FRANGO S1 = 10 - PROF
    BORA CUMPADI S1
  BIRL
  FRANGO WX = AJUDA O MALUCO TA DOENTE V_VENCE(T, "X")
  ELE QUE A GENTE QUER? WX == 1
    FRANGO S2 = PROF - 10
    BORA CUMPADI S2
  BIRL
  FRANGO CH = AJUDA O MALUCO TA DOENTE V_CHEIO(T)
  ELE QUE A GENTE QUER? CH > 8
    BORA CUMPADI 0
  BIRL
  ELE QUE A GENTE QUER? PROF == LIM
    BORA CUMPADI 0
  BIRL
  FRANGO MELHOR = 0
  ELE QUE A GENTE QUER? VEZ == "O"
    MELHOR = 0 - 100
    FRANGO I = 0
    NEGATIVA BAMBAM (I < 9)
      FRANGO C = T.charAt(I) || "."
      ELE QUE A GENTE QUER? C == "."
        FRANGO T2 = AJUDA O MALUCO TA DOENTE V_MARCA(T, I, "O")
        FRANGO P2 = PROF + 1
        FRANGO SC = AJUDA O MALUCO TA DOENTE V_MINIMAX(T2, "X", P2, LIM)
        ELE QUE A GENTE QUER? SC > MELHOR
          MELHOR = SC + 0
        BIRL
      BIRL
      I = I + 1
    BIRL
    BORA CUMPADI MELHOR
  BIRL
  MELHOR = 100
  FRANGO J = 0
  NEGATIVA BAMBAM (J < 9)
    FRANGO C2 = T.charAt(J) || "."
    ELE QUE A GENTE QUER? C2 == "."
      FRANGO T3 = AJUDA O MALUCO TA DOENTE V_MARCA(T, J, "X")
      FRANGO P3 = PROF + 1
      FRANGO SC2 = AJUDA O MALUCO TA DOENTE V_MINIMAX(T3, "O", P3, LIM)
      ELE QUE A GENTE QUER? SC2 < MELHOR
        MELHOR = SC2 + 0
      BIRL
    BIRL
    J = J + 1
  BIRL
  BORA CUMPADI MELHOR
BIRL

OH O HOME AI PO FRANGO V_ESCOLHE_FACIL(MONSTRO T)
  FRANGO POS = 0 - 1
  FRANGO I = 0
  NEGATIVA BAMBAM (I < 9)
    FRANGO C = T.charAt(I) || "."
    ELE QUE A GENTE QUER? C == "."
      ELE QUE A GENTE QUER? POS < 0
        FRANGO T2 = AJUDA O MALUCO TA DOENTE V_MARCA(T, I, "O")
        FRANGO W = AJUDA O MALUCO TA DOENTE V_VENCE(T2, "O")
        ELE QUE A GENTE QUER? W == 1
          POS = I + 0
        BIRL
      BIRL
    BIRL
    I = I + 1
  BIRL
  ELE QUE A GENTE QUER? POS < 0
    FRANGO J = 0
    NEGATIVA BAMBAM (J < 9)
      FRANGO C2 = T.charAt(J) || "."
      ELE QUE A GENTE QUER? C2 == "."
        ELE QUE A GENTE QUER? POS < 0
          POS = J + 0
        BIRL
      BIRL
      J = J + 1
    BIRL
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO FRANGO V_ESCOLHE(MONSTRO T, MONSTRO NIVEL)
  ELE QUE A GENTE QUER? NIVEL == 1
    FRANGO F = AJUDA O MALUCO TA DOENTE V_ESCOLHE_FACIL(T)
    BORA CUMPADI F
  BIRL
  FRANGO LIM = 2
  ELE QUE A GENTE QUER? NIVEL == 3
    LIM = 9
  BIRL
  FRANGO ORDEM = "402681357"
  FRANGO POS = 0 - 1
  FRANGO MELHOR = 0 - 1000
  FRANGO K = 0
  NEGATIVA BAMBAM (K < 9)
    FRANGO CH = ORDEM.charAt(K) || "0"
    FRANGO P = 0 + parseInt(CH, 10)
    FRANGO C = T.charAt(P) || "."
    ELE QUE A GENTE QUER? C == "."
      FRANGO T2 = AJUDA O MALUCO TA DOENTE V_MARCA(T, P, "O")
      FRANGO SC = AJUDA O MALUCO TA DOENTE V_MINIMAX(T2, "X", 1, LIM)
      ELE QUE A GENTE QUER? SC > MELHOR
        MELHOR = SC + 0
        POS = P + 0
      BIRL
    BIRL
    K = K + 1
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO FRANGO V_DESENHA(MONSTRO T)
  FRANGO A = AJUDA O MALUCO TA DOENTE V_CASA(T, 0)
  FRANGO B = AJUDA O MALUCO TA DOENTE V_CASA(T, 1)
  FRANGO C = AJUDA O MALUCO TA DOENTE V_CASA(T, 2)
  FRANGO D = AJUDA O MALUCO TA DOENTE V_CASA(T, 3)
  FRANGO E = AJUDA O MALUCO TA DOENTE V_CASA(T, 4)
  FRANGO F = AJUDA O MALUCO TA DOENTE V_CASA(T, 5)
  FRANGO G = AJUDA O MALUCO TA DOENTE V_CASA(T, 6)
  FRANGO H = AJUDA O MALUCO TA DOENTE V_CASA(T, 7)
  FRANGO I = AJUDA O MALUCO TA DOENTE V_CASA(T, 8)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("      " + A + " | " + B + " | " + C)
  AJUDA O MALUCO TA DOENTE TEXTO("     ---+---+---")
  AJUDA O MALUCO TA DOENTE TEXTO("      " + D + " | " + E + " | " + F)
  AJUDA O MALUCO TA DOENTE TEXTO("     ---+---+---")
  AJUDA O MALUCO TA DOENTE TEXTO("      " + G + " | " + H + " | " + I)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO V_PEDE_CASA(MONSTRO LIXO)
  FRANGO POS = 0
  FRANGO OK = 0
  NEGATIVA BAMBAM (OK == 0)
    FRANGO E = AJUDA O MALUCO TA DOENTE PEDE("cell", "SUA VEZ, MONSTRO. ESCOLHE UMA CASA (0-8):")
    FRANGO N = 0 + E.length
    ELE QUE A GENTE QUER? N == 1
      FRANGO CH = E.charAt(0) || "?"
      ELE QUE A GENTE QUER? CH > "/"
        ELE QUE A GENTE QUER? CH < "9"
          FRANGO P = 0 + parseInt(CH, 10)
          FRANGO D = V_TAB.charAt(P) || "#"
          ELE QUE A GENTE QUER? D == "."
            POS = P + 0
            OK = 1
          NAO VAI DAR NAO
            AJUDA O MALUCO TA DOENTE TEXTO("  ESSA CASA JA TA OCUPADA, FRANGO!")
          BIRL
        NAO VAI DAR NAO
          AJUDA O MALUCO TA DOENTE TEXTO("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
        BIRL
      NAO VAI DAR NAO
        AJUDA O MALUCO TA DOENTE TEXTO("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
      BIRL
    NAO VAI DAR NAO
      AJUDA O MALUCO TA DOENTE TEXTO("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
    BIRL
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO FRANGO V_ESCOLHE_NIVEL(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  DIFICULDADE DO BAMBAM:")
  AJUDA O MALUCO TA DOENTE TEXTO("  1 - FACIL (ELE NAO BLOQUEIA)")
  AJUDA O MALUCO TA DOENTE TEXTO("  2 - MEDIO (OLHA 2 JOGADAS)")
  AJUDA O MALUCO TA DOENTE TEXTO("  3 - IMPOSSIVEL (MINIMAX COMPLETO)")
  AJUDA O MALUCO TA DOENTE DADO("OPCOES 1=FACIL|2=MEDIO|3=IMPOSSIVEL")
  FRANGO OK = 0
  FRANGO N = 3
  NEGATIVA BAMBAM (OK == 0)
    FRANGO R = AJUDA O MALUCO TA DOENTE PEDE("choice", "ESCOLHE A DIFICULDADE (1-3):")
    ELE QUE A GENTE QUER? R == "1"
      N = 1
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? R == "2"
      N = 2
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? R == "3"
      N = 3
      OK = 1
    BIRL
    ELE QUE A GENTE QUER? OK == 0
      AJUDA O MALUCO TA DOENTE TEXTO("  ESCOLHE 1, 2 OU 3, MONSTRO!")
    BIRL
  BIRL
  V_NIVEL = N + 0
  ELE QUE A GENTE QUER? N == 1
    V_NIVEL_NOME = "FACIL"
  BIRL
  ELE QUE A GENTE QUER? N == 2
    V_NIVEL_NOME = "MEDIO"
  BIRL
  ELE QUE A GENTE QUER? N == 3
    V_NIVEL_NOME = "IMPOSSIVEL"
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_VELHA(MONSTRO LIXO)
  V_TAB = "........."
  V_NIVEL = 3
  V_NIVEL_NOME = "IMPOSSIVEL"
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  JOGO DA VELHA VS BAMBAM")
  AJUDA O MALUCO TA DOENTE TEXTO("  VOCE E O X. BAMBAM E O O.")
  AJUDA O MALUCO TA DOENTE V_ESCOLHE_NIVEL(0)
  AJUDA O MALUCO TA DOENTE DADO("NIVEL " + V_NIVEL_NOME)
  FRANGO JOGADAS = 0
  FRANGO VEZ = "X"
  FRANGO RESULTADO = "."
  NEGATIVA BAMBAM (RESULTADO == ".")
    ELE QUE A GENTE QUER? JOGADAS < 9
      ELE QUE A GENTE QUER? MODO_GUI == 0
        AJUDA O MALUCO TA DOENTE LIMPA(0)
        AJUDA O MALUCO TA DOENTE CABECALHO(0)
        AJUDA O MALUCO TA DOENTE TEXTO("")
        AJUDA O MALUCO TA DOENTE TEXTO("  JOGO DA VELHA VS BAMBAM    JOGADA: " + JOGADAS)
        AJUDA O MALUCO TA DOENTE TEXTO("  DIFICULDADE: " + V_NIVEL_NOME)
        AJUDA O MALUCO TA DOENTE V_DESENHA(V_TAB)
      BIRL
      AJUDA O MALUCO TA DOENTE DADO("TABULEIRO " + V_TAB)
      AJUDA O MALUCO TA DOENTE DADO("VEZ " + VEZ)
      ELE QUE A GENTE QUER? VEZ == "X"
        FRANGO POSX = AJUDA O MALUCO TA DOENTE V_PEDE_CASA(0)
        V_TAB = AJUDA O MALUCO TA DOENTE V_MARCA(V_TAB, POSX, "X")
      NAO VAI DAR NAO
        AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM TA PENSANDO... ELE PENSA COM O BICEPS.")
        FRANGO POSO = AJUDA O MALUCO TA DOENTE V_ESCOLHE(V_TAB, V_NIVEL)
        V_TAB = AJUDA O MALUCO TA DOENTE V_MARCA(V_TAB, POSO, "O")
        AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM JOGA NA CASA " + POSO)
      BIRL
      JOGADAS = JOGADAS + 1
      FRANGO VX = AJUDA O MALUCO TA DOENTE V_VENCE(V_TAB, "X")
      FRANGO VO = AJUDA O MALUCO TA DOENTE V_VENCE(V_TAB, "O")
      ELE QUE A GENTE QUER? VX == 1
        RESULTADO = "VOCE"
      BIRL
      ELE QUE A GENTE QUER? VO == 1
        RESULTADO = "BAMBAM"
      BIRL
      ELE QUE A GENTE QUER? VEZ == "X"
        VEZ = "O"
      NAO VAI DAR NAO
        VEZ = "X"
      BIRL
    NAO VAI DAR NAO
      RESULTADO = "EMPATE"
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE DADO("TABULEIRO " + V_TAB)
  ELE QUE A GENTE QUER? MODO_GUI == 0
    AJUDA O MALUCO TA DOENTE LIMPA(0)
    AJUDA O MALUCO TA DOENTE CABECALHO(0)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE V_DESENHA(V_TAB)
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "VOCE"
    AJUDA O MALUCO TA DOENTE TEXTO("  BIRL! VOCE AMASSOLOU O BAMBAM NO JOGO DA VELHA!")
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "BAMBAM"
    AJUDA O MALUCO TA DOENTE TEXTO("  O BAMBAM TE AMASSOLOU. VAI TREINAR MAIS, FRANGO!")
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "EMPATE"
    AJUDA O MALUCO TA DOENTE TEXTO("  EMPATE! NINGUEM MURCHOU NESSA.")
  BIRL
  BORA CUMPADI RESULTADO
BIRL

FRANGO F_DIC = "BAMBAM|MUSCULO|ACADEMIA|FRANGO|MAROMBA|SUPINO|AGACHAMENTO|FLEXAO|LEVANTAMENTO|TREINO|PROTEINA|WHEY|MONSTRO|CULTURA|HIPERTROFIA|FORCA|POTENCIA|RESISTENCIA|CARDIO|DESCANSO|MASSA|DEFINICAO|SERIE|REPETICAO|CADEIRA|HALTER|BARRA|ANILHA|KETTLEBELL|MACACAO"

FRANGO F_CAND_STR = ""
FRANGO F_SECRETA = ""
FRANGO F_PADRAO = ""
FRANGO F_CERTAS = ""
FRANGO F_ERRADAS = ""
FRANGO F_CHUTADAS = ""
FRANGO F_ERROS = 0
FRANGO F_MAX = 6

OH O HOME AI PO FRANGO F_RESET(MONSTRO LIXO)
  F_CAND_STR = F_DIC + ""
  F_SECRETA = ""
  F_PADRAO = ""
  F_CERTAS = ""
  F_ERRADAS = ""
  F_CHUTADAS = ""
  F_ERROS = 0
  F_MAX = 6
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO F_ATUALIZA_PADRAO(MONSTRO LIXO)
  FRANGO I = 0
  FRANGO TAM = 0 + F_SECRETA.length
  FRANGO P = ""
  NEGATIVA BAMBAM (I < TAM)
    FRANGO C = F_SECRETA.charAt(I) || ""
    FRANGO J = 0
    FRANGO ACHOU = 0
    FRANGO TC = 0 + F_CERTAS.length
    NEGATIVA BAMBAM (J < TC)
      FRANGO CC = F_CERTAS.charAt(J) || ""
      ELE QUE A GENTE QUER? CC == C
        ACHOU = 1
      BIRL
      J = J + 1
    BIRL
    ELE QUE A GENTE QUER? ACHOU == 1
      P = P + C
    NAO VAI DAR NAO
      P = P + "_"
    BIRL
    I = I + 1
  BIRL
  F_PADRAO = P + ""
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO F_JA_CHUTOU(MONSTRO L, MONSTRO C)
  FRANGO I = 0
  FRANGO TAM = 0 + L.length
  NEGATIVA BAMBAM (I < TAM)
    FRANGO X = L.charAt(I) || ""
    ELE QUE A GENTE QUER? X == C
      BORA CUMPADI 1
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO F_PALAVRA_VALIDA(MONSTRO PAL, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS)
  FRANGO TSP = 0 + SECRETA.length
  FRANGO TP = 0 + PAL.length
  ELE QUE A GENTE QUER? TP != TSP
    BORA CUMPADI 0
  BIRL
  FRANGO I = 0
  NEGATIVA BAMBAM (I < TP)
    FRANGO PC = PAL.charAt(I) || ""
    FRANGO SC = SECRETA.charAt(I) || ""
    FRANGO PCC = PC + ""
    FRANGO SCC = SC + ""
    FRANGO E1 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(CERTAS, PCC)
    FRANGO E2 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(ERRADAS, PCC)
    ELE QUE A GENTE QUER? SCC == "_"
      ELE QUE A GENTE QUER? E1 == 1
        BORA CUMPADI 0
      BIRL
    NAO VAI DAR NAO
      ELE QUE A GENTE QUER? PCC != SCC
        BORA CUMPADI 0
      BIRL
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO F_FILTRA_STR(MONSTRO BASE, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS)
  FRANGO ARR = BASE.split("|") || 0
  FRANGO NOVO = ""
  FRANGO CNT = 0 + ARR.length
  FRANGO I = 0
  NEGATIVA BAMBAM (I < CNT)
    FRANGO PAL = ARR.shift() || ""
    FRANGO PL = 0 + PAL.length
    FRANGO PLV = PL + 0
    ELE QUE A GENTE QUER? PLV > 0
      FRANGO VAL = AJUDA O MALUCO TA DOENTE F_PALAVRA_VALIDA(PAL, SECRETA, CERTAS, ERRADAS)
      ELE QUE A GENTE QUER? VAL == 1
        NOVO = NOVO + PAL + "|"
      BIRL
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI NOVO
BIRL

OH O HOME AI PO FRANGO F_CONTA_FREQ_STR(MONSTRO BASE, MONSTRO SECRETA, MONSTRO CERTAS, MONSTRO ERRADAS)
  FRANGO ARR = BASE.split("|") || 0
  FRANGO RES = ""
  FRANGO LET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  FRANGO I = 0
  NEGATIVA BAMBAM (I < 26)
    FRANGO L = LET.charAt(I) || ""
    FRANGO CNT_ARR = 0 + ARR.length
    FRANGO CNT = 0
    FRANGO KARR = 0
    NEGATIVA BAMBAM (KARR < CNT_ARR)
      FRANGO PAL = ARR.shift() || ""
      FRANGO PL2 = 0 + PAL.length
      FRANGO PL2V = PL2 + 0
      ELE QUE A GENTE QUER? PL2V > 0
        FRANGO VAL = AJUDA O MALUCO TA DOENTE F_PALAVRA_VALIDA(PAL, SECRETA, CERTAS, ERRADAS)
        ELE QUE A GENTE QUER? VAL == 1
          FRANGO P = 0
          FRANGO TPA = 0 + PAL.length
          NEGATIVA BAMBAM (P < TPA)
            FRANGO PC = PAL.charAt(P) || ""
            FRANGO PCC2 = PC + ""
            ELE QUE A GENTE QUER? PCC2 == L
              CNT = CNT + 1
            BIRL
            P = P + 1
          BIRL
        BIRL
      BIRL
      ARR.push(PAL)
      KARR = KARR + 1
    BIRL
    ELE QUE A GENTE QUER? CNT > 0
      FRANGO JC = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(CERTAS, L)
      FRANGO JE = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(ERRADAS, L)
      FRANGO JCV = JC + 0
      FRANGO JEV = JE + 0
      ELE QUE A GENTE QUER? JCV == 0
        ELE QUE A GENTE QUER? JEV == 0
          RES = RES + L
        BIRL
      BIRL
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI RES
BIRL

OH O HOME AI PO FRANGO F_CHUTE_BAMBAM(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE F_ATUALIZA_PADRAO(0)
  F_CAND_STR = AJUDA O MALUCO TA DOENTE F_FILTRA_STR(F_CAND_STR, F_PADRAO, F_CERTAS, F_ERRADAS) || ""
  FRANGO ARR2 = F_CAND_STR.split("|") || 0
  FRANGO TAMC = 0 + ARR2.length
  FRANGO TC2 = TAMC + 0
  ELE QUE A GENTE QUER? TC2 < 2
    FRANGO I = 0
    NEGATIVA BAMBAM (I < 26)
      FRANGO LETR = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
      FRANGO L = LETR.charAt(I) || ""
      FRANGO LC = L + ""
      FRANGO J1 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_CERTAS, LC)
      FRANGO J2 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_ERRADAS, LC)
      ELE QUE A GENTE QUER? J1 == 0
        ELE QUE A GENTE QUER? J2 == 0
          F_CHUTADAS = F_CHUTADAS + L
          FRANGO TSE = 0 + F_SECRETA.length
          FRANGO K = 0
          FRANGO AC = 0
          NEGATIVA BAMBAM (K < TSE)
            FRANGO SC2 = F_SECRETA.charAt(K) || ""
            FRANGO SC2C = SC2 + ""
            ELE QUE A GENTE QUER? SC2C == L
              AC = 1
            BIRL
            K = K + 1
          BIRL
          ELE QUE A GENTE QUER? AC == 1
            F_CERTAS = F_CERTAS + L
            AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... CERTO!")
          NAO VAI DAR NAO
            F_ERRADAS = F_ERRADAS + L
            F_ERROS = F_ERROS + 1
            AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... ERROU!")
          BIRL
          I = 30
        BIRL
      BIRL
      I = I + 1
    BIRL
  NAO VAI DAR NAO
    FRANGO FREQ = AJUDA O MALUCO TA DOENTE F_CONTA_FREQ_STR(F_CAND_STR, F_PADRAO, F_CERTAS, F_ERRADAS) || ""
    FRANGO FREQ_T = 0 + FREQ.length
    ELE QUE A GENTE QUER? FREQ_T == 0
      FRANGO I = 0
      NEGATIVA BAMBAM (I < 26)
        FRANGO LETR2 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        FRANGO L = LETR2.charAt(I) || ""
        FRANGO LC = L + ""
        FRANGO J1 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_CERTAS, LC)
        FRANGO J2 = AJUDA O MALUCO TA DOENTE F_JA_CHUTOU(F_ERRADAS, LC)
        ELE QUE A GENTE QUER? J1 == 0
          ELE QUE A GENTE QUER? J2 == 0
            F_CHUTADAS = F_CHUTADAS + L
            FRANGO TSE = 0 + F_SECRETA.length
            FRANGO K = 0
            FRANGO AC = 0
            NEGATIVA BAMBAM (K < TSE)
              FRANGO SC2 = F_SECRETA.charAt(K) || ""
              FRANGO SC2C = SC2 + ""
              ELE QUE A GENTE QUER? SC2C == L
                AC = 1
              BIRL
              K = K + 1
            BIRL
            ELE QUE A GENTE QUER? AC == 1
              F_CERTAS = F_CERTAS + L
              AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... CERTO!")
            NAO VAI DAR NAO
              F_ERRADAS = F_ERRADAS + L
              F_ERROS = F_ERROS + 1
              AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM CHUTA " + L + " ... ERROU!")
            BIRL
            I = 30
          BIRL
        BIRL
        I = I + 1
      BIRL
    NAO VAI DAR NAO
      FRANGO L2 = FREQ.charAt(0) || "A"
      F_CHUTADAS = F_CHUTADAS + L2
      FRANGO TSE2 = 0 + F_SECRETA.length
      FRANGO K2 = 0
      FRANGO AC2 = 0
      NEGATIVA BAMBAM (K2 < TSE2)
        FRANGO SC3 = F_SECRETA.charAt(K2) || ""
        ELE QUE A GENTE QUER? SC3 == L2
          AC2 = 1
        BIRL
        K2 = K2 + 1
      BIRL
      ELE QUE A GENTE QUER? AC2 == 1
        F_CERTAS = F_CERTAS + L2
        AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM USA FREQUENCIA E CHUTA " + L2 + " ... CERTO!")
      NAO VAI DAR NAO
        F_ERRADAS = F_ERRADAS + L2
        F_ERROS = F_ERROS + 1
        AJUDA O MALUCO TA DOENTE TEXTO("  BAMBAM USA FREQUENCIA E CHUTA " + L2 + " ... ERROU!")
      BIRL
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE F_ATUALIZA_PADRAO(0)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO F_VENCE(MONSTRO LIXO)
  FRANGO I = 0
  FRANGO TAM = 0 + F_PADRAO.length
  NEGATIVA BAMBAM (I < TAM)
    FRANGO C = F_PADRAO.charAt(I) || "_"
    ELE QUE A GENTE QUER? C == "_"
      BORA CUMPADI 0
    BIRL
    I = I + 1
  BIRL
  BORA CUMPADI 1
BIRL

OH O HOME AI PO FRANGO JOGO_FORCA(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE F_RESET(0)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  FORCA: BAMBAM ADIVINHADOR")
  AJUDA O MALUCO TA DOENTE TEXTO("  VOCE ESCOLHE A PALAVRA SECRETA. O BAMBAM VAI TENTAR ADIVINHAR.")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  FRANGO SECR = AJUDA O MALUCO TA DOENTE PEDE("text", "DIGITA A PALAVRA SECRETA (SO LETRAS):")
  SECR = SECR.toUpperCase() || ""
  F_SECRETA = SECR + ""
  AJUDA O MALUCO TA DOENTE F_ATUALIZA_PADRAO(0)
  F_CAND_STR = AJUDA O MALUCO TA DOENTE F_FILTRA_STR(F_DIC, F_PADRAO, F_CERTAS, F_ERRADAS) || ""
  AJUDA O MALUCO TA DOENTE DADO("PADRAO " + F_PADRAO)
  AJUDA O MALUCO TA DOENTE DADO("CERTAS " + F_CERTAS)
  AJUDA O MALUCO TA DOENTE DADO("ERRADAS " + F_ERRADAS)
  AJUDA O MALUCO TA DOENTE DADO("ERROS " + F_ERROS)
  AJUDA O MALUCO TA DOENTE DADO("MAX " + F_MAX)
  FRANGO RES = "."
  NEGATIVA BAMBAM (RES == ".")
    FRANGO FE = F_ERROS + 0
    FRANGO LIM = F_MAX + 0
    ELE QUE A GENTE QUER? FE < LIM
      FRANGO V = AJUDA O MALUCO TA DOENTE F_VENCE(0)
      ELE QUE A GENTE QUER? V == 0
        AJUDA O MALUCO TA DOENTE TEXTO("")
        AJUDA O MALUCO TA DOENTE TEXTO("  PALAVRA: " + F_PADRAO)
        AJUDA O MALUCO TA DOENTE TEXTO("  CERTAS: " + F_CERTAS + "   ERRADAS: " + F_ERRADAS)
        AJUDA O MALUCO TA DOENTE TEXTO("  FORCA: " + F_ERROS + "/" + F_MAX)
        AJUDA O MALUCO TA DOENTE DADO("PADRAO " + F_PADRAO)
        AJUDA O MALUCO TA DOENTE DADO("CERTAS " + F_CERTAS)
        AJUDA O MALUCO TA DOENTE DADO("ERRADAS " + F_ERRADAS)
        AJUDA O MALUCO TA DOENTE DADO("ERROS " + F_ERROS)
        AJUDA O MALUCO TA DOENTE DADO("MAX " + F_MAX)
        AJUDA O MALUCO TA DOENTE PEDE("next", "BAMBAM VAI ANALISAR O DICIONARIO E CHUTAR...")
        AJUDA O MALUCO TA DOENTE F_CHUTE_BAMBAM(0)
      NAO VAI DAR NAO
        RES = "BAMBAM_PERDEU"
      BIRL
    NAO VAI DAR NAO
      RES = "BAMBAM_GANHOU"
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  PALAVRA SECRETA: " + F_SECRETA)
  AJUDA O MALUCO TA DOENTE TEXTO("  CHUTES: " + F_CHUTADAS)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  ELE QUE A GENTE QUER? RES == "BAMBAM_PERDEU"
    AJUDA O MALUCO TA DOENTE TEXTO("  O BAMBAM NAO ADIVINHOU! VOCE VENCEU ESSA BATALHA.")
  BIRL
  ELE QUE A GENTE QUER? RES == "BAMBAM_GANHOU"
    AJUDA O MALUCO TA DOENTE TEXTO("  O BAMBAM ADIVINHOU A PALAVRA! ELE TA CHEIO DE PROTEINA.")
  BIRL
  BORA CUMPADI RES
BIRL

FRANGO A_FORCA = 10
FRANGO A_SHAPE = 10
FRANGO A_ENERGIA = 100
FRANGO A_FADIGA = 0
FRANGO A_LESAO = 0
FRANGO A_DIA = 1
FRANGO A_CALORIAS = 2000
FRANGO A_PROTEINA = 120
FRANGO A_META = "HIPERTROFIA"

OH O HOME AI PO FRANGO A_RESET(MONSTRO LIXO)
  A_FORCA = 10
  A_SHAPE = 10
  A_ENERGIA = 100
  A_FADIGA = 0
  A_LESAO = 0
  A_DIA = 1
  A_CALORIAS = 2000
  A_PROTEINA = 120
  A_META = "HIPERTROFIA"
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO A_ATRIBUTOS(MONSTRO LIXO)
  FRANGO S = "forca=" + A_FORCA + " shape=" + A_SHAPE + " energia=" + A_ENERGIA + " fadiga=" + A_FADIGA + " lesao=" + A_LESAO + " dia=" + A_DIA + " meta=" + A_META + " calorias=" + A_CALORIAS + " proteina=" + A_PROTEINA
  AJUDA O MALUCO TA DOENTE DADO("ATRIBUTOS " + S)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO A_TREINO_PESADO(MONSTRO LIXO)
  ELE QUE A GENTE QUER? A_LESAO > 0
    AJUDA O MALUCO TA DOENTE TEXTO("  LESAO ATIVA! TREINO PESADO NAO RECOMENDADO. DESCANSA.")
    BORA CUMPADI 0
  BIRL
  A_FADIGA = A_FADIGA + 25
  A_ENERGIA = A_ENERGIA - 30
  A_PROTEINA = A_PROTEINA + 15
  ELE QUE A GENTE QUER? A_FADIGA > 70
    A_FORCA = A_FORCA + 2
    A_SHAPE = A_SHAPE + 2
    AJUDA O MALUCO TA DOENTE TEXTO("  SOBRECARGA PROGRESSIVA: O BICEPS RESPONDEU COM FEROCIDADE.")
  NAO VAI DAR NAO
    A_FORCA = A_FORCA + 1
    A_SHAPE = A_SHAPE + 1
  BIRL
  FRANGO R = A_FADIGA * 2
  ELE QUE A GENTE QUER? R > A_ENERGIA
    ELE QUE A GENTE QUER? A_FADIGA > 85
      A_LESAO = A_LESAO + 1
      A_FORCA = A_FORCA - 2
      A_SHAPE = A_SHAPE - 1
      AJUDA O MALUCO TA DOENTE TEXTO("  LESAO POR SOBRECARGA! CONTRATO MUSCULAR. TEMPO DE RESPEITO AO CORPO.")
    NAO VAI DAR NAO
      AJUDA O MALUCO TA DOENTE TEXTO("  FATIGADO DEMAIS. FALTA DE RECUPERACAO SE FAZ SENTIR.")
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  TREINO PESADO FEITO. FORCA E SHAPE SUBIRAM.")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO A_TREINO_LEVE(MONSTRO LIXO)
  A_FADIGA = A_FADIGA + 12
  A_ENERGIA = A_ENERGIA - 15
  A_PROTEINA = A_PROTEINA + 8
  A_FORCA = A_FORCA + 1
  A_SHAPE = A_SHAPE + 1
  AJUDA O MALUCO TA DOENTE TEXTO("  TREINO LEVE. CONSISTENCIA CONSTRUI MONSTROS.")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO A_CARDIO(MONSTRO LIXO)
  A_FADIGA = A_FADIGA + 8
  A_ENERGIA = A_ENERGIA - 12
  A_SHAPE = A_SHAPE + 1
  ELE QUE A GENTE QUER? A_CALORIAS > 1500
    A_CALORIAS = A_CALORIAS - 200
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  CARDIO. DEFINICAO A CAMINHO, FRANGO.")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO A_REFEICAO(MONSTRO LIXO)
  A_CALORIAS = A_CALORIAS + 600
  A_PROTEINA = A_PROTEINA + 40
  AJUDA O MALUCO TA DOENTE TEXTO("  FRANGO COM ARROZ E BATATA DOCE. AGORA SIM.")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO A_DESCANSO(MONSTRO LIXO)
  FRANGO REC_F = A_FADIGA / 3
  FRANGO REC_E = 20
  ELE QUE A GENTE QUER? A_LESAO > 0
    FRANGO REC_F2 = A_FADIGA / 4
    FRANGO REC_E2 = 15
    REC_F = REC_F2 + 0
    REC_E = REC_E2 + 0
    AJUDA O MALUCO TA DOENTE TEXTO("  COM LESAO, A RECUPERACAO E LENTA. RESPEITA O PERIODO.")
  BIRL
  A_FADIGA = A_FADIGA - REC_F
  A_ENERGIA = A_ENERGIA + REC_E
  ELE QUE A GENTE QUER? A_LESAO > 0
    ELE QUE A GENTE QUER? A_FADIGA < 30
      A_LESAO = 0
      AJUDA O MALUCO TA DOENTE TEXTO("  LESAO CURADA COM DESCANSO ADEQUADO.")
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("  DESCANSO. RECUPERACAO EM ANDAMENTO.")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO A_PASSA_DIA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? A_FADIGA < 0
    A_FADIGA = 0
  BIRL
  ELE QUE A GENTE QUER? A_ENERGIA > 100
    A_ENERGIA = 100
  BIRL
  ELE QUE A GENTE QUER? A_ENERGIA < 0
    A_ENERGIA = 0
  BIRL
  A_DIA = A_DIA + 1
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_ACADEMIA(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE A_RESET(0)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  SIMULADOR DE ACADEMIA")
  AJUDA O MALUCO TA DOENTE TEXTO("  FADIGA, RECUPERACAO, SOBRECARGA E LESAO POR REGRA")
  AJUDA O MALUCO TA DOENTE TEXTO("")
  FRANGO SAIR = 0
  NEGATIVA BAMBAM (SAIR == 0)
    AJUDA O MALUCO TA DOENTE A_ATRIBUTOS(0)
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  1 - TREINO PESADO")
    AJUDA O MALUCO TA DOENTE TEXTO("  2 - TREINO LEVE")
    AJUDA O MALUCO TA DOENTE TEXTO("  3 - CARDIO")
    AJUDA O MALUCO TA DOENTE TEXTO("  4 - REFEICAO (FRANGO COM ARROZ)")
    AJUDA O MALUCO TA DOENTE TEXTO("  5 - DESCANSO")
    AJUDA O MALUCO TA DOENTE TEXTO("  0 - SAIR")
    AJUDA O MALUCO TA DOENTE DADO("OPCOES 1=TREINO PESADO|2=TREINO LEVE|3=CARDIO|4=REFEICAO|5=DESCANSO|0=SAIR")
    FRANGO OP = AJUDA O MALUCO TA DOENTE PEDE("choice", "ACAO DO DIA " + A_DIA + ":")
    ELE QUE A GENTE QUER? OP == "1"
      AJUDA O MALUCO TA DOENTE A_TREINO_PESADO(0)
    QUE NAO VAI DAR O QUE? OP == "2"
      AJUDA O MALUCO TA DOENTE A_TREINO_LEVE(0)
    QUE NAO VAI DAR O QUE? OP == "3"
      AJUDA O MALUCO TA DOENTE A_CARDIO(0)
    QUE NAO VAI DAR O QUE? OP == "4"
      AJUDA O MALUCO TA DOENTE A_REFEICAO(0)
    QUE NAO VAI DAR O QUE? OP == "5"
      AJUDA O MALUCO TA DOENTE A_DESCANSO(0)
    QUE NAO VAI DAR O QUE? OP == "0"
      SAIR = 1
    NAO VAI DAR NAO
      AJUDA O MALUCO TA DOENTE TEXTO("  ACAO INVALIDA.")
    BIRL
    AJUDA O MALUCO TA DOENTE A_PASSA_DIA(0)
    ELE QUE A GENTE QUER? SAIR == 0
      AJUDA O MALUCO TA DOENTE PEDE("next", "FIM DO DIA " + A_DIA + "... APERTA ENTER")
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE A_ATRIBUTOS(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  FICHA FINAL. VAI COMER UM FRANGO.")
  BORA CUMPADI "SAIU"
BIRL

FRANGO P_TREINO = 60
FRANGO P_COMIDA = 60
FRANGO P_VAPO = 60
FRANGO P_HORA = 0
FRANGO P_TEMPO = 0

OH O HOME AI PO FRANGO P_CLAMP(MONSTRO LIXO)
  ELE QUE A GENTE QUER? P_TREINO > 100
    P_TREINO = 100
  BIRL
  ELE QUE A GENTE QUER? P_COMIDA > 100
    P_COMIDA = 100
  BIRL
  ELE QUE A GENTE QUER? P_VAPO > 100
    P_VAPO = 100
  BIRL
  ELE QUE A GENTE QUER? P_TREINO < 0
    P_TREINO = 0
  BIRL
  ELE QUE A GENTE QUER? P_COMIDA < 0
    P_COMIDA = 0
  BIRL
  ELE QUE A GENTE QUER? P_VAPO < 0
    P_VAPO = 0
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO P_LER_SAVE(MONSTRO LIXO)
  FRANGO CAMINHO = "saves/tamagotchi.json"
  FRANGO EX = 0 + FS.existsSync(CAMINHO)
  ELE QUE A GENTE QUER? EX == 1
    FRANGO TXT = FS.readFileSync(CAMINHO, "utf8") || ""
    FRANGO TXT_OK = TXT + ""
    ELE QUE A GENTE QUER? TXT_OK.length > 0
      FRANGO D = JSON.parse(TXT_OK) || 0
      FRANGO T1 = 0 + D.treino
      FRANGO T2 = 0 + D.comida
      FRANGO T3 = 0 + D.vapo
      FRANGO T4 = 0 + D.hora
      FRANGO T5 = 0 + D.timestamp
      P_TREINO = T1 + 0
      P_COMIDA = T2 + 0
      P_VAPO = T3 + 0
      P_HORA = T4 + 0
      FRANGO AGORA = 0 + Date.now()
      ELE QUE A GENTE QUER? MODO_GUI == 1
        FRANGO E1 = 0 + parseInt(TEMPO_GUI, 10)
        P_TEMPO = E1 + 0
      NAO VAI DAR NAO
        FRANGO DIFMS = AGORA - T5
        FRANGO E2 = DIFMS / 1000
        P_TEMPO = E2 + 0
      BIRL
      ELE QUE A GENTE QUER? P_TEMPO < 0
        P_TEMPO = 0
      BIRL
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO P_DECAI(MONSTRO SEGS)
  ELE QUE A GENTE QUER? SEGS > 0
    FRANGO HORAS = SEGS / 3600
    FRANGO H = 0 + Math.floor(HORAS)
    ELE QUE A GENTE QUER? H > 24
      H = 24
    BIRL
    FRANGO I = 0
    NEGATIVA BAMBAM (I < H)
      P_TREINO = P_TREINO - 8
      P_COMIDA = P_COMIDA - 10
      P_VAPO = P_VAPO - 6
      I = I + 1
    BIRL
    AJUDA O MALUCO TA DOENTE P_CLAMP(0)
    ELE QUE A GENTE QUER? H > 0
      AJUDA O MALUCO TA DOENTE TEXTO("  PASSARAM " + H + " HORAS REAIS. O MONSTRO SENTIU.")
    BIRL
  BIRL
  ELE QUE A GENTE QUER? SEGS > 86400
    P_TREINO = 0
    P_COMIDA = 0
    P_VAPO = 0
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO P_MORTO(MONSTRO LIXO)
  ELE QUE A GENTE QUER? P_TREINO < 1
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? P_COMIDA < 1
    BORA CUMPADI 1
  BIRL
  ELE QUE A GENTE QUER? P_VAPO < 1
    BORA CUMPADI 1
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO P_DADO(MONSTRO LIXO)
  FRANGO S = "treino=" + P_TREINO + " comida=" + P_COMIDA + " vapo=" + P_VAPO + " hora=" + P_HORA + " tempo=" + P_TEMPO
  AJUDA O MALUCO TA DOENTE DADO("PET " + S)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO P_SALVA(MONSTRO LIXO)
  FRANGO S = "treino=" + P_TREINO + " comida=" + P_COMIDA + " vapo=" + P_VAPO + " hora=" + P_HORA
  ELE QUE A GENTE QUER? MODO_GUI == 1
    AJUDA O MALUCO TA DOENTE DADO("SAVE " + S)
  NAO VAI DAR NAO
    FRANGO AGORA = 0 + Date.now()
    FRANGO JS = "{\"treino\":" + P_TREINO + ",\"comida\":" + P_COMIDA + ",\"vapo\":" + P_VAPO + ",\"hora\":" + P_HORA + ",\"timestamp\":" + AGORA + "}"
    FRANGO EX = 0 + FS.existsSync("saves")
    ELE QUE A GENTE QUER? EX == 0
      FS.mkdirSync("saves")
    BIRL
    FS.writeFileSync("saves/tamagotchi.json", JS)
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO P_STATUS(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  ===== SEU MONSTRO =====")
  AJUDA O MALUCO TA DOENTE TEXTO("  TREINO.: " + P_TREINO)
  AJUDA O MALUCO TA DOENTE TEXTO("  COMIDA.: " + P_COMIDA)
  AJUDA O MALUCO TA DOENTE TEXTO("  VAPO...: " + P_VAPO)
  AJUDA O MALUCO TA DOENTE TEXTO("  HORA...: " + P_HORA + " DE 24")
  AJUDA O MALUCO TA DOENTE TEXTO("  =======================")
  ELE QUE A GENTE QUER? P_TREINO < 20
    AJUDA O MALUCO TA DOENTE TEXTO("  O MONSTRO TA MURCHANDO DE TREINO. BOTA ELE PRA MALHAR!")
  BIRL
  ELE QUE A GENTE QUER? P_COMIDA < 20
    AJUDA O MALUCO TA DOENTE TEXTO("  O MONSTRO TA COM FOME. ELE OLHOU PRA SUA COXINHA.")
  BIRL
  ELE QUE A GENTE QUER? P_VAPO < 20
    AJUDA O MALUCO TA DOENTE TEXTO("  O VAPO TA BAIXO. ELE PRECISA DE WHEY E DE GRITO.")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO P_ACAO(MONSTRO OP)
  FRANGO OK = 0
  ELE QUE A GENTE QUER? OP == "1"
    P_TREINO = P_TREINO + 12
    P_VAPO = P_VAPO + 4
    P_COMIDA = P_COMIDA - 6
    OK = 1
    AJUDA O MALUCO TA DOENTE TEXTO("  O MONSTRO TREINOU. BICEPS PALPITANDO.")
  BIRL
  ELE QUE A GENTE QUER? OP == "2"
    P_COMIDA = P_COMIDA + 20
    P_TREINO = P_TREINO + 2
    OK = 1
    AJUDA O MALUCO TA DOENTE TEXTO("  O MONSTRO COMEU. FRANGO COM BATATA DOCE.")
  BIRL
  ELE QUE A GENTE QUER? OP == "3"
    P_VAPO = P_VAPO + 22
    P_COMIDA = P_COMIDA + 4
    OK = 1
    AJUDA O MALUCO TA DOENTE TEXTO("  WHEY NA VEIA. O MONSTRO FICOU LIGADO.")
  BIRL
  ELE QUE A GENTE QUER? OP == "4"
    P_TREINO = P_TREINO + 4
    P_COMIDA = P_COMIDA + 4
    P_VAPO = P_VAPO + 8
    OK = 1
    AJUDA O MALUCO TA DOENTE TEXTO("  O MONSTRO DESCANSOU. RECUPERACAO E TREINO.")
  BIRL
  ELE QUE A GENTE QUER? OP == "5"
    P_TREINO = P_TREINO - 6
    P_COMIDA = P_COMIDA - 8
    P_VAPO = P_VAPO - 5
    OK = 1
    AJUDA O MALUCO TA DOENTE TEXTO("  VOCE IGNOROU O MONSTRO. ELE NAO GOSTOU NADA.")
  BIRL
  ELE QUE A GENTE QUER? OK == 0
    AJUDA O MALUCO TA DOENTE TEXTO("  OPCAO INVALIDA, FRANGO!")
  BIRL
  AJUDA O MALUCO TA DOENTE P_CLAMP(0)
  ELE QUE A GENTE QUER? OK == 1
    P_HORA = P_HORA + 1
  BIRL
  AJUDA O MALUCO TA DOENTE P_DADO(0)
  AJUDA O MALUCO TA DOENTE P_SALVA(0)
  BORA CUMPADI OK
BIRL

OH O HOME AI PO FRANGO JOGO_TAMAGOTCHI(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE P_LER_SAVE(0)
  AJUDA O MALUCO TA DOENTE P_DECAI(P_TEMPO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  TAMAGOTCHI DO MONSTRO")
  AJUDA O MALUCO TA DOENTE TEXTO("  O ESTADO EVOLUI PELO TEMPO REAL DESDE O ULTIMO ACESSO.")
  FRANGO VIVO = AJUDA O MALUCO TA DOENTE P_MORTO(0)
  ELE QUE A GENTE QUER? VIVO == 0
    FRANGO SAIR = 0
    NEGATIVA BAMBAM (SAIR == 0)
      AJUDA O MALUCO TA DOENTE P_STATUS(0)
      AJUDA O MALUCO TA DOENTE DADO("OPCOES 1=TREINAR|2=ALIMENTAR|3=WHEY|4=DESCANSAR|5=IGNORAR|0=SAIR")
      FRANGO OP = AJUDA O MALUCO TA DOENTE PEDE("choice", "O QUE FAZER COM O MONSTRO?")
      ELE QUE A GENTE QUER? OP == "0"
        SAIR = 1
      BIRL
      ELE QUE A GENTE QUER? SAIR == 0
        AJUDA O MALUCO TA DOENTE P_ACAO(OP)
        FRANGO V2 = AJUDA O MALUCO TA DOENTE P_MORTO(0)
        ELE QUE A GENTE QUER? V2 == 1
          SAIR = 1
        BIRL
        ELE QUE A GENTE QUER? P_HORA > 23
          SAIR = 1
        BIRL
      BIRL
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE P_DADO(0)
  AJUDA O MALUCO TA DOENTE P_SALVA(0)
  FRANGO FIMV = AJUDA O MALUCO TA DOENTE P_MORTO(0)
  ELE QUE A GENTE QUER? FIMV == 1
    AJUDA O MALUCO TA DOENTE TEXTO("")
    AJUDA O MALUCO TA DOENTE TEXTO("  SEU MONSTRO MURCHOU. ELE PRECISA DE UM DESCANSO ETERNO.")
    BORA CUMPADI "MURCHOU"
  BIRL
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  SEU MONSTRO TA VIVO E GRITANDO. VALEU, MONSTRO!")
  BORA CUMPADI "SAIU"
BIRL

OH O HOME AI PO FRANGO JOGO_DUNGEON(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  AJUDA O MALUCO TA DOENTE TEXTO("")
  AJUDA O MALUCO TA DOENTE TEXTO("  DUNGEON DA ACADEMIA")
  AJUDA O MALUCO TA DOENTE TEXTO("  EM CONSTRUCAO NESSA ETAPA. VOLTA DEPOIS, MONSTRO.")
  AJUDA O MALUCO TA DOENTE PEDE("next", "APERTA ENTER PRA VOLTAR...")
  BORA CUMPADI "EM BREVE"
BIRL

AJUDA O MALUCO TA DOENTE RODA(0)

BIRL
