HORA DO SHOW


FRANGO TAB = "........."

OH O HOME AI PO FRANGO LE_LINHA(MONSTRO LIXO)
  FRANGO FS = AJUDA O MALUCO TA DOENTE require("fs")
  FRANGO BUF = Buffer.alloc(1) || 0
  FRANGO TEXTO = ""
  FRANGO FIM = 0
  NEGATIVA BAMBAM (FIM == 0)
    FRANGO N = FS.readSync(0, BUF, 0, 1) || 0
    FRANGO C = BUF.toString("utf8") || ""
    ELE QUE A GENTE QUER? N == 0
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  ACABOU A ENTRADA. VALEU, MONSTRO!")
      process.exit(0)
    BIRL
    ELE QUE A GENTE QUER? C == "\n"
      FIM = 2
    BIRL
    ELE QUE A GENTE QUER? FIM == 0
      TEXTO = TEXTO + C
    BIRL
  BIRL
  BORA CUMPADI TEXTO
BIRL

OH O HOME AI PO FRANGO LIMPA(MONSTRO LIXO)
  console.clear()
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO FALA(MONSTRO TEXTO)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  >> " + TEXTO)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO PAUSA(MONSTRO LIXO)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  APERTA ENTER PRA VOLTAR, MONSTRO...")
  FRANGO LIXO2 = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO SORTEIO(MONSTRO N)
  FRANGO R = Math.random() || 0
  FRANGO V = Math.floor(R * N) || 0
  BORA CUMPADI V
BIRL

OH O HOME AI PO FRANGO CABECALHO(MONSTRO LIXO)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  ##########################################")
  CE QUER VER ESSA PORRA?("  #                                        #")
  CE QUER VER ESSA PORRA?("  #           B I R L   A R C A D E        #")
  CE QUER VER ESSA PORRA?("  #      AQUI NAO TEM AGUA COM MUSCULO     #")
  CE QUER VER ESSA PORRA?("  #                                        #")
  CE QUER VER ESSA PORRA?("  ##########################################")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO MENU(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  1 - JOGO DA VELHA VS BAMBAM")
  CE QUER VER ESSA PORRA?("  2 - SIMULADOR DE ACADEMIA")
  CE QUER VER ESSA PORRA?("  3 - TAMAGOTCHI DO MONSTRO")
  CE QUER VER ESSA PORRA?("  4 - DUNGEON DA ACADEMIA")
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  0 - SAIR DO FLIPERAMA")
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  ESCOLHE AI, FRANGO:")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO CASA(MONSTRO I)
  FRANGO C = TAB.charAt(I) || ""
  ELE QUE A GENTE QUER? C == "."
    BORA CUMPADI I
  BIRL
  BORA CUMPADI C
BIRL

OH O HOME AI PO FRANGO DESENHA_TAB(MONSTRO LIXO)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("      " + AJUDA O MALUCO TA DOENTE CASA(0) + " | " + AJUDA O MALUCO TA DOENTE CASA(1) + " | " + AJUDA O MALUCO TA DOENTE CASA(2))
  CE QUER VER ESSA PORRA?("     ---+---+---")
  CE QUER VER ESSA PORRA?("      " + AJUDA O MALUCO TA DOENTE CASA(3) + " | " + AJUDA O MALUCO TA DOENTE CASA(4) + " | " + AJUDA O MALUCO TA DOENTE CASA(5))
  CE QUER VER ESSA PORRA?("     ---+---+---")
  CE QUER VER ESSA PORRA?("      " + AJUDA O MALUCO TA DOENTE CASA(6) + " | " + AJUDA O MALUCO TA DOENTE CASA(7) + " | " + AJUDA O MALUCO TA DOENTE CASA(8))
  CE QUER VER ESSA PORRA?("")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO MARCAR(MONSTRO POS, MONSTRO SIMB)
  FRANGO PARTES = TAB.split("") || 0
  PARTES.splice(POS, 1, SIMB)
  TAB = PARTES.join("") || ""
  BORA CUMPADI 0
BIRL

OH O HOME AI PO MONSTRO VENCE(MONSTRO SIMB, MONSTRO LIXO)
  FRANGO ALVO = SIMB + SIMB + SIMB
  FRANGO A = TAB.charAt(0) + TAB.charAt(1) + TAB.charAt(2)
  FRANGO B = TAB.charAt(3) + TAB.charAt(4) + TAB.charAt(5)
  FRANGO C = TAB.charAt(6) + TAB.charAt(7) + TAB.charAt(8)
  FRANGO D = TAB.charAt(0) + TAB.charAt(3) + TAB.charAt(6)
  FRANGO E = TAB.charAt(1) + TAB.charAt(4) + TAB.charAt(7)
  FRANGO F = TAB.charAt(2) + TAB.charAt(5) + TAB.charAt(8)
  FRANGO G = TAB.charAt(0) + TAB.charAt(4) + TAB.charAt(8)
  FRANGO H = TAB.charAt(2) + TAB.charAt(4) + TAB.charAt(6)
  FRANGO V = 0
  ELE QUE A GENTE QUER? A == ALVO
    V = 1
  BIRL
  ELE QUE A GENTE QUER? B == ALVO
    V = 1
  BIRL
  ELE QUE A GENTE QUER? C == ALVO
    V = 1
  BIRL
  ELE QUE A GENTE QUER? D == ALVO
    V = 1
  BIRL
  ELE QUE A GENTE QUER? E == ALVO
    V = 1
  BIRL
  ELE QUE A GENTE QUER? F == ALVO
    V = 1
  BIRL
  ELE QUE A GENTE QUER? G == ALVO
    V = 1
  BIRL
  ELE QUE A GENTE QUER? H == ALVO
    V = 1
  BIRL
  BORA CUMPADI V
BIRL

OH O HOME AI PO MONSTRO VEZ_HUMANO(MONSTRO LIXO)
  FRANGO POS = 0
  FRANGO VALIDO = 0
  NEGATIVA BAMBAM (VALIDO == 0)
    CE QUER VER ESSA PORRA?("  SUA VEZ, MONSTRO. ESCOLHE UMA CASA (0-8):")
    FRANGO ENTRADA = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    ELE QUE A GENTE QUER? ENTRADA.length == 1
      FRANGO CH = ENTRADA.charAt(0) || "?"
      ELE QUE A GENTE QUER? CH > "/"
        ELE QUE A GENTE QUER? CH < "9"
          FRANGO P = AJUDA O MALUCO TA DOENTE parseInt(CH, 10)
          ELE QUE A GENTE QUER? TAB.charAt(P) == "."
            POS = P + 0
            VALIDO = 1
          NAO VAI DAR NAO
            CE QUER VER ESSA PORRA?("  ESSA CASA JA TA OCUPADA, FRANGO!")
          BIRL
        NAO VAI DAR NAO
          CE QUER VER ESSA PORRA?("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
        BIRL
      NAO VAI DAR NAO
        CE QUER VER ESSA PORRA?("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
      BIRL
    NAO VAI DAR NAO
      CE QUER VER ESSA PORRA?("  DIGITA UM NUMERO DE 0 A 8, PORRA!")
    BIRL
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO MONSTRO VEZ_BAMBAM(MONSTRO LIXO)
  CE QUER VER ESSA PORRA?("  BAMBAM TA PENSANDO... ELE PENSA COM O BICEPS.")
  FRANGO POS = 0
  FRANGO LIVRE = 0
  NEGATIVA BAMBAM (LIVRE == 0)
    FRANGO P = AJUDA O MALUCO TA DOENTE SORTEIO(9)
    ELE QUE A GENTE QUER? TAB.charAt(P) == "."
      POS = P + 0
      LIVRE = 1
    BIRL
  BIRL
  BORA CUMPADI POS
BIRL

OH O HOME AI PO FRANGO JOGO_VELHA(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  JOGO DA VELHA VS BAMBAM")
  CE QUER VER ESSA PORRA?("  VOCE E O X. BAMBAM E O O. ELE NAO PERDE NO SHAPE.")
  AJUDA O MALUCO TA DOENTE PAUSA(0)
  TAB = "........."
  FRANGO JOGADAS = 0
  FRANGO VEZ = "X"
  FRANGO RESULTADO = "."
  NEGATIVA BAMBAM (RESULTADO == ".")
    ELE QUE A GENTE QUER? JOGADAS < 9
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE CABECALHO(0)
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  JOGO DA VELHA VS BAMBAM    JOGADA: " + JOGADAS)
      AJUDA O MALUCO TA DOENTE DESENHA_TAB(0)
      ELE QUE A GENTE QUER? VEZ == "X"
        FRANGO POSX = AJUDA O MALUCO TA DOENTE VEZ_HUMANO(0)
        AJUDA O MALUCO TA DOENTE MARCAR(POSX, "X")
      NAO VAI DAR NAO
        FRANGO POSO = AJUDA O MALUCO TA DOENTE VEZ_BAMBAM(0)
        AJUDA O MALUCO TA DOENTE MARCAR(POSO, "O")
      BIRL
      JOGADAS = JOGADAS + 1
      FRANGO VX = AJUDA O MALUCO TA DOENTE VENCE("X", 0)
      FRANGO VO = AJUDA O MALUCO TA DOENTE VENCE("O", 0)
      ELE QUE A GENTE QUER? VX == 1
        RESULTADO = "VOCE"
      BIRL
      ELE QUE A GENTE QUER? VO == 1
        RESULTADO = "BAMBAM"
      BIRL
      ELE QUE A GENTE QUER? VEZ == "X"
        VEZ = "O"
      NAO VAI DAR NAO
        VEZ = "X"
      BIRL
    NAO VAI DAR NAO
      RESULTADO = "EMPATE"
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  CE QUER VER ESSA PORRA?("")
  AJUDA O MALUCO TA DOENTE DESENHA_TAB(0)
  ELE QUE A GENTE QUER? RESULTADO == "VOCE"
    CE QUER VER ESSA PORRA?("  BIRL! VOCE AMASSOLOU O BAMBAM NO JOGO DA VELHA!")
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "BAMBAM"
    CE QUER VER ESSA PORRA?("  O BAMBAM TE AMASSOLOU. VAI TREINAR MAIS, FRANGO!")
  BIRL
  ELE QUE A GENTE QUER? RESULTADO == "EMPATE"
    CE QUER VER ESSA PORRA?("  EMPATE! NINGUEM MURCHOU NESSA.")
  BIRL
  AJUDA O MALUCO TA DOENTE PAUSA(0)
  BORA CUMPADI 0
BIRL

FRANGO A_FORCA = 10
FRANGO A_SHAPE = 10
FRANGO A_VAPO = 10
FRANGO A_ENERGIA = 100
FRANGO A_FOME = 20

OH O HOME AI PO FRANGO AJUSTA_ACADEMIA(MONSTRO LIXO)
  ELE QUE A GENTE QUER? A_ENERGIA < 0
    A_ENERGIA = 0
  BIRL
  ELE QUE A GENTE QUER? A_ENERGIA > 100
    A_ENERGIA = 100
  BIRL
  ELE QUE A GENTE QUER? A_FOME < 0
    A_FOME = 0
  BIRL
  ELE QUE A GENTE QUER? A_FOME > 100
    A_FOME = 100
  BIRL
  ELE QUE A GENTE QUER? A_FORCA > 100
    A_FORCA = 100
  BIRL
  ELE QUE A GENTE QUER? A_SHAPE > 100
    A_SHAPE = 100
  BIRL
  ELE QUE A GENTE QUER? A_VAPO > 100
    A_VAPO = 100
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO STATUS_ACADEMIA(MONSTRO LIXO)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  ===== FICHA DO MONSTRO =====")
  CE QUER VER ESSA PORRA?("  FORCA...: " + A_FORCA)
  CE QUER VER ESSA PORRA?("  SHAPE...: " + A_SHAPE)
  CE QUER VER ESSA PORRA?("  VAPO....: " + A_VAPO)
  CE QUER VER ESSA PORRA?("  ENERGIA.: " + A_ENERGIA)
  CE QUER VER ESSA PORRA?("  FOME....: " + A_FOME)
  CE QUER VER ESSA PORRA?("  ============================")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO EVENTO_ACADEMIA(MONSTRO LIXO)
  FRANGO R = AJUDA O MALUCO TA DOENTE SORTEIO(100)
  CE QUER VER ESSA PORRA?("")
  ELE QUE A GENTE QUER? R < 12
    CE QUER VER ESSA PORRA?("  EVENTO: UM FRANGO MUTANTE INVADIU A ACADEMIA!")
    CE QUER VER ESSA PORRA?("  VOCE CORREU TANTO QUE GANHOU SHAPE. MAS PERDEU ENERGIA.")
    A_SHAPE = A_SHAPE + 4
    A_ENERGIA = A_ENERGIA - 10
  QUE NAO VAI DAR O QUE? R < 24
    CE QUER VER ESSA PORRA?("  EVENTO: O PERSONAL CHATO TE VIU DESCANSANDO!")
    CE QUER VER ESSA PORRA?("  ELE GRITOU TANTO QUE VOCE TREINOU DE GRACA.")
    A_FORCA = A_FORCA + 3
    A_ENERGIA = A_ENERGIA - 8
  QUE NAO VAI DAR O QUE? R < 36
    CE QUER VER ESSA PORRA?("  EVENTO: PROMOCAO DE WHEY NA LOJA DO BAMBA!")
    CE QUER VER ESSA PORRA?("  VOCE COMPROU 5 POTES E O VAPO SUBIU.")
    A_VAPO = A_VAPO + 6
  QUE NAO VAI DAR O QUE? R < 48
    CE QUER VER ESSA PORRA?("  EVENTO: A MAROMBA TE OFERECEU UM FRANGO GRELHADO.")
    CE QUER VER ESSA PORRA?("  PROTEINA GRATIS E FOME ZERADA.")
    A_FOME = A_FOME - 20
    A_ENERGIA = A_ENERGIA + 10
  QUE NAO VAI DAR O QUE? R < 58
    CE QUER VER ESSA PORRA?("  EVENTO: VOCE ESCORREGOU NO SUPINO. QUE VERGONHA.")
    CE QUER VER ESSA PORRA?("  O SHAPE LEVOU UM SUSTO.")
    A_SHAPE = A_SHAPE - 3
  NAO VAI DAR NAO
    CE QUER VER ESSA PORRA?("  DIA NORMAL NA ACADEMIA. SO MUSCULO E SUOR.")
  BIRL
  AJUDA O MALUCO TA DOENTE AJUSTA_ACADEMIA(0)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_ACADEMIA(MONSTRO LIXO)
  A_FORCA = 10
  A_SHAPE = 10
  A_VAPO = 10
  A_ENERGIA = 100
  A_FOME = 20
  FRANGO SAIR_ACADEMIA = 0
  FRANGO DIA = 1
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  SIMULADOR DE ACADEMIA")
  CE QUER VER ESSA PORRA?("  OBJETIVO: CHEGAR A SHAPE 100 SEM MURCHAR.")
  CE QUER VER ESSA PORRA?("  SE A FOME PASSAR DE 95, VOCE MURCHA. SE A ENERGIA ZERAR, TAMBEM.")
  AJUDA O MALUCO TA DOENTE PAUSA(0)
  NEGATIVA BAMBAM (SAIR_ACADEMIA == 0)
    AJUDA O MALUCO TA DOENTE LIMPA(0)
    AJUDA O MALUCO TA DOENTE CABECALHO(0)
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  SIMULADOR DE ACADEMIA          DIA: " + DIA)
    AJUDA O MALUCO TA DOENTE STATUS_ACADEMIA(0)
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  1 - TREINAR PESADO")
    CE QUER VER ESSA PORRA?("  2 - COMER FRANGO")
    CE QUER VER ESSA PORRA?("  3 - TOMAR WHEY")
    CE QUER VER ESSA PORRA?("  4 - DESCANSAR")
    CE QUER VER ESSA PORRA?("  0 - SAIR DA ACADEMIA")
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  O QUE VAI SER, MONSTRO?")
    FRANGO OP_AC = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    ELE QUE A GENTE QUER? OP_AC == "1"
      ELE QUE A GENTE QUER? A_ENERGIA < 15
        CE QUER VER ESSA PORRA?("")
        CE QUER VER ESSA PORRA?("  SEM ENERGIA, FRANGO! VAI COMER OU DESCANSAR.")
      NAO VAI DAR NAO
        FRANGO G1 = AJUDA O MALUCO TA DOENTE SORTEIO(4)
        A_FORCA = A_FORCA + 3 + G1
        A_SHAPE = A_SHAPE + 2 + G1
        A_ENERGIA = A_ENERGIA - 18
        A_FOME = A_FOME + 15
        DIA = DIA + 1
        CE QUER VER ESSA PORRA?("")
        CE QUER VER ESSA PORRA?("  VOCE TREINOU PESADO. O SUPINO ATE PEDIU SOCORRO.")
        AJUDA O MALUCO TA DOENTE EVENTO_ACADEMIA(0)
      BIRL
    QUE NAO VAI DAR O QUE? OP_AC == "2"
      A_FOME = A_FOME - 30
      A_ENERGIA = A_ENERGIA + 12
      A_SHAPE = A_SHAPE + 1
      DIA = DIA + 1
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  FRANGO GRELHADO COM BATATA DOCE. PROTEINA PURA.")
      AJUDA O MALUCO TA DOENTE EVENTO_ACADEMIA(0)
    QUE NAO VAI DAR O QUE? OP_AC == "3"
      A_VAPO = A_VAPO + 9
      A_ENERGIA = A_ENERGIA + 5
      A_FOME = A_FOME + 5
      DIA = DIA + 1
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  WHEY BATIDO COM AGUA. SEM AGUA COM MUSCULO, SO MUSCULO.")
      AJUDA O MALUCO TA DOENTE EVENTO_ACADEMIA(0)
    QUE NAO VAI DAR O QUE? OP_AC == "4"
      A_ENERGIA = A_ENERGIA + 28
      A_FOME = A_FOME + 8
      DIA = DIA + 1
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VOCE DESCANSOU. O CORPO AGRADECE, O PERSONAL NAO.")
      AJUDA O MALUCO TA DOENTE EVENTO_ACADEMIA(0)
    QUE NAO VAI DAR O QUE? OP_AC == "0"
      SAIR_ACADEMIA = 1
    NAO VAI DAR NAO
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  OPCAO INVALIDA, FRANGO!")
    BIRL
    AJUDA O MALUCO TA DOENTE AJUSTA_ACADEMIA(0)
    ELE QUE A GENTE QUER? A_SHAPE > 99
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE CABECALHO(0)
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  SHAPE 100! VOCE VIROU UM MONSTRO DE VERDADE!")
      CE QUER VER ESSA PORRA?("  O BAMBAM TE VIU E PEDIU AUTOGRAGO. BIRL!")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
      SAIR_ACADEMIA = 1
    BIRL
    ELE QUE A GENTE QUER? A_FOME > 95
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE CABECALHO(0)
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VOCE MURCHOU DE FOME. O SHAPE FOI EMBORA.")
      CE QUER VER ESSA PORRA?("  VAI COMER UM FRANGO, PELO AMOR.")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
      SAIR_ACADEMIA = 1
    BIRL
    ELE QUE A GENTE QUER? A_ENERGIA < 1
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE CABECALHO(0)
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VOCE ZEROU A ENERGIA E DESMAIOU NO LEG PRESS.")
      CE QUER VER ESSA PORRA?("  DESCANSA, MONSTRO.")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
      SAIR_ACADEMIA = 1
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

FRANGO T_TREINO = 60
FRANGO T_COMIDA = 60
FRANGO T_VAPO = 60
FRANGO T_TURNO = 1

OH O HOME AI PO FRANGO AJUSTA_PET(MONSTRO LIXO)
  ELE QUE A GENTE QUER? T_TREINO < 0
    T_TREINO = 0
  BIRL
  ELE QUE A GENTE QUER? T_COMIDA < 0
    T_COMIDA = 0
  BIRL
  ELE QUE A GENTE QUER? T_VAPO < 0
    T_VAPO = 0
  BIRL
  ELE QUE A GENTE QUER? T_TREINO > 100
    T_TREINO = 100
  BIRL
  ELE QUE A GENTE QUER? T_COMIDA > 100
    T_COMIDA = 100
  BIRL
  ELE QUE A GENTE QUER? T_VAPO > 100
    T_VAPO = 100
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO STATUS_PET(MONSTRO LIXO)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  ===== SEU MONSTRO =====")
  CE QUER VER ESSA PORRA?("  TREINO.: " + T_TREINO)
  CE QUER VER ESSA PORRA?("  COMIDA.: " + T_COMIDA)
  CE QUER VER ESSA PORRA?("  VAPO...: " + T_VAPO)
  CE QUER VER ESSA PORRA?("  TURNO..: " + T_TURNO + " DE 25")
  CE QUER VER ESSA PORRA?("  =======================")
  ELE QUE A GENTE QUER? T_TREINO < 20
    CE QUER VER ESSA PORRA?("  O MONSTRO TA MURCHANDO DE TREINO. BOTA ELE PRA MALHAR!")
  BIRL
  ELE QUE A GENTE QUER? T_COMIDA < 20
    CE QUER VER ESSA PORRA?("  O MONSTRO TA COM FOME. ELE OLHOU PRA SUA COXINHA.")
  BIRL
  ELE QUE A GENTE QUER? T_VAPO < 20
    CE QUER VER ESSA PORRA?("  O VAPO TA BAIXO. ELE PRECISA DE WHEY E DE GRITO.")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO DECAI_PET(MONSTRO MULT)
  FRANGO D1 = 4 * MULT
  FRANGO D2 = 6 * MULT
  FRANGO D3 = 3 * MULT
  T_TREINO = T_TREINO - D1
  T_COMIDA = T_COMIDA - D2
  T_VAPO = T_VAPO - D3
  T_TURNO = T_TURNO + 1
  AJUDA O MALUCO TA DOENTE AJUSTA_PET(0)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_TAMAGOTCHI(MONSTRO LIXO)
  T_TREINO = 60
  T_COMIDA = 60
  T_VAPO = 60
  T_TURNO = 1
  FRANGO SAIR_PET = 0
  FRANGO MURCHOU = 0
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  TAMAGOTCHI DO MONSTRO")
  CE QUER VER ESSA PORRA?("  CUIDE DO SEU PET MAROMBA POR 25 TURNOS.")
  CE QUER VER ESSA PORRA?("  SE QUALQUER ATRIBUTO ZERAR, ELE MURCHA. SE IGNORAR, MURCHA MAIS RAPIDO.")
  AJUDA O MALUCO TA DOENTE PAUSA(0)
  NEGATIVA BAMBAM (SAIR_PET == 0)
    AJUDA O MALUCO TA DOENTE LIMPA(0)
    AJUDA O MALUCO TA DOENTE CABECALHO(0)
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  TAMAGOTCHI DO MONSTRO")
    AJUDA O MALUCO TA DOENTE STATUS_PET(0)
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  1 - TREINAR COM ELE")
    CE QUER VER ESSA PORRA?("  2 - DAR FRANGO")
    CE QUER VER ESSA PORRA?("  3 - DAR WHEY E GRITAR VAPO VAPO")
    CE QUER VER ESSA PORRA?("  4 - IGNORAR O MONSTRO (ELE MURCHA!)")
    CE QUER VER ESSA PORRA?("  0 - SAIR")
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  E AI, TREINADOR?")
    FRANGO OP_PET = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    ELE QUE A GENTE QUER? OP_PET == "1"
      T_TREINO = T_TREINO + 18
      T_COMIDA = T_COMIDA - 12
      T_VAPO = T_VAPO - 4
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VOCE BOTOU O MONSTRO PRA FAZER AGACHAMENTO. ELE CHOROU, MAS CRESCEU.")
      AJUDA O MALUCO TA DOENTE DECAI_PET(1)
    QUE NAO VAI DAR O QUE? OP_PET == "2"
      T_COMIDA = T_COMIDA + 25
      T_TREINO = T_TREINO - 3
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  FRANGO COM BATATA DOCE. ELE COMEU ATE O PRATO.")
      AJUDA O MALUCO TA DOENTE DECAI_PET(1)
    QUE NAO VAI DAR O QUE? OP_PET == "3"
      T_VAPO = T_VAPO + 22
      T_COMIDA = T_COMIDA - 6
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VAPO VAPO VAPO! O MONSTRO FICOU POSSUIDO E O SHAPE SUBIU.")
      AJUDA O MALUCO TA DOENTE DECAI_PET(1)
    QUE NAO VAI DAR O QUE? OP_PET == "4"
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VOCE IGNOROU O MONSTRO. ELE TA MURCHANDO NO CANTO DA ACADEMIA...")
      AJUDA O MALUCO TA DOENTE DECAI_PET(3)
    QUE NAO VAI DAR O QUE? OP_PET == "0"
      SAIR_PET = 1
    NAO VAI DAR NAO
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  OPCAO INVALIDA, TREINADOR FRANGO!")
    BIRL
    AJUDA O MALUCO TA DOENTE AJUSTA_PET(0)
    ELE QUE A GENTE QUER? T_TREINO < 1
      MURCHOU = 1
    BIRL
    ELE QUE A GENTE QUER? T_COMIDA < 1
      MURCHOU = 1
    BIRL
    ELE QUE A GENTE QUER? T_VAPO < 1
      MURCHOU = 1
    BIRL
    ELE QUE A GENTE QUER? MURCHOU == 1
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE CABECALHO(0)
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  SEU MONSTRO MURCHOU. VIROU UM FRANGO COMUM.")
      CE QUER VER ESSA PORRA?("  NA PROXIMA, NAO ABANDONA O PARCEIRO!")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
      SAIR_PET = 1
    BIRL
    ELE QUE A GENTE QUER? T_TURNO > 25
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      AJUDA O MALUCO TA DOENTE CABECALHO(0)
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  25 TURNOS! SEU MONSTRO EVOLUIU PARA MONSTRO SUPREMO!")
      CE QUER VER ESSA PORRA?("  ELE AGORA TEM SHAPE DE ESTATUA E VAPO DE GOSPEL.")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
      SAIR_PET = 1
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

FRANGO MAPA = ""
FRANGO D_POS = 11
FRANGO D_HP = 30
FRANGO D_ATK = 5
FRANGO D_MORTO = 0
FRANGO D_VENCEU = 0

OH O HOME AI PO FRANGO TROCA_MAPA(MONSTRO POS, MONSTRO SIMB)
  FRANGO PARTES = MAPA.split("") || 0
  PARTES.splice(POS, 1, SIMB)
  MAPA = PARTES.join("") || ""
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO GERA_MAPA(MONSTRO LIXO)
  FRANGO LINHA = ""
  MAIS QUERO MAIS (MONSTRO Y = 0; Y < 10; Y++)
    MAIS QUERO MAIS (MONSTRO X = 0; X < 10; X++)
      FRANGO CH = "."
      ELE QUE A GENTE QUER? Y == 0
        CH = "#"
      QUE NAO VAI DAR O QUE? Y == 9
        CH = "#"
      QUE NAO VAI DAR O QUE? X == 0
        CH = "#"
      QUE NAO VAI DAR O QUE? X == 9
        CH = "#"
      BIRL
      LINHA = LINHA + CH
    BIRL
  BIRL
  MAPA = LINHA + ""
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO COLOCA_MAPA(MONSTRO SIMB, MONSTRO QTD)
  FRANGO FEITOS = 0
  NEGATIVA BAMBAM (FEITOS < QTD)
    FRANGO P = AJUDA O MALUCO TA DOENTE SORTEIO(100)
    FRANGO C = MAPA.charAt(P) || "#"
    ELE QUE A GENTE QUER? C == "."
      ELE QUE A GENTE QUER? P != 11
        AJUDA O MALUCO TA DOENTE TROCA_MAPA(P, SIMB)
        FEITOS = FEITOS + 1
      BIRL
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO MOSTRA_MAPA(MONSTRO LIXO)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  +--------+")
  MAIS QUERO MAIS (MONSTRO Y = 0; Y < 10; Y++)
    FRANGO I = Y * 10
    FRANGO J = I + 10
    FRANGO LINHA = MAPA.substring(I, J) || ""
    CE QUER VER ESSA PORRA?("  " + LINHA)
  BIRL
  CE QUER VER ESSA PORRA?("  +--------+")
  CE QUER VER ESSA PORRA?("  VIDA: " + D_HP + "   FORCA: " + D_ATK)
  CE QUER VER ESSA PORRA?("  LEGENDA: @ VOCE  F FRANGO MUTANTE  P PERSONAL CHATO")
  CE QUER VER ESSA PORRA?("           W WHEY (+VIDA)  C FRANGO (+FORCA)  E SAIDA")
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO BATALHA_DUNGEON(MONSTRO INIMIGO)
  FRANGO NOME = "FRANGO MUTANTE"
  FRANGO EHP = 12
  FRANGO EATK = 2
  ELE QUE A GENTE QUER? INIMIGO == "P"
    NOME = "PERSONAL CHATO"
    EHP = 16
    EATK = 4
  BIRL
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  UM " + NOME + " APARECEU! BORA TREINAR NA MARRA.")
  FRANGO LUTANDO = 1
  NEGATIVA BAMBAM (LUTANDO == 1)
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  " + NOME + " HP: " + EHP + "    SUA VIDA: " + D_HP)
    CE QUER VER ESSA PORRA?("  APERTA ENTER PRA ATACAR!")
    FRANGO L = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    FRANGO DANO = D_ATK + AJUDA O MALUCO TA DOENTE SORTEIO(4)
    EHP = EHP - DANO
    CE QUER VER ESSA PORRA?("  VOCE DEU " + DANO + " DE DANO!")
    ELE QUE A GENTE QUER? EHP < 1
      LUTANDO = 0
      CE QUER VER ESSA PORRA?("  VOCE AMASSOLOU O " + NOME + "! BIRL!")
    BIRL
    ELE QUE A GENTE QUER? LUTANDO == 1
      FRANGO DANO2 = EATK + AJUDA O MALUCO TA DOENTE SORTEIO(3)
      D_HP = D_HP - DANO2
      CE QUER VER ESSA PORRA?("  O " + NOME + " TE DEU " + DANO2 + " DE DANO!")
      ELE QUE A GENTE QUER? D_HP < 1
        D_HP = 0
        D_MORTO = 1
        LUTANDO = 0
      BIRL
    BIRL
  BIRL
  ELE QUE A GENTE QUER? D_MORTO == 1
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  VOCE MORREU NO LEG PRESS. QUE FRANGO...")
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO ANDA_DUNGEON(MONSTRO ALVO)
  FRANGO C = MAPA.charAt(ALVO) || "#"
  ELE QUE A GENTE QUER? C == "#"
    CE QUER VER ESSA PORRA?("  PAREDE. O MONSTRO NAO ATRAVESSA CONCRETO.")
  BIRL
  ELE QUE A GENTE QUER? C == "."
    AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, ".")
    D_POS = ALVO + 0
    AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, "@")
  BIRL
  ELE QUE A GENTE QUER? C == "W"
    D_HP = D_HP + 10
    ELE QUE A GENTE QUER? D_HP > 60
      D_HP = 60
    BIRL
    CE QUER VER ESSA PORRA?("  WHEY! VIDA RECUPERADA. AGORA VAI.")
    AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, ".")
    D_POS = ALVO + 0
    AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, "@")
  BIRL
  ELE QUE A GENTE QUER? C == "C"
    D_ATK = D_ATK + 2
    CE QUER VER ESSA PORRA?("  FRANGO GRELHADO! FORCA AUMENTOU.")
    AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, ".")
    D_POS = ALVO + 0
    AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, "@")
  BIRL
  ELE QUE A GENTE QUER? C == "E"
    D_VENCEU = 1
  BIRL
  ELE QUE A GENTE QUER? C == "F"
    AJUDA O MALUCO TA DOENTE BATALHA_DUNGEON("F")
    ELE QUE A GENTE QUER? D_MORTO == 0
      AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, ".")
      D_POS = ALVO + 0
      AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, "@")
    BIRL
  BIRL
  ELE QUE A GENTE QUER? C == "P"
    AJUDA O MALUCO TA DOENTE BATALHA_DUNGEON("P")
    ELE QUE A GENTE QUER? D_MORTO == 0
      AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, ".")
      D_POS = ALVO + 0
      AJUDA O MALUCO TA DOENTE TROCA_MAPA(D_POS, "@")
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO JOGO_DUNGEON(MONSTRO LIXO)
  AJUDA O MALUCO TA DOENTE GERA_MAPA(0)
  D_POS = 11
  AJUDA O MALUCO TA DOENTE TROCA_MAPA(11, "@")
  AJUDA O MALUCO TA DOENTE COLOCA_MAPA("F", 4)
  AJUDA O MALUCO TA DOENTE COLOCA_MAPA("P", 3)
  AJUDA O MALUCO TA DOENTE COLOCA_MAPA("W", 3)
  AJUDA O MALUCO TA DOENTE COLOCA_MAPA("C", 3)
  AJUDA O MALUCO TA DOENTE COLOCA_MAPA("E", 1)
  D_HP = 30
  D_ATK = 5
  D_MORTO = 0
  D_VENCEU = 0
  FRANGO SAIR_D = 0
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  CE QUER VER ESSA PORRA?("")
  CE QUER VER ESSA PORRA?("  DUNGEON DA ACADEMIA")
  CE QUER VER ESSA PORRA?("  CHEGUE AO E SEM MORRER. W = VIDA, C = FORCA.")
  CE QUER VER ESSA PORRA?("  CONTROLES: W CIMA, S BAIXO, A ESQUERDA, D DIREITA, Q SAIR.")
  AJUDA O MALUCO TA DOENTE PAUSA(0)
  NEGATIVA BAMBAM (SAIR_D == 0)
    AJUDA O MALUCO TA DOENTE LIMPA(0)
    AJUDA O MALUCO TA DOENTE CABECALHO(0)
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  DUNGEON DA ACADEMIA")
    AJUDA O MALUCO TA DOENTE MOSTRA_MAPA(0)
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  MOVE AI (W/A/S/D) OU Q PRA VAZAR:")
    FRANGO CMD = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    CMD = CMD.toLowerCase() || "?"
    ELE QUE A GENTE QUER? CMD == "w"
      FRANGO ALVO_W = D_POS - 10
      AJUDA O MALUCO TA DOENTE ANDA_DUNGEON(ALVO_W)
    QUE NAO VAI DAR O QUE? CMD == "s"
      FRANGO ALVO_S = D_POS + 10
      AJUDA O MALUCO TA DOENTE ANDA_DUNGEON(ALVO_S)
    QUE NAO VAI DAR O QUE? CMD == "a"
      FRANGO ALVO_A = D_POS - 1
      AJUDA O MALUCO TA DOENTE ANDA_DUNGEON(ALVO_A)
    QUE NAO VAI DAR O QUE? CMD == "d"
      FRANGO ALVO_D = D_POS + 1
      AJUDA O MALUCO TA DOENTE ANDA_DUNGEON(ALVO_D)
    QUE NAO VAI DAR O QUE? CMD == "q"
      SAIR_D = 1
    NAO VAI DAR NAO
      CE QUER VER ESSA PORRA?("  COMANDO INVALIDO, MONSTRO. USA W, A, S, D OU Q.")
    BIRL
    ELE QUE A GENTE QUER? D_MORTO == 1
      SAIR_D = 1
    BIRL
    ELE QUE A GENTE QUER? D_VENCEU == 1
      SAIR_D = 1
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE LIMPA(0)
  AJUDA O MALUCO TA DOENTE CABECALHO(0)
  ELE QUE A GENTE QUER? D_VENCEU == 1
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  VOCE ACHOU A SAIDA DA DUNGEON! A ACADEMIA FOI VENCIDA!")
    CE QUER VER ESSA PORRA?("  O PERSONAL CHATO FICOU CHATEADO. BIRL!")
  BIRL
  ELE QUE A GENTE QUER? D_MORTO == 1
    CE QUER VER ESSA PORRA?("")
    CE QUER VER ESSA PORRA?("  A DUNGEON TE VENCEU. VOLTA PRO SUPINO, FRANGO.")
  BIRL
  ELE QUE A GENTE QUER? D_MORTO == 0
    ELE QUE A GENTE QUER? D_VENCEU == 0
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VOCE VAZOU DA DUNGEON. A SAIDA FICOU PRA PROXIMA.")
    BIRL
  BIRL
  AJUDA O MALUCO TA DOENTE PAUSA(0)
  BORA CUMPADI 0
BIRL

OH O HOME AI PO FRANGO RODA(MONSTRO LIXO)
  FRANGO SAIR = 0
  NEGATIVA BAMBAM (SAIR == 0)
    AJUDA O MALUCO TA DOENTE MENU(0)
    FRANGO OP = AJUDA O MALUCO TA DOENTE LE_LINHA(0)
    ELE QUE A GENTE QUER? OP == "1"
      AJUDA O MALUCO TA DOENTE JOGO_VELHA(0)
    QUE NAO VAI DAR O QUE? OP == "2"
      AJUDA O MALUCO TA DOENTE JOGO_ACADEMIA(0)
    QUE NAO VAI DAR O QUE? OP == "3"
      AJUDA O MALUCO TA DOENTE JOGO_TAMAGOTCHI(0)
    QUE NAO VAI DAR O QUE? OP == "4"
      AJUDA O MALUCO TA DOENTE JOGO_DUNGEON(0)
    QUE NAO VAI DAR O QUE? OP == "0"
      SAIR = 1
      AJUDA O MALUCO TA DOENTE LIMPA(0)
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  VALEU, MONSTRO. AGORA VAI COMER UM FRANGO.")
      CE QUER VER ESSA PORRA?("")
    NAO VAI DAR NAO
      CE QUER VER ESSA PORRA?("")
      CE QUER VER ESSA PORRA?("  OPCAO INVALIDA, SEU FRANGO! TENTA DE NOVO.")
      AJUDA O MALUCO TA DOENTE PAUSA(0)
    BIRL
  BIRL
  BORA CUMPADI 0
BIRL

AJUDA O MALUCO TA DOENTE RODA(0)

BIRL
